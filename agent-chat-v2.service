[Unit]
Description=Agent Chat v2 - MCP messaging backend
After=network.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__INSTALL_DIR__
ExecStart=__NODE_BIN__ __INSTALL_DIR__/backend-v2.js
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
EnvironmentFile=-__INSTALL_DIR__/.env

[Install]
WantedBy=multi-user.target
