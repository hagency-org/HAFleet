[Unit]
Description=Agent Chat v2 - MCP messaging backend
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=__USER__
WorkingDirectory=__INSTALL_DIR__
ExecStart=__NODE_BIN__ __INSTALL_DIR__/backend-v2.js
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
EnvironmentFile=-__INSTALL_DIR__/.env

# --- Sandboxing ---
# Two directives are deliberately omitted. Do not add them without re-testing:
#   PrivateTmp  - tmux's default server socket is /tmp/tmux-<uid>. A private /tmp
#                 hides it, and this service shells out to tmux (34 call sites).
#   ProtectHome - WorkingDirectory, data/ and logs/ all live under the service
#                 user's home, which ProtectHome would make inaccessible.
NoNewPrivileges=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# --- Resource limits ---
# LimitNOFILE is raised for SSE fan-out (one long-lived fd per subscriber).
# MemoryHigh is a soft throttle, not a kill ceiling: exceeding it applies reclaim
# pressure rather than OOM-killing the backend. Tune to your fleet size.
LimitNOFILE=8192
MemoryHigh=1G
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
