[Unit]
Description=Agent Chat Matrix Bridge
After=network.target agent-chat-v2.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=__USER__
WorkingDirectory=__INSTALL_DIR__
ExecStart=__NODE_BIN__ __INSTALL_DIR__/bridge-matrix.js
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
EnvironmentFile=-__INSTALL_DIR__/.env

# --- Sandboxing ---
# PrivateTmp and ProtectHome are deliberately omitted; see agent-chat-v2.service
# for the rationale (tmux socket lives in /tmp, runtime tree under the user's home).
NoNewPrivileges=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# --- Resource limits ---
LimitNOFILE=4096
MemoryHigh=768M
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
