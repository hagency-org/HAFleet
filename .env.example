API_TOKEN=your-api-token-here

# --- Local service ports and URLs ---
# Backend API base URL used by CLIs and MCP clients.
#AGENT_CHAT_API=http://127.0.0.1:8090
# Runtime root for data/ and logs/ when not using the repository root.
#AGENT_CHAT_RUNTIME_DIR=/path/to/agent-chat-runtime
# Backend API port used by backend-v2, MCP, bridge, web proxy, and push relay.
#AGENT_CHAT_BACKEND_PORT=8090
# Web dashboard port.
#AGENT_CHAT_WEB_PORT=8084
# Public/local dashboard base URL used when backend builds web links.
#AGENT_CHAT_WEB_URL=http://127.0.0.1:8084
# Queue endpoint used by backend to push dashboard notifications.
#AGENT_CHAT_QUEUE_URL=http://127.0.0.1:8084/api/queue
# Agent Chat home directory for runtime state, agent homes, and relay scans.
#AGENTCHAT_HOMEDIR=/home/you/.agentchat
# Optional bearer for non-local dashboard mutating APIs. Local loopback callers
# remain allowed without this token; do not reuse API_TOKEN in browser clients.
#AGENT_CHAT_DASHBOARD_TOKEN=

# --- Push relay ---
# Relay mode: local for same-host tmux delivery, remote for relay package usage.
#PUSH_RELAY_MODE=local
# Include lease metadata in remote-mode queue polling.
#PUSH_RELAY_INCLUDE_LEASE_FIELDS=0
# Poll interval for local relay scans.
#PUSH_RELAY_SCAN_INTERVAL_MS=30000
# Delay before reconnecting queue streams.
#PUSH_RELAY_RECONNECT_MS=5000
# Heartbeat interval for long-lived relay connections.
#PUSH_RELAY_HEARTBEAT_INTERVAL_MS=15000
# Delay before injecting delivered messages into target panes.
#PUSH_RELAY_INJECT_DELAY_MS=300
# Poll interval while checking whether a target pane is blocked.
#PUSH_RELAY_BLOCK_SCAN_INTERVAL_MS=5000
# Log tail size used by blocked-pane detection.
#PUSH_RELAY_BLOCK_TAIL_LINES=40
# Recent log window used by blocked-pane detection.
#PUSH_RELAY_BLOCK_RECENT_LINES=14
# Recent log window used around compaction events.
#PUSH_RELAY_COMPACT_RECENT_LINES=30
# Throttle repeated relay skip logs.
#PUSH_RELAY_SKIP_LOG_THROTTLE_MS=30000
# TTL for cached MCP session lookups.
#PUSH_RELAY_MCP_SESSION_CACHE_TTL_MS=1000
# Queue drain cadence for web-delivered relay messages.
#RELAY_QUEUE_DRAIN_INTERVAL_MS=3000

# --- MCP server backend connection ---
# MCP server keepalive interval; set 0 to disable periodic backend heartbeat.
#MCP_HEARTBEAT_INTERVAL_MS=30000
# Timeout for MCP server backend API calls.
#MCP_FETCH_TIMEOUT_MS=10000
# Retry attempts for MCP server backend API calls.
#MCP_FETCH_RETRIES=3
# Comma-separated retry backoff delays in milliseconds.
#MCP_FETCH_BACKOFF_MS=500,1500

AGENT_CHAT_SERVER=local
AGENT_CHAT_RECORD_LOCAL_SERVER=0
AGENT_IDLE_THRESHOLD_MS=20000
AGENT_SCOPE_ENABLE=1
AGENT_SCOPE_MEMORY_HIGH_MB=4096
AGENT_SCOPE_MEMORY_MAX_MB=6144
AGENT_SCOPE_MEMORY_SWAP_MAX_MB=2048
AGENT_SCOPE_MONITOR_ENABLED=true
AGENT_SCOPE_SWEEP_INTERVAL_MS=5000
AGENT_SCOPE_ALERT_COOLDOWN_MS=60000
AGENT_SCOPE_ALERT_CLEAR_RATIO=0.85

SUPERVISOR_ENABLED=false
SUPERVISOR_INTERVAL_MS=30000
SUPERVISOR_LLM_PROVIDER=deepseek
SUPERVISOR_LLM_MODEL=deepseek-chat
SUPERVISOR_LLM_KEY=your-deepseek-api-key
SUPERVISOR_WARN_AFTER=3
SUPERVISOR_WARN_COOLDOWN_MS=600000
# Interval (ms) for supervisor lifecycle sweep (agent liveness check)
SUPERVISOR_LIFECYCLE_SWEEP_INTERVAL_MS=60000
AGENT_SWAP_ALERT_THRESHOLD_PCT=80
AGENT_SWAP_ALERT_CLEAR_PCT=75
REMINDER_MERGE_PREVIEW_LIMIT=20
OFFLINE_CATCHUP_LIST_LIMIT=50
FRP_API_ORIGIN=https://your-frp-domain.example.com
AGENT_SERVER_MAINTENANCE_IDS=your-server-id
AGENT_SERVER_MAINTENANCE_LAST_SEEN_UPDATE_MS=60000
MATRIX_HOMESERVER=https://matrix.example.com
MATRIX_SERVER_NAME=matrix.example.com
MATRIX_BOT_USERNAME=agent-bridge
MATRIX_BOT_PASSWORD=
MATRIX_REG_TOKEN=
MATRIX_AGENT_PREFIX=ac_
MATRIX_AGENT_PASSWORD_SECRET=
MATRIX_AGENT_PASSWORD_TEMPLATE=<your-bot-password>
MATRIX_ALLOW_LEGACY_AGENT_PASSWORD=false
# Room trust boundary: enforce | audit | off (default: audit)
MATRIX_TRUST_MODE=audit
# Comma-separated room IDs always trusted (bypass trust check)
#MATRIX_TRUSTED_ROOM_IDS=
# Comma-separated Matrix user IDs whose room invites are trusted
#MATRIX_TRUSTED_INVITER_MXIDS=
RECOVERY_TRIGGER_DELAY_SEC=25

# --- Agent token & launch ---
# Per-agent auth token enforcement: hard/soft enforce loaded tokens; audit logs only; other values normalize to audit.
AGENTCHAT_AGENT_TOKEN_MODE=hard
# Future relay/server credential split. Current server routes still use API_TOKEN;
# /health reports whether this is configured, but it is not accepted or enforced yet.
#AGENTCHAT_SERVER_TOKEN=
# Runtime-profile overrides injected into agent launch env by backend
# (leave blank — set automatically from preset/runtime-profile config)
#AGENTCHAT_LAUNCH_MODEL=
#AGENTCHAT_LAUNCH_EXTRA_ARGS=
# Shared secret for subconscious event webhook auth (optional)
#AGENTCHAT_SUBCONSCIOUS_EVENT_TOKEN=
