API_TOKEN=your-api-token-here
AGENT_CHAT_SERVER=local
AGENT_CHAT_RECORD_LOCAL_SERVER=0
AGENT_IDLE_THRESHOLD_MS=20000
AGENT_SCOPE_ENABLE=1
AGENT_SCOPE_MEMORY_HIGH_MB=4096
AGENT_SCOPE_MEMORY_MAX_MB=6144
AGENT_SCOPE_MEMORY_SWAP_MAX_MB=2048
AGENT_SCOPE_MONITOR_ENABLED=true
AGENT_SCOPE_SWEEP_INTERVAL_MS=5000
AGENT_SCOPE_ALERT_COOLDOWN_MS=60000
AGENT_SCOPE_ALERT_CLEAR_RATIO=0.85

SUPERVISOR_ENABLED=false
SUPERVISOR_INTERVAL_MS=30000
SUPERVISOR_LLM_PROVIDER=deepseek
SUPERVISOR_LLM_MODEL=deepseek-chat
SUPERVISOR_LLM_KEY=your-deepseek-api-key
SUPERVISOR_WARN_AFTER=3
SUPERVISOR_WARN_COOLDOWN_MS=600000
# Interval (ms) for supervisor lifecycle sweep (agent liveness check)
SUPERVISOR_LIFECYCLE_SWEEP_INTERVAL_MS=60000
AGENT_SWAP_ALERT_THRESHOLD_PCT=80
AGENT_SWAP_ALERT_CLEAR_PCT=75
REMINDER_MERGE_PREVIEW_LIMIT=20
OFFLINE_CATCHUP_LIST_LIMIT=50
FRP_API_ORIGIN=https://your-frp-domain.example.com
AGENT_SERVER_MAINTENANCE_IDS=your-server-id
AGENT_SERVER_MAINTENANCE_LAST_SEEN_UPDATE_MS=60000
MATRIX_HOMESERVER=https://matrix.example.com
MATRIX_SERVER_NAME=matrix.example.com
MATRIX_BOT_USERNAME=agent-bridge
MATRIX_BOT_PASSWORD=
MATRIX_REG_TOKEN=
MATRIX_AGENT_PREFIX=ac_
MATRIX_AGENT_PASSWORD_SECRET=
MATRIX_AGENT_PASSWORD_TEMPLATE=<your-bot-password>
MATRIX_ALLOW_LEGACY_AGENT_PASSWORD=false
# Room trust boundary: enforce | audit | off (default: audit)
MATRIX_TRUST_MODE=audit
# Comma-separated room IDs always trusted (bypass trust check)
#MATRIX_TRUSTED_ROOM_IDS=
# Comma-separated Matrix user IDs whose room invites are trusted
#MATRIX_TRUSTED_INVITER_MXIDS=
RECOVERY_TRIGGER_DELAY_SEC=25

# --- Agent token & launch ---
# Per-agent auth token enforcement: hard/soft enforce loaded tokens; audit logs only; other values normalize to audit.
AGENTCHAT_AGENT_TOKEN_MODE=hard
# Future relay/server credential split. Current server routes still use API_TOKEN;
# /health reports whether this is configured, but it is not accepted or enforced yet.
#AGENTCHAT_SERVER_TOKEN=
# Runtime-profile overrides injected into agent launch env by backend
# (leave blank — set automatically from preset/runtime-profile config)
#AGENTCHAT_LAUNCH_MODEL=
#AGENTCHAT_LAUNCH_EXTRA_ARGS=
# Shared secret for subconscious event webhook auth (optional)
#AGENTCHAT_SUBCONSCIOUS_EVENT_TOKEN=
