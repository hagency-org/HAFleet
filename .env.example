API_TOKEN=your-api-token-here

# --- Local service ports and URLs ---
# Backend API base URL used by CLIs and MCP clients.
#HAFLEET_API=http://127.0.0.1:8090
# Runtime root for data/ and logs/ when not using the repository root.
#HAFLEET_RUNTIME_DIR=/path/to/hafleet-runtime
# Backend API port used by backend-v2, MCP, bridge, web proxy, and push relay.
#HAFLEET_BACKEND_PORT=8090
# Interface the backend binds. Default 127.0.0.1 (loopback only): the loopback
# trust check treats every loopback peer as local, so a non-loopback value widens
# that boundary and is logged as a warning at startup. Expected inside a container
# (publish only 127.0.0.1:PORT on the host); wrong on a bare host.
#HAFLEET_BACKEND_HOST=127.0.0.1
# Web dashboard port.
#HAFLEET_WEB_PORT=8084
# Public/local dashboard base URL used when backend builds web links.
#HAFLEET_WEB_URL=http://127.0.0.1:8084
# Legacy override for Matrix "View formatted" links. Normally leave unset and
# let the bridge derive /msg links from HAFLEET_WEB_URL.
#MSG_BASE_URL=http://127.0.0.1:8084/msg
# Queue endpoint used by backend to push dashboard notifications.
#HAFLEET_QUEUE_URL=http://127.0.0.1:8084/api/queue
# Agent Chat home directory for runtime state, agent homes, and relay scans.
#HAFLEET_HOMEDIR=/home/you/.hafleet
# Optional bearer for non-local dashboard mutating APIs. Local loopback callers
# remain allowed without this token; do not reuse API_TOKEN in browser clients.
#HAFLEET_DASHBOARD_TOKEN=

# --- Push relay ---
# Relay mode: local for same-host tmux delivery, remote for relay package usage.
#PUSH_RELAY_MODE=local
# Include lease metadata in remote-mode queue polling.
#PUSH_RELAY_INCLUDE_LEASE_FIELDS=0
# Poll interval for local relay scans.
#PUSH_RELAY_SCAN_INTERVAL_MS=30000
# Delay before reconnecting queue streams.
#PUSH_RELAY_RECONNECT_MS=5000
# Heartbeat interval for long-lived relay connections.
#PUSH_RELAY_HEARTBEAT_INTERVAL_MS=15000
# Delay before injecting delivered messages into target panes.
#PUSH_RELAY_INJECT_DELAY_MS=300
# Poll interval while checking whether a target pane is blocked.
#PUSH_RELAY_BLOCK_SCAN_INTERVAL_MS=5000
# Log tail size used by blocked-pane detection.
#PUSH_RELAY_BLOCK_TAIL_LINES=40
# Recent log window used by blocked-pane detection.
#PUSH_RELAY_BLOCK_RECENT_LINES=14
# Recent log window used around compaction events.
#PUSH_RELAY_COMPACT_RECENT_LINES=30
# Throttle repeated relay skip logs.
#PUSH_RELAY_SKIP_LOG_THROTTLE_MS=30000
# TTL for cached MCP session lookups.
#PUSH_RELAY_MCP_SESSION_CACHE_TTL_MS=1000
# Queue drain cadence for web-delivered relay messages.
#RELAY_QUEUE_DRAIN_INTERVAL_MS=3000

# --- MCP server backend connection ---
# MCP server keepalive interval; set 0 to disable periodic backend heartbeat.
#MCP_HEARTBEAT_INTERVAL_MS=30000
# Timeout for MCP server backend API calls.
#MCP_FETCH_TIMEOUT_MS=10000
# Retry attempts for MCP server backend API calls.
#MCP_FETCH_RETRIES=3
# Comma-separated retry backoff delays in milliseconds.
#MCP_FETCH_BACKOFF_MS=500,1500

# Local server identity. Leave unset to default to hostname; only legacy local
# single-host deployments should use "local".
#HAFLEET_SERVER=
HAFLEET_RECORD_LOCAL_SERVER=0
AGENT_IDLE_THRESHOLD_MS=20000
AGENT_SCOPE_ENABLE=1
AGENT_SCOPE_MEMORY_HIGH_MB=4096
AGENT_SCOPE_MEMORY_MAX_MB=6144
AGENT_SCOPE_MEMORY_SWAP_MAX_MB=2048
AGENT_SCOPE_MONITOR_ENABLED=true
AGENT_SCOPE_SWEEP_INTERVAL_MS=5000
AGENT_SCOPE_ALERT_COOLDOWN_MS=60000
AGENT_SCOPE_ALERT_CLEAR_RATIO=0.85
# Consecutive successful tmux scans that must miss a session before marking it offline (minimum 3).
AGENT_TMUX_MISSING_THRESHOLD=3

SUPERVISOR_ENABLED=false
SUPERVISOR_INTERVAL_MS=30000
SUPERVISOR_LLM_PROVIDER=deepseek
SUPERVISOR_LLM_MODEL=deepseek-chat
SUPERVISOR_LLM_KEY=your-deepseek-api-key
SUPERVISOR_WARN_AFTER=3
SUPERVISOR_WARN_COOLDOWN_MS=600000
# Interval (ms) for supervisor lifecycle sweep (agent liveness check)
SUPERVISOR_LIFECYCLE_SWEEP_INTERVAL_MS=60000
AGENT_SWAP_ALERT_THRESHOLD_PCT=80
AGENT_SWAP_ALERT_CLEAR_PCT=75
REMINDER_MERGE_PREVIEW_LIMIT=20
OFFLINE_CATCHUP_LIST_LIMIT=50
FRP_API_ORIGIN=https://your-frp-domain.example.com
# Comma-separated server IDs that should start in maintenance mode. When set (even
# empty), this list reconciles persisted maintenance state on backend startup.
#AGENT_SERVER_MAINTENANCE_IDS=
AGENT_SERVER_MAINTENANCE_LAST_SEEN_UPDATE_MS=60000
MATRIX_HOMESERVER=https://matrix.example.com
MATRIX_SERVER_NAME=matrix.example.com
MATRIX_BOT_USERNAME=agent-bridge
MATRIX_BOT_PASSWORD=
MATRIX_REG_TOKEN=
MATRIX_AGENT_PREFIX=ac_
# Per-agent Matrix access token: MATRIX_AGENT_TOKEN_<AGENT>, with the agent name
# upper-cased and every non-alphanumeric character replaced by `_`. So agent
# `wf_coordinator` reads MATRIX_AGENT_TOKEN_WF_COORDINATOR. Not enumerated here
# because the set of agents is per deployment; add one line per agent:
#MATRIX_AGENT_TOKEN_WF_COORDINATOR=
#
# Create (or claim) the Matrix account yourself and paste ITS access token. The
# bridge no longer derives agent passwords from a single secret — that secret
# could not be rotated (changing it locks the bridge out of every existing
# account at once, and the usernames are taken so it cannot re-register them),
# the credentials were not revocable (revoking a token achieved nothing while
# the password stayed re-derivable), and deriving required account-CREATION
# rights on the homeserver, which a third-party project never grants an external
# bridge. See ADR-014 decision 3. Rotate one agent by replacing its own line;
# the bridge validates the new token and adopts it, and no other agent is
# touched.
# Shared secret between backend-v2 and bridge-matrix — both must load the SAME
# value, so source one .env for both (see services/README.md). Matrix message
# ingestion fails closed if this is empty (backend: 503) or the bridge's header
# doesn't match it (backend: 401); the bridge process also refuses to start
# without it. Generate one with:
# openssl rand -hex 32
MATRIX_BRIDGE_SECRET=

# ── Inbound appservice (ADR-016) ───────────────────────────────────────────────
#
# Under an appservice the direction is INVERTED from everything else here: the
# PROJECT'S homeserver pushes events to HAFleet, so HAFleet needs an address it
# can reach. The registration-token path is outbound-only and needs none of this,
# which is why it is the one that works from behind NAT.
#
# UNSET = NO SOCKET AT ALL. The bridge holds zero listening sockets otherwise, and
# a deployment serving only registration-token project sides never needs one.
#HAFLEET_APPSERVICE_PORT=8009
#
# Defaults to 127.0.0.1. A homeserver on another machine cannot reach loopback, so
# serving one means widening this deliberately — the bridge logs a warning when you
# do, because a surface that appears on every interface should be a decision rather
# than a discovery.
#HAFLEET_APPSERVICE_BIND=0.0.0.0
#
# How often the bridge re-reads which project sides it serves. Slow on purpose.
#HAFLEET_APPSERVICE_REFRESH_MS=60000
# Optional comma-separated Matrix users to proactively greet even when the
# homeserver user directory hides users without shared/public rooms.
#MATRIX_GREETING_MXIDS=@alice:matrix.example.com,bob
# Comma-separated Matrix senders the bridge should ignore entirely — messages
# from these senders never reach an agent inbox. Use this for OTHER
# loop-causing service/appservice bots that share a room. The bridge's own bot
# account and puppeted agent accounts are excluded automatically; do not list
# them here.
#MATRIX_IGNORED_SENDER_MXIDS=@octosbot:matrix.example.com
# Agent-invite poll interval in ms (default 60000, clamped to a 5000 floor).
# Public homeservers like matrix.palpo.im rate-limit aggressively; do not poll faster.
# This poll fans out to a sync + join + bot-invite request per known agent, then chains
# into the bot-invite poll, room scan, and managed-room backfill — it's the single
# biggest source of request amplification in the bridge (Task 5: 收敛 Matrix 429).
#MATRIX_INVITE_POLL_MS=60000
# Joined-room scan interval in ms (default 120000, clamped to a 30000 floor). Each cycle
# issues O(rooms) requests (membership + room-state lookups per unmapped room), so it gets
# a higher floor than the invite poll. All Matrix request sources share one rate-limit
# cooldown gate (src/matrix-rate-limit-gate.mjs): a 429 from any of them pauses every
# other poller too, instead of each backing off independently.
#MATRIX_ROOM_SCAN_POLL_MS=120000

# Default-wake for un-addressed group messages: off (default) | auto (legacy).
# Keep this off for shared/project rooms: only an explicit @agent mention may
# wake an agent. 'auto' is only for private, single-owner compatibility setups.
MATRIX_DEFAULT_WAKE=off
# Room trust boundary: enforce | audit | off. Code default is audit (dev/CI
# only — logs untrusted rooms but does not block them; see
# docs/architecture/auth-trust-model.md §6). Every real deployment, including
# this standalone one, must ship enforce: room invites and messages from
# untrusted rooms/inviters are actively rejected instead of just logged.
MATRIX_TRUST_MODE=enforce
# Comma-separated room IDs always trusted (bypass trust check)
#MATRIX_TRUSTED_ROOM_IDS=
# Comma-separated Matrix user IDs allowed to invite the bridge bot (and
# transitively, agents) into a room. Under MATRIX_TRUST_MODE=enforce, an
# invite from anyone else is rejected and the bot auto-leaves the room.
MATRIX_TRUSTED_INVITER_MXIDS=@operator:matrix.example.com
# Console command authorization (the !commands sent in a Matrix room). Both are
# comma-separated MXIDs. Operators may run tier<=2 commands; admins may run every
# tier (including tier 3). MATRIX_OPERATOR_MXIDS also tags a sender's trust_level
# as "operator" instead of "external" in the bridge. Both default empty.
#MATRIX_OPERATOR_MXIDS=@operator:matrix.example.com
#MATRIX_ADMIN_MXIDS=@admin:matrix.example.com
# Fail-closed guard: when BOTH lists above are empty, tier>=1 console commands are
# REFUSED (public tier-0 !help/!request still work). Default false. Set true only
# to restore the legacy "no ACL configured = anyone may drive the agents" behaviour.
#MATRIX_ALLOW_UNCONFIGURED_ACL=false
RECOVERY_TRIGGER_DELAY_SEC=25

# --- Task 8: standalone cross-component doctor (services/standalone-doctor.mjs) ---
# Acceptance-room membership check (check 6). Both unset by default: the doctor then
# reports the check as "not_configured" and fails closed overall unless the CLI is run
# with --allow-unconfigured-room (for pre-room bootstrap, before this room exists yet).
#MATRIX_ACCEPTANCE_ROOM_ID=!acceptance:matrix.example.com
# Comma-separated agent names required to be joined to the acceptance room above.
#MATRIX_ACCEPTANCE_AGENTS=reviewer-agent,coordinator-agent
# Bridge/relay business-health record freshness thresholds (check 5). Floor-validated
# at 5000ms. The bridge and relay each write their own record on an independent timer
# (BRIDGE_HEALTH_WRITE_INTERVAL_MS / PUSH_RELAY_HEALTH_WRITE_INTERVAL_MS below) well
# under these thresholds, so a healthy process never flaps the freshness check.
#BRIDGE_HEALTH_MAX_AGE_MS=120000
#RELAY_HEALTH_MAX_AGE_MS=90000
# How often bridge-matrix.js / push-relay.js write data/health/*.json. Floor-validated
# at 5000ms.
#BRIDGE_HEALTH_WRITE_INTERVAL_MS=30000
#PUSH_RELAY_HEALTH_WRITE_INTERVAL_MS=20000

# matrix-Agent dispatch lease TTL (Task 7): how long a POST /api/dispatch reservation stays
# claimed without a POST /api/dispatch/renew heartbeat before it's reaped and the agent is
# freed. Default 15 minutes. Floor-validated at 1000ms — anything shorter has no realistic
# chance of a renew round-trip landing before expiry under real process/network latency, so a
# smaller value is treated as misconfiguration and clamped up rather than honored.
#HAFLEET_DISPATCH_LEASE_TTL_MS=900000
# POST /api/dispatch/release rejects the legacy {agent}-only shape (no leaseId/owner) by default
# — allowing it unconditionally would let the "owner mismatch must fail" contract be dodged just
# by omitting fields. Set to 1 to accept it anyway (no ownership check when accepted): this is a
# compatibility shim for the descoped OpenFab bridge, keep off in standalone.
#HAFLEET_ALLOW_LEGACY_RELEASE=0

# --- Agent token & launch ---
# Per-agent auth token enforcement: hard/soft enforce loaded tokens; audit logs only; other values normalize to audit.
# In hard mode, a missing managed-agent token flips backend /health (and the
# standalone doctor's authAndTokenIntegrity check) to degraded rather than
# silently letting the agent through.
HAFLEET_AGENT_TOKEN_MODE=hard
# Future relay/server credential split. Current server routes still use API_TOKEN;
# /health reports whether this is configured, but it is not accepted or enforced yet.
#HAFLEET_SERVER_TOKEN=
# Runtime-profile overrides injected into agent launch env by backend
# (leave blank — set automatically from preset/runtime-profile config)
#HAFLEET_LAUNCH_MODEL=
#HAFLEET_LAUNCH_EXTRA_ARGS=
# Coding-agent permissions are enforced by hafleet and cannot be replaced
# through extraArgs: Claude uses permission-mode auto; Codex permission Level 2
# maps to workspace-write + on-request. Managed project real paths are added as
# writable roots so symlink-mounted projects remain usable inside the sandbox.

# --- Which tmux sessions may HAFleet manage? --------------------------------
# HAFleet registers tmux sessions as agents and delivers messages by typing into
# their panes. It cannot distinguish an agent's pane from any other terminal, so
# by default it claims every session on the host. On a shared machine that means
# it can type into unrelated work — observed for real on a fleet host, where a
# fresh install adopted five sessions running someone else's processes.
#
# Comma- or whitespace-separated. `*` matches any run of characters. A session
# named on the denylist is refused even if the allowlist also names it.
# Leave both unset to manage everything, which is the historical behaviour.
#HAFLEET_SESSION_ALLOWLIST=claude-*,codex-*
#HAFLEET_SESSION_DENYLIST=

# ── Memory / transcript export (PRD R20) ─────────────────────────
# A STANDING GATE WITH NO CURRENT CALLER. The subsystem these settings governed — the
# subconscious memory path, which sent full session transcripts to a configured
# endpoint — was removed in ADR-015. Nothing in HAFleet exports a transcript today, so
# leaving all three at their defaults is correct and changes nothing.
#
# They are kept, unchanged, because they are the control any FUTURE export path must be
# built against. What is worth knowing about the deleted one is WHY: its endpoint
# defaulted to a third-party SaaS, in a product whose README says nothing needs to leave
# the machine. That default is the reason these three lines exist.
#
# Both settings are required to send anything, and neither defaults to permissive:
# enabling an export path is not the same as saying where transcripts may go.
#
# Off unless exactly '1'. This is the repo's default-OFF form; do not change it to
# `!== '0'`, which would make egress the default.
HAFLEET_MEMORY_EXPORT=
# Comma-separated hosts approved to receive transcripts. Empty means none.
# Loopback and *.local are approved without being listed (see ALLOW_LOCAL), because
# PRD R20 permits "off or an approved local destination" — a self-hosted receiver on
# loopback is the case that allowance exists for.
HAFLEET_MEMORY_EXPORT_ALLOWED_HOSTS=
# Set to 0 to require every destination be listed explicitly, loopback included.
HAFLEET_MEMORY_EXPORT_ALLOW_LOCAL=1

# --- Contribution console & approval binding -------------------------------
# Submit-only credential for the contribution console (the !request command).
# SCOPE: it may ONLY submit an engagement request. It may NOT approve/decline a
# request, whitelist an agent for auto-join, or widen an offer — those still
# require the operator API_TOKEN. When set, the bridge prefers it over API_TOKEN
# so a request is submitted with the narrowest credential that works; when unset,
# submission falls back to API_TOKEN. Optional; no default.
#HAFLEET_REQUESTER_TOKEN=
# Owner for the FIRST approval binding on a fresh deployment — used only when no
# existing binding already names an owner and the Matrix bridge has not created
# one. BOTH are required together: the backend binds only when the MXID and the DM
# room are both set; with either missing it does not bind and records why. Both
# default empty.
#HAFLEET_OWNER_MXID=@you:your-server.example
#HAFLEET_OWNER_DM_ROOM=!yourDmRoom:your-server.example

# --- Project repository inspection -----------------------------------------
# Backend-only token for reading PRIVATE AtomGit repos in the project board. Sent
# only as an "Authorization: Bearer" header to api.atomgit.com; it is never placed
# in any projection returned to clients. Optional; unset = public repos only.
#ATOMGIT_TOKEN=

# --- Retention bounds ------------------------------------------------------
# Settled contribution-invitation records kept before the oldest is folded away;
# pending invitations are never pruned. Default 200, floor 20.
#HAFLEET_PENDING_INVITE_HISTORY=200
# Usage-ledger period buckets kept per agent before the oldest is folded away.
# Default 14, floor 2.
#HAFLEET_LEDGER_PERIODS=14
# Per-agent session detail kept in the usage ledger before older sessions are
# folded into a "retired" aggregate. Default 500, floor 10.
#HAFLEET_LEDGER_SESSIONS_PER_AGENT=500
