{
  "importBoundaries": [
    {
      "name": "kernel libraries do not import backend, dashboard, or optional edge owners",
      "include": [
        "lib/agent-home-v1.js",
        "lib/agent-state.js",
        "lib/mcp-server-core.js",
        "lib/push-relay-core.js",
        "lib/runtime-dir-guard.js",
        "lib/runtime/"
      ],
      "forbiddenResolvedPrefixes": [
        "backend-v2.js",
        "server.js",
        "bridge-matrix.js",
        "lib/alert-store.js",
        "lib/supervisor-",
        "lib/task-",
        "remote/"
      ]
    },
    {
      "name": "dashboard modules do not import backend or remote runtime owners",
      "include": [
        "lib/dashboard/"
      ],
      "allowMissing": true,
      "forbiddenResolvedPrefixes": [
        "backend-v2.js",
        "server.js",
        "bridge-matrix.js",
        "lib/mcp-server-core.js",
        "lib/push-relay-core.js",
        "remote/"
      ]
    },
    {
      "name": "remote package stays self-contained",
      "include": [
        "remote/"
      ],
      "forbiddenSpecifierPatterns": [
        "^\\.\\./\\.\\./"
      ],
      "forbiddenResolvedPrefixes": [
        "backend-v2.js",
        "server.js",
        "bridge-matrix.js",
        "lib/"
      ]
    }
  ],
