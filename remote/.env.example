HAFLEET_API=https://hafleet.example.com
API_TOKEN=
# MCP server keepalive interval; set 0 to disable periodic backend heartbeat.
#MCP_HEARTBEAT_INTERVAL_MS=30000
# Timeout/retry settings for MCP server backend API calls.
#MCP_FETCH_TIMEOUT_MS=10000
#MCP_FETCH_RETRIES=3
#MCP_FETCH_BACKOFF_MS=500,1500
# Optional only for helper scripts that call a non-local dashboard queue/reminder URL.
#HAFLEET_DASHBOARD_TOKEN=
# Future relay/server credential split. Current server routes still use API_TOKEN;
# /health reports HAFLEET_SERVER_TOKEN if configured, but it is not accepted or enforced yet.
#HAFLEET_SERVER_TOKEN=
# Required remote server identity. Use this host's unique id; never use "local".
HAFLEET_SERVER=
HAFLEET_DEPLOY_BRANCH=stable
VERIFY_SAMPLES=2
VERIFY_INTERVAL=16
# Optional canary agent checked after remote relay restart.
#VERIFY_AGENT=
