AGENT_CHAT_API=https://agentchat.example.com
API_TOKEN=
# Optional only for helper scripts that call a non-local dashboard queue/reminder URL.
#AGENT_CHAT_DASHBOARD_TOKEN=
# Future relay/server credential split. Current server routes still use API_TOKEN;
# /health reports AGENTCHAT_SERVER_TOKEN if configured, but it is not accepted or enforced yet.
#AGENTCHAT_SERVER_TOKEN=
AGENT_CHAT_SERVER=
AGENTCHAT_DEPLOY_BRANCH=stable
VERIFY_SAMPLES=2
VERIFY_INTERVAL=16
# Optional canary agent checked after remote relay restart.
#VERIFY_AGENT=
