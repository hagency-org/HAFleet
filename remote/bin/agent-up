#!/bin/bash
# agent-up — Quick agent launcher with resume support
#
# Usage:
#   agent-up <name> [path] [claude|codex] [--fresh] [--attach] [--model <model>] [--extra-args "<args>"]
#
# If path is omitted, reads from saved meta.json (previous agent-down).
# If --fresh is not set, resume-id is required for strict resume (no silent fallback).
#
# Examples:
#   agent-up umiki-worker ~/laplace/umiki claude                           # first time
#   agent-up umiki-worker                                                   # resume from meta
#   agent-up umiki-worker --fresh                                           # new session, same path
#   agent-up ddnsserer ~/cloudflare codex                                   # codex agent
#   agent-up news ~/laplace/news claude --model claude-opus-4-1             # fixed model
#   agent-up coder ~/laplace/repo codex --model gpt-5.3-codex-spark         # codex model
#   agent-up ops ~/laplace/ops codex --extra-args "--approval-mode never"   # custom startup args

set -euo pipefail

_resolve_script_dir() {
  local src="$0"
  while [ -L "$src" ]; do
    local dir
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
  done
  cd -P "$(dirname "$src")" && pwd
}
SCRIPT_DIR="$(_resolve_script_dir)"
BASE_DIR="$(dirname "$SCRIPT_DIR")"
DATA_DIR="$BASE_DIR/data/agents"

# Load .env if present
ENV_FILE="$BASE_DIR/.env"
if [ -f "$ENV_FILE" ]; then
  set -a
  source "$ENV_FILE"
  set +a
fi

BACKEND_URL="${AGENT_CHAT_API:-http://127.0.0.1:8090}"
SERVER_ID="${AGENT_CHAT_SERVER:-}"
API_TOKEN="${API_TOKEN:-}"
AGENT_SCOPE_ENABLE_RAW="${AGENT_SCOPE_ENABLE:-1}"
AGENT_SCOPE_MEMORY_HIGH_MB_RAW="${AGENT_SCOPE_MEMORY_HIGH_MB:-0}"
AGENT_SCOPE_MEMORY_MAX_MB_RAW="${AGENT_SCOPE_MEMORY_MAX_MB:-0}"
AGENT_SCOPE_MEMORY_SWAP_MAX_MB_RAW="${AGENT_SCOPE_MEMORY_SWAP_MAX_MB:-0}"

# Auth header for API calls
AUTH_HEADER=""
[ -n "$API_TOKEN" ] && AUTH_HEADER="Authorization: Bearer $API_TOKEN"

api_curl() {
  if [ -n "$AUTH_HEADER" ]; then
    curl --noproxy '*' -s -H "$AUTH_HEADER" "$@"
  else
    curl --noproxy '*' -s "$@"
  fi
}

url_encode() {
  python3 - "$1" <<'PY'
import sys
import urllib.parse
print(urllib.parse.quote(sys.argv[1], safe=""))
PY
}

resolve_agent_name_backend() {
  local raw="$1"
  local encoded payload
  encoded="$(url_encode "$raw")"
  payload="$(api_curl "$BACKEND_URL/api/agents/$encoded" 2>/dev/null || true)"
  [ -n "$payload" ] || return 0
  RAW_NAME="$raw" PAYLOAD="$payload" python3 - <<'PY' 2>/dev/null || true
import json
import os

raw = os.environ.get("RAW_NAME", "").strip()
payload = os.environ.get("PAYLOAD", "")
if not raw or not payload:
    raise SystemExit(0)
try:
    obj = json.loads(payload)
except Exception:
    raise SystemExit(0)
if isinstance(obj, dict) and not obj.get("error"):
    name = str(obj.get("name") or "").strip()
    if name and name.lower() == raw.lower():
        print(name)
PY
}

resolve_agent_name_tmux() {
  local raw="$1"
  local sessions
  sessions="$(tmux list-sessions -F '#{session_name}' 2>/dev/null || true)"
  [ -n "$sessions" ] || return 0
  RAW_NAME="$raw" TMUX_SESSIONS="$sessions" python3 - <<'PY' 2>/dev/null || true
import os

raw = os.environ.get("RAW_NAME", "").strip()
sessions = os.environ.get("TMUX_SESSIONS", "")
if not raw or not sessions:
    raise SystemExit(0)
matches = []
for line in sessions.splitlines():
    name = line.strip()
    if name and name.lower() == raw.lower():
        matches.append(name)
seen = []
for name in matches:
    if name not in seen:
        seen.append(name)
for name in seen:
    print(name)
PY
}

resolve_agent_name_data_dir() {
  local raw="$1"
  local dirs=""
  if [ -d "$DATA_DIR" ]; then
    local d
    for d in "$DATA_DIR"/*; do
      [ -d "$d" ] || continue
      dirs="${dirs}$(basename "$d")"$'\n'
    done
  fi
  [ -n "$dirs" ] || return 0
  RAW_NAME="$raw" AGENT_DIR_NAMES="$dirs" python3 - <<'PY' 2>/dev/null || true
import os

raw = os.environ.get("RAW_NAME", "").strip()
dirs = os.environ.get("AGENT_DIR_NAMES", "")
if not raw or not dirs:
    raise SystemExit(0)
matches = []
for line in dirs.splitlines():
    name = line.strip()
    if name and name.lower() == raw.lower():
        matches.append(name)
seen = []
for name in matches:
    if name not in seen:
        seen.append(name)
for name in seen:
    print(name)
PY
}

resolve_agent_name_casefold() {
  local raw="$1"
  local backend_name tmux_names data_names candidates resolved
  backend_name="$(resolve_agent_name_backend "$raw")"
  tmux_names="$(resolve_agent_name_tmux "$raw")"
  data_names="$(resolve_agent_name_data_dir "$raw")"

  candidates=""
  [ -n "$backend_name" ] && candidates="${candidates}${backend_name}"$'\n'
  [ -n "$tmux_names" ] && candidates="${candidates}${tmux_names}"$'\n'
  [ -n "$data_names" ] && candidates="${candidates}${data_names}"$'\n'

  resolved="$(RAW_NAME="$raw" CANDIDATES="$candidates" python3 - <<'PY'
import os
import sys

raw = os.environ.get("RAW_NAME", "").strip()
candidates = os.environ.get("CANDIDATES", "")
if not raw:
    print("")
    raise SystemExit(0)

seen = []
for line in candidates.splitlines():
    name = line.strip()
    if not name:
        continue
    if name.lower() != raw.lower():
        continue
    if name not in seen:
        seen.append(name)

if len(seen) <= 1:
    print(seen[0] if seen else raw)
    raise SystemExit(0)

print(f"conflict:{','.join(seen)}")
raise SystemExit(3)
PY
)"
  if [[ "$resolved" == conflict:* ]]; then
    echo "Error: case-conflicting agent names detected for '$raw': ${resolved#conflict:}" >&2
    echo "Refusing to continue. Keep only one canonical case variant." >&2
    exit 1
  fi
  echo "$resolved"
}

# Helper: post lifecycle event to info group
post_lifecycle() {
  local event_summary="$1"
  local event_full="${2:-$1}"
  local summary_json full_json
  summary_json=$(EVENT_SUMMARY="$event_summary" python3 - <<'PY'
import json, os
print(json.dumps(os.environ["EVENT_SUMMARY"]))
PY
)
  full_json=$(EVENT_FULL="$event_full" python3 - <<'PY'
import json, os
print(json.dumps(os.environ["EVENT_FULL"]))
PY
)
  api_curl -X POST "$BACKEND_URL/api/messages" \
    -H 'Content-Type: application/json' \
    -d "{\"from\":\"system\",\"group\":\"info\",\"type\":\"inform\",\"summary\":${summary_json},\"full\":${full_json},\"mentions\":[]}" \
    >/dev/null 2>&1 || true
}

register_backend_agent() {
  local payload
  payload=$(NAME="$NAME" TYPE="$TYPE" TMUX="${NAME}:0.0" SERVER="$SERVER_ID" python3 - <<'PY'
import json
import os

server = os.environ.get("SERVER", "").strip() or None
print(json.dumps({
    "name": os.environ["NAME"],
    "type": os.environ["TYPE"],
    "tmux": os.environ["TMUX"],
    "server": server,
    "manualDown": False,
}))
PY
)
  if api_curl -X POST "$BACKEND_URL/api/agents" \
    -H 'Content-Type: application/json' \
    -d "$payload" >/dev/null 2>&1; then
    echo "Registered '$NAME' online in backend."
  else
    echo "Warning: failed to register '$NAME' online in backend (heartbeat may backfill)." >&2
  fi
}

# ── Check for updates ────────────────────────────────────────────────
REPO_DIR="$(dirname "$BASE_DIR")"
if [ -d "$REPO_DIR/.git" ]; then
  echo "Checking updates before agent-up..."
  (
    cd "$REPO_DIR" || exit 0
    if ! git fetch origin --quiet 2>/dev/null; then
      echo "Warning: update check failed (git fetch origin). Continuing agent-up." >&2
      exit 0
    fi
    LOCAL=$(git rev-parse HEAD 2>/dev/null | tr -d '[:space:]' || true)
    TRACK_REF=""
    REMOTE=$(git rev-parse origin/main 2>/dev/null || true)
    if [ -n "$REMOTE" ]; then
      TRACK_REF="origin/main"
    else
      REMOTE=$(git rev-parse origin/master 2>/dev/null || true)
      [ -n "$REMOTE" ] && TRACK_REF="origin/master"
    fi
    REMOTE=$(echo "$REMOTE" | tr -d '[:space:]')
    if [ -z "$LOCAL" ] || [ -z "$REMOTE" ] || [ -z "$TRACK_REF" ]; then
      echo "Warning: update check could not resolve repository refs. Continuing agent-up." >&2
      exit 0
    fi
    if [ "$LOCAL" = "$REMOTE" ]; then
      echo "Update check: up to date."
      exit 0
    fi
    BEHIND=$(git rev-list --count "HEAD..$TRACK_REF" 2>/dev/null || echo "0")
    BEHIND=$(echo "$BEHIND" | tr -d '[:space:]')
    if [ "$BEHIND" -gt 0 ] 2>/dev/null; then
      echo "Updates available ($BEHIND commits behind). Run 'agent-update' to install."
    else
      AHEAD=$(git rev-list --count "$TRACK_REF..HEAD" 2>/dev/null || echo "0")
      AHEAD=$(echo "$AHEAD" | tr -d '[:space:]')
      if [ "$AHEAD" -gt 0 ] 2>/dev/null; then
        echo "Update check: local branch is ahead of $TRACK_REF ($AHEAD commits)."
      else
        echo "Update check: local and $TRACK_REF diverged."
      fi
    fi
  )
else
  echo "Update check: skipped (no git repository at $REPO_DIR)."
fi

# ── Parse args ────────────────────────────────────────────────────────
if [ $# -lt 1 ]; then
  echo "Usage: agent-up <name> [path] [claude|codex] [--fresh] [--attach] [--model <model>] [--extra-args \"<args>\"]"
  echo ""
  echo "  name     tmux session name / agent name"
  echo "  path     working directory (optional if previously saved)"
  echo "  type     claude (default) or codex"
  echo "  --fresh  ignore saved resume ID, start a new session"
  echo "  --attach attach to the session after creating it"
  echo "  --model  model name passed to claude/codex at startup"
  echo "  --extra-args additional raw startup args passed to claude/codex"
  exit 1
fi

RAW_NAME="$1"
NAME="$(resolve_agent_name_casefold "$RAW_NAME")"
shift
if [ "$NAME" != "$RAW_NAME" ]; then
  echo "Resolved agent name '$RAW_NAME' -> '$NAME'"
fi
TMUX_TARGET="=${NAME}"
TMUX_PANE_TARGET="=${NAME}:0.0"

FRESH=false
ATTACH=false
AGENT_PATH=""
TYPE=""
MODEL=""
EXTRA_ARGS=""

while [ $# -gt 0 ]; do
  case "$1" in
    --fresh)
      FRESH=true
      shift
      ;;
    --attach)
      ATTACH=true
      shift
      ;;
    --model)
      if [ $# -lt 2 ]; then
        echo "Error: --model requires a value" >&2
        exit 1
      fi
      MODEL="$2"
      shift 2
      ;;
    --extra-args)
      if [ $# -lt 2 ]; then
        echo "Error: --extra-args requires a value" >&2
        exit 1
      fi
      EXTRA_ARGS="$2"
      shift 2
      ;;
    claude|codex)
      TYPE="$1"
      shift
      ;;
    *)
      if [ -z "$AGENT_PATH" ]; then
        AGENT_PATH="$1"
        shift
      else
        echo "Error: unrecognized argument '$1'" >&2
        exit 1
      fi
      ;;
  esac
done

# ── Load saved meta ──────────────────────────────────────────────────
AGENT_DATA="$DATA_DIR/$NAME"
META_FILE="$AGENT_DATA/meta.json"
RESUME_FILE="$AGENT_DATA/resume-id"
TMP_RUNTIME_DIR="$AGENT_DATA/tmp"

# Auto-detect first-time agent: no meta AND no resume-id => fresh start.
# If resume-id already exists (e.g. recovered via agent-down), keep resume path.
if [ ! -f "$META_FILE" ] && [ "$FRESH" = false ] && [ ! -f "$RESUME_FILE" ]; then
  FRESH=true
fi

SAVED_PATH=""
SAVED_TYPE=""
SAVED_MODEL=""
SAVED_EXTRA_ARGS=""
SAVED_SESSION_ID=""
if [ -f "$META_FILE" ]; then
  SAVED_PATH=$(python3 -c "import json; d=json.load(open('$META_FILE')); print(d.get('path',''))" 2>/dev/null || true)
  SAVED_TYPE=$(python3 -c "import json; d=json.load(open('$META_FILE')); print(d.get('type',''))" 2>/dev/null || true)
  SAVED_MODEL=$(python3 -c "import json; d=json.load(open('$META_FILE')); print(d.get('model',''))" 2>/dev/null || true)
  SAVED_EXTRA_ARGS=$(python3 -c "import json; d=json.load(open('$META_FILE')); print(d.get('extraArgs',''))" 2>/dev/null || true)
  SAVED_SESSION_ID=$(python3 -c "import json; d=json.load(open('$META_FILE')); print(d.get('sessionId',''))" 2>/dev/null || true)
fi

# Apply defaults from meta
[ -z "$AGENT_PATH" ] && AGENT_PATH="$SAVED_PATH"
[ -z "$TYPE" ] && TYPE="${SAVED_TYPE:-claude}"
[ -z "$MODEL" ] && MODEL="$SAVED_MODEL"
[ -z "$EXTRA_ARGS" ] && EXTRA_ARGS="$SAVED_EXTRA_ARGS"

# Validate
if [ -z "$AGENT_PATH" ]; then
  echo "Error: no path specified and no saved meta for '$NAME'" >&2
  echo "Usage: agent-up <name> <path> [claude|codex]" >&2
  exit 1
fi

AGENT_PATH="$(cd "$AGENT_PATH" 2>/dev/null && pwd -P || echo "$AGENT_PATH")"

if [ ! -d "$AGENT_PATH" ]; then
  echo "Error: path '$AGENT_PATH' does not exist or is not a directory" >&2
  exit 1
fi

if [ "$TYPE" != "claude" ] && [ "$TYPE" != "codex" ]; then
  echo "Error: type must be 'claude' or 'codex', got '$TYPE'" >&2
  exit 1
fi

claude_project_dir_for_path() {
  local p="$1"
  [ -n "$p" ] || return 1
  echo "$HOME/.claude/projects/${p//\//-}"
}

is_valid_claude_session_id() {
  local p="$1" sid="$2"
  local d
  [ -n "$sid" ] || return 1
  d=$(claude_project_dir_for_path "$p") || return 1
  [ -f "$d/$sid.jsonl" ]
}

is_valid_uuid() {
  local sid="$1"
  echo "$sid" | grep -qE '^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$'
}

codex_session_file_for_id() {
  local sid="$1"
  local sessions_dir="$HOME/.codex/sessions"
  [ -n "$sid" ] || return 1
  [ -d "$sessions_dir" ] || return 1
  find "$sessions_dir" -type f -name "*${sid}*.jsonl" 2>/dev/null | sort -r | head -1
}

is_valid_codex_session_id_for_path() {
  local expected_path="$1"
  local sid="$2"
  local expected_name="${3:-}"
  local session_file
  [ -n "$expected_path" ] || return 1
  [ -n "$sid" ] || return 1
  session_file="$(codex_session_file_for_id "$sid")"
  [ -n "$session_file" ] || return 1
  EXPECTED_PATH="$expected_path" SESSION_FILE="$session_file" EXPECTED_AGENT_NAME="$expected_name" python3 - <<'PY' >/dev/null 2>&1
import json
import os
import sys

expected = os.path.realpath(os.environ.get("EXPECTED_PATH", ""))
session_file = os.environ.get("SESSION_FILE", "")
expected_agent_name = os.environ.get("EXPECTED_AGENT_NAME", "").strip()
if not expected or not session_file:
    raise SystemExit(1)
try:
    with open(session_file, "r", encoding="utf-8") as f:
        first = f.readline().strip()
        prefix = "".join([first] + [f.readline() for _ in range(600)])
    obj = json.loads(first) if first else {}
except Exception:
    raise SystemExit(1)
payload = obj.get("payload") if isinstance(obj, dict) else None
cwd = str(payload.get("cwd") or "").strip() if isinstance(payload, dict) else ""
if not cwd:
    raise SystemExit(1)
if os.path.realpath(cwd) != expected:
    raise SystemExit(1)
if expected_agent_name:
    marker = f"Your name is {expected_agent_name}."
    if marker not in prefix:
        raise SystemExit(1)
raise SystemExit(0)
PY
}

generate_uuid() {
  python3 - <<'PY'
import uuid
print(uuid.uuid4())
PY
}

have_cmd() {
  command -v "$1" >/dev/null 2>&1
}

normalize_mb_value() {
  local raw="$1"
  if [[ "$raw" =~ ^[0-9]+$ ]] && [ "$raw" -gt 0 ]; then
    echo "$raw"
  else
    echo "0"
  fi
}

scope_unit_for_agent() {
  local name="$1"
  local clean
  clean="$(printf '%s' "$name" | sed -E 's/[^A-Za-z0-9_-]+/-/g; s/^-+//; s/-+$//')"
  [ -n "$clean" ] || clean="agent"
  echo "agent-${clean}.scope"
}

AGENT_SCOPE_ENABLE_LC="$(printf '%s' "$AGENT_SCOPE_ENABLE_RAW" | tr '[:upper:]' '[:lower:]')"
AGENT_SCOPE_ENABLE="0"
if [ "$AGENT_SCOPE_ENABLE_RAW" != "0" ] && [ "$AGENT_SCOPE_ENABLE_LC" != "false" ]; then
  AGENT_SCOPE_ENABLE="1"
fi
AGENT_SCOPE_MEMORY_HIGH_MB="$(normalize_mb_value "$AGENT_SCOPE_MEMORY_HIGH_MB_RAW")"
AGENT_SCOPE_MEMORY_MAX_MB="$(normalize_mb_value "$AGENT_SCOPE_MEMORY_MAX_MB_RAW")"
AGENT_SCOPE_MEMORY_SWAP_MAX_MB="$(normalize_mb_value "$AGENT_SCOPE_MEMORY_SWAP_MAX_MB_RAW")"
SCOPE_UNIT=""

extract_resume_hint_from_stream() {
  if have_cmd rg; then
    rg -o 'claude --resume [0-9a-f-]{36}|codex resume [0-9a-f-]{36}'
  else
    grep -Eo 'claude --resume [0-9a-f-]{36}|codex resume [0-9a-f-]{36}'
  fi | tail -1 || true
}

extract_resume_id_from_hint() {
  local hint="$1"
  echo "$hint" | grep -Eo '[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}' | tail -1 || true
}

capture_resume_id_from_pane() {
  local timeout="${1:-120}"
  local i pane_text hint rid
  for ((i = 0; i < timeout; i++)); do
    pane_text=$(tmux capture-pane -t "$TMUX_PANE_TARGET" -p -S -200 2>/dev/null || true)
    hint=$(printf '%s\n' "$pane_text" | extract_resume_hint_from_stream)
    rid=$(extract_resume_id_from_hint "$hint")
    if [ -n "$rid" ]; then
      if ! capture_guard_matches; then
        return 1
      fi
      echo "$rid" > "$RESUME_FILE"
      echo "Captured resume-id from pane output: $rid"
      return 0
    fi
    sleep 1
  done
  return 1
}

capture_resume_id_from_claude_files() {
  local proj_dir newest sid
  proj_dir=$(claude_project_dir_for_path "$AGENT_PATH") || return 1
  [ -d "$proj_dir" ] || return 1
  newest=$(find "$proj_dir" -maxdepth 1 -name "*.jsonl" -type f -mmin -10 2>/dev/null | sort -r | head -1)
  [ -n "$newest" ] || return 1
  sid=$(basename "$newest" .jsonl)
  if echo "$sid" | grep -qE '^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$'; then
    if ! capture_guard_matches; then
      return 1
    fi
    echo "$sid" > "$RESUME_FILE"
    echo "Captured resume-id from Claude session files: $sid"
    return 0
  fi
  return 1
}

capture_resume_id_from_codex_files() {
  local baseline_file="${1:-}"
  local sessions_dir sid
  sessions_dir="$HOME/.codex/sessions"
  [ -d "$sessions_dir" ] || return 1
  sid=$(SESSIONS_DIR="$sessions_dir" BASELINE_FILE="$baseline_file" AGENT_PATH_EXPECTED="$AGENT_PATH" AGENT_NAME_EXPECTED="$NAME" python3 - <<'PY' 2>/dev/null || true
import os
import re
import json

sessions_dir = os.environ["SESSIONS_DIR"]
baseline_file = os.environ.get("BASELINE_FILE", "")
expected_cwd = os.environ.get("AGENT_PATH_EXPECTED", "")
expected_agent_name = os.environ.get("AGENT_NAME_EXPECTED", "").strip()
uuid_re = re.compile(r"[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}")

baseline = set()
if baseline_file and os.path.exists(baseline_file):
    with open(baseline_file) as f:
        baseline = {line.strip() for line in f if line.strip()}

def real(path: str) -> str:
    try:
        return os.path.realpath(path)
    except Exception:
        return path

expected_real = real(expected_cwd) if expected_cwd else ""

def session_matches_expected(path: str) -> bool:
    if not expected_real:
        return True
    try:
        with open(path, "r", encoding="utf-8") as f:
            first = f.readline().strip()
            prefix = "".join([first] + [f.readline() for _ in range(400)])
    except Exception:
        return False
    if not first:
        return False
    try:
        obj = json.loads(first)
    except Exception:
        return False
    payload = obj.get("payload") if isinstance(obj, dict) else None
    cwd = ""
    if isinstance(payload, dict):
        cwd = str(payload.get("cwd") or "").strip()
    if not cwd:
        return False
    if real(cwd) != expected_real:
        return False
    if expected_agent_name:
        marker = f"Your name is {expected_agent_name}."
        if marker not in prefix:
            return False
    return True

candidates = []
for root, _, files in os.walk(sessions_dir):
    for fn in files:
        if not fn.endswith(".jsonl"):
            continue
        path = os.path.join(root, fn)
        m = uuid_re.search(fn) or uuid_re.search(path)
        if not m:
            continue
        sid = m.group(0)
        if sid in baseline:
            continue
        if not session_matches_expected(path):
            continue
        try:
            mtime = os.path.getmtime(path)
        except OSError:
            continue
        candidates.append((mtime, sid))

if candidates:
    candidates.sort(reverse=True)
    print(candidates[0][1])
PY
)
  [ -n "$sid" ] || return 1
  if ! capture_guard_matches; then
    return 1
  fi
  echo "$sid" > "$RESUME_FILE"
  echo "Captured resume-id from Codex session files: $sid"
  return 0
}

snapshot_codex_session_ids() {
  local out_file="$1"
  local sessions_dir
  sessions_dir="$HOME/.codex/sessions"
  if [ ! -d "$sessions_dir" ]; then
    : > "$out_file"
    return 0
  fi
  SESSIONS_DIR="$sessions_dir" python3 - <<'PY' > "$out_file" 2>/dev/null || true
import os
import re

sessions_dir = os.environ["SESSIONS_DIR"]
uuid_re = re.compile(r"[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}")
seen = set()
for root, _, files in os.walk(sessions_dir):
    for fn in files:
        if not fn.endswith(".jsonl"):
            continue
        path = os.path.join(root, fn)
        m = uuid_re.search(fn) or uuid_re.search(path)
        if m:
            seen.add(m.group(0))
for sid in sorted(seen):
    print(sid)
PY
}

capture_resume_id_background() {
  local kind="$1"
  local baseline_file="${2:-}"
  (
    # If launcher command already failed back to shell, do not steal another session's resume-id.
    if [ "$kind" = "codex" ]; then
      sleep 2
      local pane_cmd
      pane_cmd=$(tmux display-message -p -t "$TMUX_PANE_TARGET" "#{pane_current_command}" 2>/dev/null || true)
      case "$pane_cmd" in
        codex|node) ;;
        bash|zsh|sh|fish|nu|'')
          [ -n "$baseline_file" ] && rm -f "$baseline_file" || true
          exit 0
          ;;
      esac
    fi
    if capture_resume_id_from_pane 150; then
      [ -n "$baseline_file" ] && rm -f "$baseline_file" || true
      exit 0
    fi
    if [ "$kind" = "claude" ]; then
      capture_resume_id_from_claude_files || true
    else
      capture_resume_id_from_codex_files "$baseline_file" || true
    fi
    [ -n "$baseline_file" ] && rm -f "$baseline_file" || true
  ) &
  disown
}

create_tmux_session() {
  local scope_unit=""
  if [ "$AGENT_SCOPE_ENABLE" = "1" ] && have_cmd systemd-run; then
    scope_unit="$(scope_unit_for_agent "$NAME")"
    local run_args=(--user --scope --unit "$scope_unit")
    if [ "$AGENT_SCOPE_MEMORY_HIGH_MB" -gt 0 ]; then
      run_args+=(--property "MemoryHigh=${AGENT_SCOPE_MEMORY_HIGH_MB}M")
    fi
    if [ "$AGENT_SCOPE_MEMORY_MAX_MB" -gt 0 ]; then
      run_args+=(--property "MemoryMax=${AGENT_SCOPE_MEMORY_MAX_MB}M")
    fi
    if [ "$AGENT_SCOPE_MEMORY_SWAP_MAX_MB" -gt 0 ]; then
      run_args+=(--property "MemorySwapMax=${AGENT_SCOPE_MEMORY_SWAP_MAX_MB}M")
    fi
    if systemd-run "${run_args[@]}" tmux new-session -d -s "$NAME" -c "$AGENT_PATH" >/dev/null 2>&1; then
      SCOPE_UNIT="$scope_unit"
      return 0
    fi
    echo "Warning: failed to launch tmux in systemd scope $scope_unit, falling back to plain tmux." >&2
  fi

  tmux new-session -d -s "$NAME" -c "$AGENT_PATH"
  SCOPE_UNIT=""
}

capture_guard_matches() {
  [ -n "${CAPTURE_GUARD_FILE:-}" ] || return 0
  [ -n "${CAPTURE_GUARD_TOKEN:-}" ] || return 0
  [ -f "$CAPTURE_GUARD_FILE" ] || return 1
  local token_now
  token_now="$(cat "$CAPTURE_GUARD_FILE" 2>/dev/null || true)"
  [ "$token_now" = "$CAPTURE_GUARD_TOKEN" ]
}

SESSION_ID="$SAVED_SESSION_ID"
if [ "$TYPE" = "claude" ]; then
  if [ "$FRESH" = true ]; then
    SESSION_ID=$(generate_uuid)
    mkdir -p "$AGENT_DATA"
    echo "$SESSION_ID" > "$RESUME_FILE"
  elif [ -f "$RESUME_FILE" ]; then
    SESSION_ID=$(cat "$RESUME_FILE" 2>/dev/null || echo "$SESSION_ID")
  elif is_valid_uuid "$SESSION_ID"; then
    echo "$SESSION_ID" > "$RESUME_FILE"
  fi
fi

if [ "$TYPE" = "claude" ] && [ "$FRESH" = false ]; then
  if [ ! -f "$RESUME_FILE" ]; then
    echo "Error: missing resume-id for claude agent '$NAME'." >&2
    echo "Manual check required: inspect archive tail and set resume-id explicitly." >&2
    echo "  tail -n 10 $AGENT_DATA/archive-*.txt" >&2
    echo "  echo '<session-id>' > $RESUME_FILE" >&2
    exit 1
  fi
  RID_CHECK=$(cat "$RESUME_FILE" 2>/dev/null || true)
  if ! is_valid_claude_session_id "$AGENT_PATH" "$RID_CHECK"; then
    if is_valid_uuid "$RID_CHECK" && [ "$RID_CHECK" = "$SESSION_ID" ]; then
      echo "Warning: local Claude session file not found yet; attempting resume with explicit session-id $RID_CHECK."
    else
      echo "Error: resume-id '$RID_CHECK' is not a valid local Claude session file." >&2
      echo "Manual check required: inspect archive tail and fix $RESUME_FILE." >&2
      exit 1
    fi
  fi
fi

if [ "$TYPE" = "codex" ] && [ "$FRESH" = false ] && [ ! -f "$RESUME_FILE" ]; then
  echo "Error: missing resume-id for codex agent '$NAME'." >&2
  echo "Manual check required: inspect archive tail and set $RESUME_FILE." >&2
  exit 1
fi
if [ "$TYPE" = "codex" ] && [ "$FRESH" = false ]; then
  RID_CHECK=$(cat "$RESUME_FILE" 2>/dev/null || true)
  if ! is_valid_uuid "$RID_CHECK"; then
    echo "Error: resume-id '$RID_CHECK' is not a valid UUID for codex agent '$NAME'." >&2
    echo "Manual check required: inspect archive tail and fix $RESUME_FILE." >&2
    exit 1
  fi
  if ! is_valid_codex_session_id_for_path "$AGENT_PATH" "$RID_CHECK" "$NAME"; then
    echo "Error: codex resume-id '$RID_CHECK' does not match path '$AGENT_PATH'." >&2
    echo "Refusing resume to avoid cross-agent context bleed." >&2
    echo "Fix options:" >&2
    echo "  1) Update $RESUME_FILE with the correct session id for this path." >&2
    echo "  2) Run: agent-up $NAME --fresh" >&2
    exit 1
  fi
fi

# ── Check existing session ───────────────────────────────────────────
if tmux has-session -t "$TMUX_TARGET" 2>/dev/null; then
  # Keep backend online mapping fresh even when session was started outside agent-up.
  register_backend_agent
  if [ "$ATTACH" = true ]; then
    exec tmux attach -t "$TMUX_TARGET"
  else
    echo "Session '$NAME' already exists. Refreshed backend mapping."
    echo "Attach with: tmux attach -t $NAME"
    exit 0
  fi
fi

# ── Save meta ─────────────────────────────────────────────────────────
mkdir -p "$AGENT_DATA"
mkdir -p "$TMP_RUNTIME_DIR"
CAPTURE_GUARD_FILE="$TMP_RUNTIME_DIR/resume-capture.guard"
CAPTURE_GUARD_TOKEN="$(date +%s)-$$-$RANDOM"
echo "$CAPTURE_GUARD_TOKEN" > "$CAPTURE_GUARD_FILE"

NOW=$(python3 -c "from datetime import datetime; print(datetime.now().astimezone().isoformat())" 2>/dev/null || date -Iseconds 2>/dev/null || date +%Y-%m-%dT%H:%M:%S)
SCOPE_UNIT_META=""
if [ "$AGENT_SCOPE_ENABLE" = "1" ] && have_cmd systemd-run; then
  SCOPE_UNIT_META="$(scope_unit_for_agent "$NAME")"
fi
if [ -f "$META_FILE" ]; then
  # Update lastUp
  META_FILE="$META_FILE" AGENT_PATH="$AGENT_PATH" TYPE="$TYPE" MODEL="$MODEL" EXTRA_ARGS="$EXTRA_ARGS" SESSION_ID="$SESSION_ID" NOW="$NOW" \
    AGENT_SCOPE_ENABLE="$AGENT_SCOPE_ENABLE" SCOPE_UNIT_META="$SCOPE_UNIT_META" \
    AGENT_SCOPE_MEMORY_HIGH_MB="$AGENT_SCOPE_MEMORY_HIGH_MB" AGENT_SCOPE_MEMORY_MAX_MB="$AGENT_SCOPE_MEMORY_MAX_MB" AGENT_SCOPE_MEMORY_SWAP_MAX_MB="$AGENT_SCOPE_MEMORY_SWAP_MAX_MB" \
    python3 - <<'PY'
import json
import os

meta_file = os.environ["META_FILE"]
with open(meta_file) as f:
    data = json.load(f)
data["path"] = os.environ["AGENT_PATH"]
data["type"] = os.environ["TYPE"]
data["model"] = os.environ["MODEL"]
data["extraArgs"] = os.environ["EXTRA_ARGS"]
data["sessionId"] = os.environ["SESSION_ID"]
data["lastUp"] = os.environ["NOW"]
data["scopeEnabled"] = os.environ.get("AGENT_SCOPE_ENABLE", "0") == "1"
data["scopeUnit"] = os.environ.get("SCOPE_UNIT_META", "")
data["scopeMemoryHighMB"] = int(os.environ.get("AGENT_SCOPE_MEMORY_HIGH_MB", "0") or 0)
data["scopeMemoryMaxMB"] = int(os.environ.get("AGENT_SCOPE_MEMORY_MAX_MB", "0") or 0)
data["scopeMemorySwapMaxMB"] = int(os.environ.get("AGENT_SCOPE_MEMORY_SWAP_MAX_MB", "0") or 0)
with open(meta_file, "w") as f:
    json.dump(data, f, indent=2)
PY
else
  # Create new meta
  META_FILE="$META_FILE" NAME="$NAME" AGENT_PATH="$AGENT_PATH" TYPE="$TYPE" MODEL="$MODEL" EXTRA_ARGS="$EXTRA_ARGS" SESSION_ID="$SESSION_ID" NOW="$NOW" \
    AGENT_SCOPE_ENABLE="$AGENT_SCOPE_ENABLE" SCOPE_UNIT_META="$SCOPE_UNIT_META" \
    AGENT_SCOPE_MEMORY_HIGH_MB="$AGENT_SCOPE_MEMORY_HIGH_MB" AGENT_SCOPE_MEMORY_MAX_MB="$AGENT_SCOPE_MEMORY_MAX_MB" AGENT_SCOPE_MEMORY_SWAP_MAX_MB="$AGENT_SCOPE_MEMORY_SWAP_MAX_MB" \
    python3 - <<'PY'
import json
import os

data = {
    "name": os.environ["NAME"],
    "path": os.environ["AGENT_PATH"],
    "type": os.environ["TYPE"],
    "model": os.environ["MODEL"],
    "extraArgs": os.environ["EXTRA_ARGS"],
    "sessionId": os.environ["SESSION_ID"],
    "scopeEnabled": os.environ.get("AGENT_SCOPE_ENABLE", "0") == "1",
    "scopeUnit": os.environ.get("SCOPE_UNIT_META", ""),
    "scopeMemoryHighMB": int(os.environ.get("AGENT_SCOPE_MEMORY_HIGH_MB", "0") or 0),
    "scopeMemoryMaxMB": int(os.environ.get("AGENT_SCOPE_MEMORY_MAX_MB", "0") or 0),
    "scopeMemorySwapMaxMB": int(os.environ.get("AGENT_SCOPE_MEMORY_SWAP_MAX_MB", "0") or 0),
    "createdAt": os.environ["NOW"],
    "lastUp": os.environ["NOW"],
}
with open(os.environ["META_FILE"], "w") as f:
    json.dump(data, f, indent=2)
PY
fi

# ── Create tmux session ──────────────────────────────────────────────
echo "Creating tmux session '$NAME' in $AGENT_PATH..."
create_tmux_session
if [ -n "$SCOPE_UNIT" ]; then
  echo "  Scope:  $SCOPE_UNIT"
fi
register_backend_agent

# ── Build init prompt for fresh starts ────────────────────────────────
INIT_PROMPT="Your name is ${NAME}. You have an MCP tool server called 'agent-chat' for communicating with other agents and humans. Key tools: check_inbox() to read messages, send_message(to, summary, full) to DM, post(group, summary, full, mentions) for group messages, whoami() to see your identity and available agents/groups. Check your inbox now to see if there are any messages for you."
CLAUDE_MODE_GUARD="Critical runtime rule: do not enter Plan mode or Select mode in this multi-agent tmux environment, because interactive mode switching cannot be completed. Stay in default mode and continue execution directly. Save this rule in memory and follow it for the whole session."

# ── Launch AI ─────────────────────────────────────────────────────────
if [ "$TYPE" = "claude" ]; then
  INIT_PROMPT="$INIT_PROMPT $CLAUDE_MODE_GUARD"
  CLAUDE_FLAGS="--dangerously-skip-permissions"
  [ -n "$MODEL" ] && CLAUDE_FLAGS="$CLAUDE_FLAGS --model $MODEL"
  [ -n "$EXTRA_ARGS" ] && CLAUDE_FLAGS="$CLAUDE_FLAGS $EXTRA_ARGS"
  if [ "$FRESH" = false ] && RID=$(cat "$RESUME_FILE"); then
    echo "Resuming claude session: $RID"
    tmux send-keys -t "$TMUX_PANE_TARGET" "AGENT_NAME=$NAME claude --resume $RID $CLAUDE_FLAGS" Enter
  else
    echo "Starting new claude session..."
    # Write init prompt to temp file to avoid shell escaping issues
    INIT_FILE=$(mktemp "$TMP_RUNTIME_DIR/init.XXXXXX")
    echo "$INIT_PROMPT" > "$INIT_FILE"
    tmux send-keys -t "$TMUX_PANE_TARGET" "AGENT_NAME=$NAME claude --session-id $SESSION_ID $CLAUDE_FLAGS \"\$(cat \"$INIT_FILE\")\" && rm -f \"$INIT_FILE\"" Enter
    ( sleep 300; rm -f "$INIT_FILE" >/dev/null 2>&1 || true ) &
    capture_resume_id_background "claude"
  fi

elif [ "$TYPE" = "codex" ]; then
  CODEX_FLAGS="--yolo"
  [ -n "$MODEL" ] && CODEX_FLAGS="$CODEX_FLAGS --model $MODEL"
  [ -n "$EXTRA_ARGS" ] && CODEX_FLAGS="$CODEX_FLAGS $EXTRA_ARGS"
  if [ "$FRESH" = false ] && [ -f "$RESUME_FILE" ]; then
    RID=$(cat "$RESUME_FILE")
    echo "Resuming codex session: $RID"
    tmux send-keys -t "$TMUX_PANE_TARGET" "AGENT_NAME=$NAME codex resume $RID $CODEX_FLAGS" Enter
  else
    CODEX_BASELINE_FILE=$(mktemp "$TMP_RUNTIME_DIR/codex-baseline.XXXXXX")
    snapshot_codex_session_ids "$CODEX_BASELINE_FILE"
    echo "Starting new codex session..."
    tmux send-keys -t "$TMUX_PANE_TARGET" "AGENT_NAME=$NAME codex $CODEX_FLAGS -C $AGENT_PATH" Enter
    # Send init prompt after codex starts to create a session deterministically.
    sleep 5
    tmux send-keys -t "$TMUX_PANE_TARGET" -l "$INIT_PROMPT"
    tmux send-keys -t "$TMUX_PANE_TARGET" Enter
    capture_resume_id_background "codex" "$CODEX_BASELINE_FILE"
  fi
fi

# Post agent-up lifecycle event
post_lifecycle "Agent '$NAME' started ($TYPE) on ${SERVER_ID:-local}" "Agent '$NAME' ($TYPE) started in $AGENT_PATH on ${SERVER_ID:-local}"

# ── Done ──────────────────────────────────────────────────────────────
echo ""
echo "Agent '$NAME' ($TYPE) launched in $AGENT_PATH"

if [ "$ATTACH" = true ]; then
  exec tmux attach -t "$TMUX_TARGET"
else
  echo "  Attach: tmux attach -t $NAME"
  echo "  Meta:   $META_FILE"
fi
