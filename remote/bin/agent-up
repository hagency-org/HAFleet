#!/bin/bash
# agent-up — Quick agent launcher with resume support
#
# Usage:
#   agent-up <name> [path] [claude|codex] [--fresh] [--attach] [--model <model>] [--extra-args "<args>"]
#
# If path is omitted, reads from saved meta.json (previous agent-down).
# If --fresh is not set, resume-id is required for strict resume (no silent fallback).
#
# Examples:
#   agent-up umiki-worker ~/laplace/umiki claude                           # first time
#   agent-up umiki-worker                                                   # resume from meta
#   agent-up umiki-worker --fresh                                           # new session, same path
#   agent-up ddnsserer ~/cloudflare codex                                   # codex agent
#   agent-up news ~/laplace/news claude --model claude-opus-4-1             # fixed model
#   agent-up coder ~/laplace/repo codex --model gpt-5.3-codex-spark         # codex model
#   agent-up ops ~/laplace/ops codex --extra-args "--approval-mode never"   # custom startup args

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
BASE_DIR="$(dirname "$SCRIPT_DIR")"
DATA_DIR="$BASE_DIR/data/agents"
BACKEND_URL="${AGENT_CHAT_API:-http://127.0.0.1:8090}"
SERVER_ID="${AGENT_CHAT_SERVER:-}"

# ── Parse args ────────────────────────────────────────────────────────
if [ $# -lt 1 ]; then
  echo "Usage: agent-up <name> [path] [claude|codex] [--fresh] [--attach] [--model <model>] [--extra-args \"<args>\"]"
  echo ""
  echo "  name     tmux session name / agent name"
  echo "  path     working directory (optional if previously saved)"
  echo "  type     claude (default) or codex"
  echo "  --fresh  ignore saved resume ID, start a new session"
  echo "  --attach attach to the session after creating it"
  echo "  --model  model name passed to claude/codex at startup"
  echo "  --extra-args additional raw startup args passed to claude/codex"
  exit 1
fi

NAME="$1"
shift

FRESH=false
ATTACH=false
AGENT_PATH=""
TYPE=""
MODEL=""
EXTRA_ARGS=""

while [ $# -gt 0 ]; do
  case "$1" in
    --fresh)
      FRESH=true
      shift
      ;;
    --attach)
      ATTACH=true
      shift
      ;;
    --model)
      if [ $# -lt 2 ]; then
        echo "Error: --model requires a value" >&2
        exit 1
      fi
      MODEL="$2"
      shift 2
      ;;
    --extra-args)
      if [ $# -lt 2 ]; then
        echo "Error: --extra-args requires a value" >&2
        exit 1
      fi
      EXTRA_ARGS="$2"
      shift 2
      ;;
    claude|codex)
      TYPE="$1"
      shift
      ;;
    *)
      if [ -z "$AGENT_PATH" ]; then
        AGENT_PATH="$1"
        shift
      else
        echo "Error: unrecognized argument '$1'" >&2
        exit 1
      fi
      ;;
  esac
done

# ── Load saved meta ──────────────────────────────────────────────────
AGENT_DATA="$DATA_DIR/$NAME"
META_FILE="$AGENT_DATA/meta.json"
RESUME_FILE="$AGENT_DATA/resume-id"

SAVED_PATH=""
SAVED_TYPE=""
SAVED_MODEL=""
SAVED_EXTRA_ARGS=""
if [ -f "$META_FILE" ]; then
  SAVED_PATH=$(python3 -c "import json; d=json.load(open('$META_FILE')); print(d.get('path',''))" 2>/dev/null || true)
  SAVED_TYPE=$(python3 -c "import json; d=json.load(open('$META_FILE')); print(d.get('type',''))" 2>/dev/null || true)
  SAVED_MODEL=$(python3 -c "import json; d=json.load(open('$META_FILE')); print(d.get('model',''))" 2>/dev/null || true)
  SAVED_EXTRA_ARGS=$(python3 -c "import json; d=json.load(open('$META_FILE')); print(d.get('extraArgs',''))" 2>/dev/null || true)
fi

# Apply defaults from meta
[ -z "$AGENT_PATH" ] && AGENT_PATH="$SAVED_PATH"
[ -z "$TYPE" ] && TYPE="${SAVED_TYPE:-claude}"
[ -z "$MODEL" ] && MODEL="$SAVED_MODEL"
[ -z "$EXTRA_ARGS" ] && EXTRA_ARGS="$SAVED_EXTRA_ARGS"

# Validate
if [ -z "$AGENT_PATH" ]; then
  echo "Error: no path specified and no saved meta for '$NAME'" >&2
  echo "Usage: agent-up <name> <path> [claude|codex]" >&2
  exit 1
fi

AGENT_PATH="$(realpath "$AGENT_PATH" 2>/dev/null || echo "$AGENT_PATH")"

if [ ! -d "$AGENT_PATH" ]; then
  echo "Error: path '$AGENT_PATH' does not exist or is not a directory" >&2
  exit 1
fi

if [ "$TYPE" != "claude" ] && [ "$TYPE" != "codex" ]; then
  echo "Error: type must be 'claude' or 'codex', got '$TYPE'" >&2
  exit 1
fi

claude_project_dir_for_path() {
  local p="$1"
  [ -n "$p" ] || return 1
  echo "$HOME/.claude/projects/${p//\//-}"
}

is_valid_claude_session_id() {
  local p="$1" sid="$2"
  local d
  [ -n "$sid" ] || return 1
  d=$(claude_project_dir_for_path "$p") || return 1
  [ -f "$d/$sid.jsonl" ]
}

if [ "$TYPE" = "claude" ] && [ "$FRESH" = false ]; then
  if [ ! -f "$RESUME_FILE" ]; then
    echo "Error: missing resume-id for claude agent '$NAME'." >&2
    echo "Manual check required: inspect archive tail and set resume-id explicitly." >&2
    echo "  tail -n 10 $AGENT_DATA/archive-*.txt" >&2
    echo "  echo '<session-id>' > $RESUME_FILE" >&2
    exit 1
  fi
  RID_CHECK=$(cat "$RESUME_FILE" 2>/dev/null || true)
  if ! is_valid_claude_session_id "$AGENT_PATH" "$RID_CHECK"; then
    echo "Error: resume-id '$RID_CHECK' is not a valid local Claude session file." >&2
    echo "Manual check required: inspect archive tail and fix $RESUME_FILE." >&2
    exit 1
  fi
fi

if [ "$TYPE" = "codex" ] && [ "$FRESH" = false ] && [ ! -f "$RESUME_FILE" ]; then
  echo "Error: missing resume-id for codex agent '$NAME'." >&2
  echo "Manual check required: inspect archive tail and set $RESUME_FILE." >&2
  exit 1
fi

# ── Check existing session ───────────────────────────────────────────
if tmux has-session -t "$NAME" 2>/dev/null; then
  if [ "$ATTACH" = true ]; then
    exec tmux attach -t "$NAME"
  else
    echo "Session '$NAME' already exists. Attach with: tmux attach -t $NAME"
    exit 0
  fi
fi

# ── Save meta ─────────────────────────────────────────────────────────
mkdir -p "$AGENT_DATA"

NOW=$(date -Iseconds)
if [ -f "$META_FILE" ]; then
  # Update lastUp
  python3 -c "
import json
d = json.load(open('$META_FILE'))
d['path'] = '$AGENT_PATH'
d['type'] = '$TYPE'
d['model'] = '$MODEL'
d['extraArgs'] = '$EXTRA_ARGS'
d['lastUp'] = '$NOW'
json.dump(d, open('$META_FILE', 'w'), indent=2)
"
else
  # Create new meta
  python3 -c "
import json
d = {'name': '$NAME', 'path': '$AGENT_PATH', 'type': '$TYPE', 'model': '$MODEL', 'extraArgs': '$EXTRA_ARGS', 'createdAt': '$NOW', 'lastUp': '$NOW'}
json.dump(d, open('$META_FILE', 'w'), indent=2)
"
fi

# ── Create tmux session ──────────────────────────────────────────────
echo "Creating tmux session '$NAME' in $AGENT_PATH..."
tmux new-session -d -s "$NAME" -c "$AGENT_PATH"

# ── Launch AI ─────────────────────────────────────────────────────────
if [ "$TYPE" = "claude" ]; then
  CLAUDE_FLAGS="--dangerously-skip-permissions"
  [ -n "$MODEL" ] && CLAUDE_FLAGS="$CLAUDE_FLAGS --model $MODEL"
  [ -n "$EXTRA_ARGS" ] && CLAUDE_FLAGS="$CLAUDE_FLAGS $EXTRA_ARGS"
  if [ "$FRESH" = false ] && RID=$(cat "$RESUME_FILE"); then
    echo "Resuming claude session: $RID"
    tmux send-keys -t "$NAME" "claude --resume $RID $CLAUDE_FLAGS" Enter
  else
    echo "Starting new claude session..."
    tmux send-keys -t "$NAME" "claude $CLAUDE_FLAGS" Enter
  fi

elif [ "$TYPE" = "codex" ]; then
  CODEX_FLAGS="--yolo"
  [ -n "$MODEL" ] && CODEX_FLAGS="$CODEX_FLAGS --model $MODEL"
  [ -n "$EXTRA_ARGS" ] && CODEX_FLAGS="$CODEX_FLAGS $EXTRA_ARGS"
  if [ "$FRESH" = false ] && [ -f "$RESUME_FILE" ]; then
    RID=$(cat "$RESUME_FILE")
    echo "Resuming codex session: $RID"
    tmux send-keys -t "$NAME" "codex resume $RID $CODEX_FLAGS" Enter
  else
    echo "Starting new codex session..."
    tmux send-keys -t "$NAME" "codex $CODEX_FLAGS -C $AGENT_PATH" Enter
    # Send init prompt after codex starts to trigger session file creation
    # Then detect session ID in background
    (
      sleep 5
      tmux send-keys -t "$NAME" "Hi" Enter
      sleep 0.1
      tmux send-keys -t "$NAME" Enter
      sleep 15
      SESSIONS_DIR="$HOME/.codex/sessions"
      if [ -d "$SESSIONS_DIR" ]; then
        NEWEST=$(find "$SESSIONS_DIR" -name "*.jsonl" -newer "$META_FILE" -type f 2>/dev/null | sort -r | head -1)
        if [ -n "$NEWEST" ]; then
          UUID=$(echo "$NEWEST" | grep -oP '[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}')
          if [ -n "$UUID" ]; then
            echo "$UUID" > "$RESUME_FILE"
          fi
        fi
      fi
    ) &
    disown
  fi
fi

# ── Auto-register with backend ───────────────────────────────────────
REG_CHECK=$(curl --noproxy '*' -s "$BACKEND_URL/api/agents/$NAME" 2>/dev/null || echo '{"error":"unreachable"}')
if echo "$REG_CHECK" | grep -q '"error"'; then
  echo "Registering agent '$NAME' with backend..."
  REG_BODY="{\"name\":\"$NAME\",\"tmux\":\"$NAME:0.0\",\"type\":\"agent\"}"
  if [ -n "$SERVER_ID" ]; then
    REG_BODY="{\"name\":\"$NAME\",\"tmux\":\"$NAME:0.0\",\"type\":\"agent\",\"server\":\"$SERVER_ID\"}"
  fi
  curl --noproxy '*' -s -X POST "$BACKEND_URL/api/agents" \
    -H 'Content-Type: application/json' \
    -d "$REG_BODY" \
    >/dev/null 2>&1 || echo "  Warning: backend registration failed (backend may be down)"
else
  echo "Agent '$NAME' already registered."
fi

# ── Done ──────────────────────────────────────────────────────────────
echo ""
echo "Agent '$NAME' ($TYPE) launched in $AGENT_PATH"

if [ "$ATTACH" = true ]; then
  exec tmux attach -t "$NAME"
else
  echo "  Attach: tmux attach -t $NAME"
  echo "  Meta:   $META_FILE"
fi
