#!/bin/bash
# agent-down — Gracefully stop an agent with archive + resume ID capture
#
# Usage:
#   agent-down <name> [--kill] [--timeout <seconds>]
#
# Default behavior:
#   - refuse to stop agent when backend reports it as active
#   - claude: send /exit, wait up to 30s for process to return to shell
#   - codex:  send Ctrl+C, wait up to 8s for process to return to shell
#   - archive pane, show tail, try to extract resume hint
#   - claude without resume hint is treated as error (session is kept alive)
#
# --kill behavior:
#   - archive first, then kill tmux session immediately
#   - still refuses if agent is currently active

set -euo pipefail

_resolve_script_dir() {
  local src="$0"
  while [ -L "$src" ]; do
    local dir
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
  done
  cd -P "$(dirname "$src")" && pwd
}
SCRIPT_DIR="$(_resolve_script_dir)"
BASE_DIR="$(dirname "$SCRIPT_DIR")"
DATA_DIR="$BASE_DIR/data/agents"

# Load .env if present
ENV_FILE="$BASE_DIR/.env"
if [ -f "$ENV_FILE" ]; then
  set -a
  source "$ENV_FILE"
  set +a
fi

BACKEND_URL="${AGENT_CHAT_API:-http://127.0.0.1:8090}"
API_TOKEN="${API_TOKEN:-}"
SERVER_ID="${AGENT_CHAT_SERVER:-}"
AUTH_HEADER=""
[ -n "$API_TOKEN" ] && AUTH_HEADER="Authorization: Bearer $API_TOKEN"

have_cmd() {
  command -v "$1" >/dev/null 2>&1
}

api_curl() {
  if [ -n "$AUTH_HEADER" ]; then
    curl --noproxy '*' -s -H "$AUTH_HEADER" "$@"
  else
    curl --noproxy '*' -s "$@"
  fi
}

url_encode() {
  python3 - "$1" <<'PY'
import sys
import urllib.parse
print(urllib.parse.quote(sys.argv[1], safe=""))
PY
}

resolve_agent_name_backend() {
  local raw="$1"
  local encoded payload
  encoded="$(url_encode "$raw")"
  payload="$(api_curl "$BACKEND_URL/api/agents/$encoded" 2>/dev/null || true)"
  [ -n "$payload" ] || return 0
  RAW_NAME="$raw" PAYLOAD="$payload" python3 - <<'PY' 2>/dev/null || true
import json
import os

raw = os.environ.get("RAW_NAME", "").strip()
payload = os.environ.get("PAYLOAD", "")
if not raw or not payload:
    raise SystemExit(0)
try:
    obj = json.loads(payload)
except Exception:
    raise SystemExit(0)
if isinstance(obj, dict) and not obj.get("error"):
    name = str(obj.get("name") or "").strip()
    if name and name.lower() == raw.lower():
        print(name)
PY
}

resolve_agent_name_tmux() {
  local raw="$1"
  local sessions
  sessions="$(tmux list-sessions -F '#{session_name}' 2>/dev/null || true)"
  [ -n "$sessions" ] || return 0
  RAW_NAME="$raw" TMUX_SESSIONS="$sessions" python3 - <<'PY' 2>/dev/null || true
import os

raw = os.environ.get("RAW_NAME", "").strip()
sessions = os.environ.get("TMUX_SESSIONS", "")
if not raw or not sessions:
    raise SystemExit(0)
matches = []
for line in sessions.splitlines():
    name = line.strip()
    if name and name.lower() == raw.lower():
        matches.append(name)
seen = []
for name in matches:
    if name not in seen:
        seen.append(name)
for name in seen:
    print(name)
PY
}

resolve_agent_name_data_dir() {
  local raw="$1"
  local dirs=""
  if [ -d "$DATA_DIR" ]; then
    local d
    for d in "$DATA_DIR"/*; do
      [ -d "$d" ] || continue
      dirs="${dirs}$(basename "$d")"$'\n'
    done
  fi
  [ -n "$dirs" ] || return 0
  RAW_NAME="$raw" AGENT_DIR_NAMES="$dirs" python3 - <<'PY' 2>/dev/null || true
import os

raw = os.environ.get("RAW_NAME", "").strip()
dirs = os.environ.get("AGENT_DIR_NAMES", "")
if not raw or not dirs:
    raise SystemExit(0)
matches = []
for line in dirs.splitlines():
    name = line.strip()
    if name and name.lower() == raw.lower():
        matches.append(name)
seen = []
for name in matches:
    if name not in seen:
        seen.append(name)
for name in seen:
    print(name)
PY
}

resolve_agent_name_casefold() {
  local raw="$1"
  local backend_name tmux_names data_names candidates resolved
  backend_name="$(resolve_agent_name_backend "$raw")"
  tmux_names="$(resolve_agent_name_tmux "$raw")"
  data_names="$(resolve_agent_name_data_dir "$raw")"

  candidates=""
  [ -n "$backend_name" ] && candidates="${candidates}${backend_name}"$'\n'
  [ -n "$tmux_names" ] && candidates="${candidates}${tmux_names}"$'\n'
  [ -n "$data_names" ] && candidates="${candidates}${data_names}"$'\n'

  resolved="$(RAW_NAME="$raw" CANDIDATES="$candidates" python3 - <<'PY'
import os
import sys

raw = os.environ.get("RAW_NAME", "").strip()
candidates = os.environ.get("CANDIDATES", "")
if not raw:
    print("")
    raise SystemExit(0)

seen = []
for line in candidates.splitlines():
    name = line.strip()
    if not name:
        continue
    if name.lower() != raw.lower():
        continue
    if name not in seen:
        seen.append(name)

if len(seen) <= 1:
    print(seen[0] if seen else raw)
    raise SystemExit(0)

print(f"conflict:{','.join(seen)}")
raise SystemExit(3)
PY
)"
  if [[ "$resolved" == conflict:* ]]; then
    echo "Error: case-conflicting agent names detected for '$raw': ${resolved#conflict:}" >&2
    echo "Refusing to continue. Keep only one canonical case variant." >&2
    exit 1
  fi
  echo "$resolved"
}

post_lifecycle() {
  local event_summary="$1"
  local summary_json
  summary_json=$(EVENT_SUMMARY="$event_summary" python3 - <<'PY'
import json
import os
print(json.dumps(os.environ["EVENT_SUMMARY"]))
PY
)
  api_curl -X POST "$BACKEND_URL/api/messages" \
    -H 'Content-Type: application/json' \
    -d "{\"from\":\"system\",\"group\":\"info\",\"type\":\"inform\",\"summary\":${summary_json},\"full\":\"\",\"mentions\":[]}" \
    >/dev/null 2>&1 || true
}

mark_backend_offline() {
  local reason="${1:-agent-down}"
  local payload
payload=$(REASON="$reason" python3 - <<'PY'
import json
import os
print(json.dumps({"reason": os.environ["REASON"], "clearTmux": True, "manualDown": True}))
PY
)
  if api_curl -X POST "$BACKEND_URL/api/agents/$AGENT_PATH_ESCAPED/offline" \
    -H 'Content-Type: application/json' \
    -d "$payload" >/dev/null 2>&1; then
    echo "Marked '$NAME' offline in backend."
  else
    echo "Warning: failed to mark '$NAME' offline in backend." >&2
  fi
}

ensure_agent_not_active() {
  local payload status
  payload="$(api_curl "$BACKEND_URL/api/agents/$AGENT_PATH_ESCAPED" 2>/dev/null || true)"
  if [ -z "$payload" ]; then
    echo "Error: unable to verify active status for '$NAME' (backend unavailable)." >&2
    echo "Refusing to stop agent to avoid interrupting active work." >&2
    exit 1
  fi

  status="$(NAME="$NAME" PAYLOAD="$payload" python3 - <<'PY'
import json
import os

name = os.environ.get("NAME", "").strip()
payload = os.environ.get("PAYLOAD", "")
try:
    data = json.loads(payload)
except Exception:
    print("error:invalid-json")
    raise SystemExit(0)

if not isinstance(data, dict):
    print("error:invalid-payload")
    raise SystemExit(0)

if data.get("error"):
    print(f"error:{data.get('error')}")
    raise SystemExit(0)

active = data.get("activeNow") is True
online = data.get("online") is True
active_dur = int(data.get("activeDurationSec") or 0)
idle_dur = int(data.get("idleDurationSec") or 0)

if active:
    print(f"active:{name}:online={int(online)}:activeDurationSec={active_dur}:idleDurationSec={idle_dur}")
else:
    print(f"inactive:{name}:online={int(online)}:activeDurationSec={active_dur}:idleDurationSec={idle_dur}")
PY
)"

  case "$status" in
    active:*)
      echo "Error: agent '$NAME' is currently active." >&2
      echo "Refusing to stop active agent." >&2
      echo "Details: ${status#active:}" >&2
      exit 1
      ;;
    inactive:*)
      echo "Verified '$NAME' is not active (${status#inactive:})."
      ;;
    error:*)
      echo "Error: unable to verify active status for '$NAME' (${status#error:})." >&2
      echo "Refusing to stop agent to avoid interrupting active work." >&2
      exit 1
      ;;
    *)
      echo "Error: unexpected active-status response for '$NAME': $status" >&2
      echo "Refusing to stop agent to avoid interrupting active work." >&2
      exit 1
      ;;
  esac
}

if [ $# -lt 1 ]; then
  echo "Usage: agent-down <name> [--kill] [--timeout <seconds>]"
  exit 1
fi

RAW_NAME="$1"
NAME="$(resolve_agent_name_casefold "$RAW_NAME")"
shift || true
if [ "$NAME" != "$RAW_NAME" ]; then
  echo "Resolved agent name '$RAW_NAME' -> '$NAME'"
fi
TMUX_TARGET="=${NAME}"
TMUX_PANE_TARGET="=${NAME}:0.0"
AGENT_PATH_ESCAPED=$(NAME="$NAME" python3 - <<'PY'
import os
import urllib.parse
print(urllib.parse.quote(os.environ["NAME"], safe=""))
PY
)

FORCE=false
TIMEOUT=""
while [ $# -gt 0 ]; do
  case "$1" in
    --kill)
      FORCE=true
      shift
      ;;
    --timeout)
      if [ $# -lt 2 ]; then
        echo "Error: --timeout requires a value" >&2
        exit 1
      fi
      TIMEOUT="$2"
      shift 2
      ;;
    *)
      echo "Error: unrecognized argument '$1'" >&2
      echo "Usage: agent-down <name> [--kill] [--timeout <seconds>]" >&2
      exit 1
      ;;
  esac
done

if ! tmux has-session -t "$TMUX_TARGET" 2>/dev/null; then
  echo "Session '$NAME' does not exist."
  mark_backend_offline "session-missing"
  exit 0
fi

AGENT_DATA="$DATA_DIR/$NAME"
mkdir -p "$AGENT_DATA"

TIMESTAMP=$(date +%Y%m%d-%H%M%S)
ARCHIVE_FILE="$AGENT_DATA/archive-$TIMESTAMP.txt"
RESUME_FILE="$AGENT_DATA/resume-id"
META_FILE="$AGENT_DATA/meta.json"

ensure_agent_not_active

# Detect agent type from meta.json or fallback to process detection
AGENT_TYPE=""
if [ -f "$META_FILE" ]; then
  AGENT_TYPE=$(python3 -c "import json; print(json.load(open('$META_FILE')).get('type',''))" 2>/dev/null || true)
fi
if [ -z "$AGENT_TYPE" ]; then
  PANE_CMD=$(tmux list-panes -t "$TMUX_PANE_TARGET" -F "#{pane_current_command}" 2>/dev/null | head -1)
  case "$PANE_CMD" in
    *codex*|node) AGENT_TYPE="codex" ;;
    *claude*) AGENT_TYPE="claude" ;;
    *)
      if tmux capture-pane -t "$TMUX_PANE_TARGET" -p -S -120 2>/dev/null | if have_cmd rg; then rg -q 'OpenAI Codex|codex resume'; else grep -Eq 'OpenAI Codex|codex resume'; fi; then
        AGENT_TYPE="codex"
      else
        AGENT_TYPE="claude"
      fi
      ;;
  esac
fi

if [ -z "$TIMEOUT" ]; then
  if [ "$AGENT_TYPE" = "codex" ]; then
    TIMEOUT=8
  else
    TIMEOUT=30
  fi
fi

update_meta_last_down() {
  if [ -f "$META_FILE" ]; then
    NOW=$(python3 -c "from datetime import datetime; print(datetime.now().astimezone().isoformat())" 2>/dev/null || date -Iseconds 2>/dev/null || date +%Y-%m-%dT%H:%M:%S)
    META_FILE="$META_FILE" NOW="$NOW" python3 - <<'PY' 2>/dev/null || true
import json
import os

meta_file = os.environ["META_FILE"]
with open(meta_file) as f:
    data = json.load(f)
data["lastDown"] = os.environ["NOW"]
with open(meta_file, "w") as f:
    json.dump(data, f, indent=2)
PY
  fi
}

capture_archive() {
  echo "Archiving pane scrollback..."
  tmux capture-pane -t "$TMUX_PANE_TARGET" -p -S - > "$ARCHIVE_FILE" 2>/dev/null || true
  LINES=$(wc -l < "$ARCHIVE_FILE" 2>/dev/null || echo 0)
  echo "  Saved $LINES lines → $ARCHIVE_FILE"
}

extract_resume_hint() {
  if [ ! -f "$ARCHIVE_FILE" ]; then
    return 1
  fi
  if have_cmd rg; then
    rg -o 'claude --resume [0-9a-f-]{36}|codex resume [0-9a-f-]{36}' "$ARCHIVE_FILE" | tail -1 || true
  else
    grep -Eo 'claude --resume [0-9a-f-]{36}|codex resume [0-9a-f-]{36}' "$ARCHIVE_FILE" | tail -1 || true
  fi
}

show_archive_tail_and_hint() {
  echo "  Archive tail (manual check):"
  tail -n 10 "$ARCHIVE_FILE" | sed 's/^/    /'

  RESUME_HINT=$(extract_resume_hint)
  if [ -n "$RESUME_HINT" ]; then
    RESUME_ID=$(echo "$RESUME_HINT" | grep -oE '[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}' || true)
    echo "  Resume hint: $RESUME_HINT"
    if [ -n "$RESUME_ID" ]; then
      echo "$RESUME_ID" > "$RESUME_FILE"
      echo "  Updated: $RESUME_FILE"
    fi
  else
    echo "  No explicit resume command found."
  fi
}

kill_session() {
  echo "Killing tmux session '$NAME'..."
  tmux kill-session -t "$TMUX_TARGET" 2>/dev/null || true
  sleep 0.2
  if tmux has-session -t "$TMUX_TARGET" 2>/dev/null; then
    echo "Error: tmux session '$NAME' is still alive after kill attempt." >&2
    return 1
  fi
}

send_exit() {
  if [ "$AGENT_TYPE" = "codex" ]; then
    echo "Sending Ctrl+C to codex '$NAME'..."
    tmux send-keys -t "$TMUX_PANE_TARGET" C-c
    sleep 1
    pane_cmd=$(tmux display-message -p -t "$TMUX_PANE_TARGET" "#{pane_current_command}" 2>/dev/null || true)
    case "$pane_cmd" in
      bash|zsh|sh|fish|nu) ;;
      *)
        echo "Codex still active after first Ctrl+C; sending second Ctrl+C..."
        tmux send-keys -t "$TMUX_PANE_TARGET" C-c
        ;;
    esac
  else
    echo "Sending claude exit sequence (/exit + Enter + Ctrl+C x3) to '$NAME'..."
    tmux send-keys -t "$TMUX_PANE_TARGET" "/exit"
    sleep 0.1
    tmux send-keys -t "$TMUX_PANE_TARGET" C-m
    sleep 0.1
    tmux send-keys -t "$TMUX_PANE_TARGET" C-c
    sleep 0.1
    tmux send-keys -t "$TMUX_PANE_TARGET" C-c
    sleep 0.1
    tmux send-keys -t "$TMUX_PANE_TARGET" C-c
  fi
}

wait_for_exit_to_shell() {
  local i pane_cmd
  for ((i = 0; i < TIMEOUT; i++)); do
    if ! tmux has-session -t "$TMUX_TARGET" 2>/dev/null; then
      return 0
    fi
    pane_cmd=$(tmux display-message -p -t "$TMUX_PANE_TARGET" "#{pane_current_command}" 2>/dev/null || true)
    case "$pane_cmd" in
      bash|zsh|sh|fish|nu)
        return 0
        ;;
    esac
    sleep 1
  done
  return 1
}

if [ "$FORCE" = true ]; then
  capture_archive
  show_archive_tail_and_hint
  update_meta_last_down
  kill_session
  post_lifecycle "Agent '$NAME' stopped (--kill) on ${SERVER_ID:-local}"
  mark_backend_offline "agent-down-kill"
  echo "Done (--kill)."
  exit 0
fi

send_exit
echo "Waiting for AI to exit (timeout ${TIMEOUT}s)..."
if ! wait_for_exit_to_shell; then
  capture_archive
  show_archive_tail_and_hint
  echo "Error: agent did not exit within timeout; session kept alive for manual handling." >&2
  echo "  Attach: tmux attach -t $NAME" >&2
  echo "  After seeing resume hint, run agent-down again." >&2
  exit 2
fi

capture_archive
show_archive_tail_and_hint

RESUME_HINT=$(extract_resume_hint)
if [ "$AGENT_TYPE" = "claude" ] && [ -z "$RESUME_HINT" ]; then
  echo "Error: claude resume hint missing; refusing to kill session to avoid context loss." >&2
  echo "  Attach: tmux attach -t $NAME" >&2
  echo "  Verify archive tail manually, then run: agent-down $NAME --kill (if you accept risk)." >&2
  exit 2
fi

update_meta_last_down
kill_session
post_lifecycle "Agent '$NAME' stopped on ${SERVER_ID:-local}"
mark_backend_offline "agent-down"
echo "Done."
