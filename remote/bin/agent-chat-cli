#!/bin/bash
# agent-chat-cli — Admin CLI for agent-chat backend API
#
# Usage:
#   agent-chat-cli <command> [args...]
#
# Commands:
#   create-group <name> [member1 member2 ...]   Create a group (optionally with members)
#   delete-group <name>                          Delete a group
#   add-member <group> <name1> [name2 ...]       Add members to a group
#   rm-member <group> <name1> [name2 ...]        Remove members from a group
#   list-groups                                  List all groups
#   group <name>                                 Show group details
#   list-agents                                  List all agents
#   status [name]                                Show status table or one agent status
#   agent <name>                                 Show agent details
#   identity <name> <text>                       Set agent identity/description
#   dm <agent> <human>                           Ensure DM room exists (Matrix)
set -euo pipefail

API="${AGENT_CHAT_API:-http://127.0.0.1:8090}"
TOKEN="${API_TOKEN:-}"

_curl() {
  local extra_headers=()
  [ -n "$TOKEN" ] && extra_headers=(-H "Authorization: Bearer $TOKEN")
  curl --noproxy '*' -s "${extra_headers[@]}" "$@"
}

_json_str() {
  printf '%s' "$1" | python3 -c 'import sys,json; print(json.dumps(sys.stdin.read()), end="")'
}

_json_arr() {
  python3 -c "import json,sys; print(json.dumps(sys.argv[1:]))" "$@"
}

_tmux_snapshot_json() {
  if ! command -v tmux >/dev/null 2>&1; then
    echo "{}"
    return
  fi
  tmp_tmux="$(mktemp)"
  tmux list-panes -a -F '#{session_name}|#{session_activity}|#{pane_current_command}' > "$tmp_tmux" 2>/dev/null || true
  python3 - "$tmp_tmux" <<'PY'
import json
import sys

out = {}
with open(sys.argv[1]) as f:
  lines = f.readlines()
for raw in lines:
    line = raw.rstrip('\n')
    if not line:
        continue
    parts = line.split('|', 2)
    if len(parts) < 2:
        continue
    session = parts[0].strip()
    if not session:
        continue
    try:
        activity = int(parts[1]) if parts[1].strip() else 0
    except ValueError:
        activity = 0
    cmd = parts[2].strip() if len(parts) > 2 else ''
    prev = out.get(session)
    if not prev or activity >= int(prev.get('session_activity', 0)):
        out[session] = {'session_activity': activity, 'command': cmd}

print(json.dumps(out), end='')
PY
  rm -f "$tmp_tmux"
}

cmd="${1:-help}"
shift || true

case "$cmd" in
  create-group)
    name="${1:?Usage: agent-chat-cli create-group <name> [member1 ...]}"
    shift
    members=$(_json_arr "$@")
    _curl -X POST "$API/api/groups" \
      -H 'Content-Type: application/json' \
      -d "{\"name\":$(_json_str "$name"),\"members\":$members}" | python3 -m json.tool
    ;;

  delete-group)
    name="${1:?Usage: agent-chat-cli delete-group <name>}"
    _curl -X DELETE "$API/api/groups/$name" | python3 -m json.tool
    ;;

  add-member)
    group="${1:?Usage: agent-chat-cli add-member <group> <name1> [name2 ...]}"
    shift
    [ $# -lt 1 ] && { echo "Error: at least one member name required" >&2; exit 1; }
    members=$(_json_arr "$@")
    _curl -X POST "$API/api/groups/$group/members" \
      -H 'Content-Type: application/json' \
      -d "{\"add\":$members}" | python3 -m json.tool
    ;;

  rm-member)
    group="${1:?Usage: agent-chat-cli rm-member <group> <name1> [name2 ...]}"
    shift
    [ $# -lt 1 ] && { echo "Error: at least one member name required" >&2; exit 1; }
    members=$(_json_arr "$@")
    _curl -X POST "$API/api/groups/$group/members" \
      -H 'Content-Type: application/json' \
      -d "{\"remove\":$members}" | python3 -m json.tool
    ;;

  list-groups)
    _curl "$API/api/groups" | python3 -m json.tool
    ;;

  group)
    name="${1:?Usage: agent-chat-cli group <name>}"
    _curl "$API/api/groups/$name" | python3 -m json.tool
    ;;

  register|unregister)
    echo "Error: '$cmd' has been removed. Agent presence is discovered via heartbeat (online/inactive)." >&2
    echo "Use: list-agents / agent / identity" >&2
    exit 1
    ;;

  list-agents)
    tmux_snapshot="$(_tmux_snapshot_json)"
    tmp_json="$(mktemp)"
    _curl "$API/api/agents" > "$tmp_json"
    TMUX_SNAPSHOT="$tmux_snapshot" python3 - "$tmp_json" <<'PY'
import json
import os
import sys
import time

def fmt_span(sec):
    sec = int(max(0, sec))
    if sec < 60:
        return f"{sec}s"
    if sec < 3600:
        return f"{sec//60}m{sec%60:02d}s"
    if sec < 86400:
        h, rem = divmod(sec, 3600)
        m = rem // 60
        return f"{h}h{m:02d}m"
    d, rem = divmod(sec, 86400)
    h = rem // 3600
    return f"{d}d{h:02d}h"

tmux_map = json.loads(os.environ.get('TMUX_SNAPSHOT') or '{}')
with open(sys.argv[1]) as f:
    agents = json.load(f)
now_ms = int(time.time() * 1000)
now_sec = int(time.time())

print("  NAME                 STATE    IDLE     LASTSEEN  SERVER         TYPE     TMUX")
for a in sorted(agents, key=lambda x: x.get('name', '')):
    name = str(a.get('name', '?'))
    typ = str(a.get('type', '?'))
    server = str(a.get('server') or '-')
    tmux = str(a.get('tmux') or '-')
    online = bool(a.get('online'))

    session = tmux.split(':', 1)[0] if tmux and tmux != '-' else ''
    snap = tmux_map.get(session) if session else None
    idle_sec = None
    if snap and snap.get('session_activity'):
        idle_sec = max(0, now_sec - int(snap['session_activity']))

    if online and idle_sec is not None:
        state = 'active' if idle_sec < 30 else 'idle'
    elif online:
        state = 'online'
    else:
        state = 'offline'

    last_seen = a.get('lastSeen')
    if isinstance(last_seen, (int, float)) and last_seen > 0:
        seen_txt = fmt_span((now_ms - int(last_seen)) // 1000)
    else:
        seen_txt = '-'
    idle_txt = fmt_span(idle_sec) if idle_sec is not None else '-'

    print(f"  {name:20.20s} {state:8s} {idle_txt:8s} {seen_txt:9s} {server:14.14s} {typ:8.8s} {tmux}")
PY
    rm -f "$tmp_json"
    ;;

  status)
    tmux_snapshot="$(_tmux_snapshot_json)"
    if [ $# -eq 0 ]; then
      tmp_json="$(mktemp)"
      _curl "$API/api/agents" > "$tmp_json"
      TMUX_SNAPSHOT="$tmux_snapshot" python3 - "$tmp_json" <<'PY'
import json
import os
import sys
import time

def fmt_span(sec):
    sec = int(max(0, sec))
    if sec < 60:
        return f"{sec}s"
    if sec < 3600:
        return f"{sec//60}m{sec%60:02d}s"
    if sec < 86400:
        h, rem = divmod(sec, 3600)
        m = rem // 60
        return f"{h}h{m:02d}m"
    d, rem = divmod(sec, 86400)
    h = rem // 3600
    return f"{d}d{h:02d}h"

tmux_map = json.loads(os.environ.get('TMUX_SNAPSHOT') or '{}')
with open(sys.argv[1]) as f:
    agents = json.load(f)
now_ms = int(time.time() * 1000)
now_sec = int(time.time())

print("  NAME                 STATE    IDLE     LASTSEEN  SERVER         TYPE")
for a in sorted(agents, key=lambda x: x.get('name', '')):
    name = str(a.get('name', '?'))
    typ = str(a.get('type', '?'))
    server = str(a.get('server') or '-')
    tmux = str(a.get('tmux') or '')
    online = bool(a.get('online'))

    session = tmux.split(':', 1)[0] if tmux else ''
    snap = tmux_map.get(session) if session else None
    idle_sec = None
    if snap and snap.get('session_activity'):
        idle_sec = max(0, now_sec - int(snap['session_activity']))

    if online and idle_sec is not None:
        state = 'active' if idle_sec < 30 else 'idle'
    elif online:
        state = 'online'
    else:
        state = 'offline'

    last_seen = a.get('lastSeen')
    if isinstance(last_seen, (int, float)) and last_seen > 0:
        seen_txt = fmt_span((now_ms - int(last_seen)) // 1000)
    else:
        seen_txt = '-'
    idle_txt = fmt_span(idle_sec) if idle_sec is not None else '-'

    print(f"  {name:20.20s} {state:8s} {idle_txt:8s} {seen_txt:9s} {server:14.14s} {typ:8.8s}")
PY
      rm -f "$tmp_json"
    else
      name="${1:?Usage: agent-chat-cli status [name]}"
      tmp_json="$(mktemp)"
      _curl "$API/api/agents/$name" > "$tmp_json"
      TMUX_SNAPSHOT="$tmux_snapshot" python3 - "$tmp_json" <<'PY'
import json
import os
import sys
import time

def fmt_span(sec):
    sec = int(max(0, sec))
    if sec < 60:
        return f"{sec}s"
    if sec < 3600:
        return f"{sec//60}m{sec%60:02d}s"
    if sec < 86400:
        h, rem = divmod(sec, 3600)
        m = rem // 60
        return f"{h}h{m:02d}m"
    d, rem = divmod(sec, 86400)
    h = rem // 3600
    return f"{d}d{h:02d}h"

tmux_map = json.loads(os.environ.get('TMUX_SNAPSHOT') or '{}')
with open(sys.argv[1]) as f:
    obj = json.load(f)
if isinstance(obj, dict) and obj.get('error'):
    print(json.dumps(obj, ensure_ascii=False, indent=2))
    sys.exit(0)

now_ms = int(time.time() * 1000)
now_sec = int(time.time())

name = str(obj.get('name', '?'))
typ = str(obj.get('type', '?'))
server = str(obj.get('server') or '-')
tmux = str(obj.get('tmux') or '-')
online = bool(obj.get('online'))
session = tmux.split(':', 1)[0] if tmux and tmux != '-' else ''
snap = tmux_map.get(session) if session else None
idle_sec = None
if snap and snap.get('session_activity'):
    idle_sec = max(0, now_sec - int(snap['session_activity']))

if online and idle_sec is not None:
    state = 'active' if idle_sec < 30 else 'idle'
elif online:
    state = 'online'
else:
    state = 'offline'

last_seen = obj.get('lastSeen')
if isinstance(last_seen, (int, float)) and last_seen > 0:
    seen_txt = fmt_span((now_ms - int(last_seen)) // 1000)
else:
    seen_txt = '-'
idle_txt = fmt_span(idle_sec) if idle_sec is not None else '-'

print(f"name:        {name}")
print(f"state:       {state}")
print(f"idle:        {idle_txt}")
print(f"lastSeen:    {seen_txt} ago")
print(f"online:      {str(online).lower()}")
print(f"type:        {typ}")
print(f"server:      {server}")
print(f"tmux:        {tmux}")
offline_reason = obj.get('offlineReason')
print(f"offlineReason:{offline_reason if offline_reason else '-'}")
PY
      rm -f "$tmp_json"
    fi
    ;;

  agent)
    name="${1:?Usage: agent-chat-cli agent <name>}"
    _curl "$API/api/agents/$name" | python3 -m json.tool
    ;;

  identity)
    name="${1:?Usage: agent-chat-cli identity <name> <text>}"
    shift
    text="$*"
    [ -z "$text" ] && { echo "Error: identity text required" >&2; exit 1; }
    _curl -X PATCH "$API/api/agents/$name" \
      -H 'Content-Type: application/json' \
      -d "{\"identity\":$(_json_str "$text")}" | python3 -m json.tool
    ;;

  dm)
    agent="${1:?Usage: agent-chat-cli dm <agent> <human>}"
    human="${2:?Usage: agent-chat-cli dm <agent> <human>}"
    echo "Ensuring DM room: $agent ↔ $human ..."
    _curl -X POST "$API/api/dm/ensure" \
      -H 'Content-Type: application/json' \
      -d "{\"agent\":$(_json_str "$agent"),\"human\":$(_json_str "$human")}" | python3 -m json.tool
    ;;

  help|--help|-h)
    echo "agent-chat-cli — Admin CLI for agent-chat"
    echo ""
    echo "Group management:"
    echo "  create-group <name> [member1 ...]   Create group"
    echo "  delete-group <name>                 Delete group"
    echo "  add-member <group> <m1> [m2 ...]    Add members"
    echo "  rm-member <group> <m1> [m2 ...]     Remove members"
    echo "  list-groups                         List all groups"
    echo "  group <name>                        Group details"
    echo ""
    echo "Agent management:"
    echo "  list-agents                         List all agents"
    echo "  status [name]                       Status table or one agent status"
    echo "  agent <name>                        Agent details"
    echo "  identity <name> <text>              Set agent identity"
    echo ""
    echo "DM management:"
    echo "  dm <agent> <human>                  Ensure DM room exists (Matrix)"
    echo ""
    echo "Environment:"
    echo "  AGENT_CHAT_API  Backend URL (default: http://127.0.0.1:8090)"
    echo "  API_TOKEN       Auth token (optional for localhost)"
    ;;

  *)
    echo "Unknown command: $cmd" >&2
    echo "Run 'agent-chat-cli help' for usage" >&2
    exit 1
    ;;
esac
