#!/bin/bash
# agent-down — Gracefully stop an agent with archive + resume ID capture
#
# Usage:
#   agent-down <name> [--kill] [--timeout <seconds>]
#
# Default behavior:
#   - claude: send /exit, wait up to 30s for process to return to shell
#   - codex:  send Ctrl+C, wait up to 8s for process to return to shell
#   - archive pane, show tail, try to extract resume hint
#   - claude without resume hint is treated as error (session is kept alive)
#
# --kill behavior:
#   - archive first, then kill tmux session immediately

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
BASE_DIR="$(dirname "$SCRIPT_DIR")"
DATA_DIR="$BASE_DIR/data/agents"

# Load .env if present
ENV_FILE="$BASE_DIR/.env"
if [ -f "$ENV_FILE" ]; then
  set -a
  source "$ENV_FILE"
  set +a
fi

BACKEND_URL="${AGENT_CHAT_API:-http://127.0.0.1:8090}"
API_TOKEN="${API_TOKEN:-}"
SERVER_ID="${AGENT_CHAT_SERVER:-}"
AUTH_HEADER=""
[ -n "$API_TOKEN" ] && AUTH_HEADER="Authorization: Bearer $API_TOKEN"

have_cmd() {
  command -v "$1" >/dev/null 2>&1
}

api_curl() {
  if [ -n "$AUTH_HEADER" ]; then
    curl --noproxy '*' -s -H "$AUTH_HEADER" "$@"
  else
    curl --noproxy '*' -s "$@"
  fi
}

post_lifecycle() {
  local event_summary="$1"
  local summary_json
  summary_json=$(EVENT_SUMMARY="$event_summary" python3 - <<'PY'
import json
import os
print(json.dumps(os.environ["EVENT_SUMMARY"]))
PY
)
  api_curl -X POST "$BACKEND_URL/api/messages" \
    -H 'Content-Type: application/json' \
    -d "{\"from\":\"system\",\"group\":\"info\",\"type\":\"inform\",\"summary\":${summary_json},\"full\":\"\",\"mentions\":[]}" \
    >/dev/null 2>&1 || true
}

mark_backend_offline() {
  local reason="${1:-agent-down}"
  local payload
  payload=$(REASON="$reason" python3 - <<'PY'
import json
import os
print(json.dumps({"reason": os.environ["REASON"], "clearTmux": True}))
PY
)
  if api_curl -X POST "$BACKEND_URL/api/agents/$AGENT_PATH_ESCAPED/offline" \
    -H 'Content-Type: application/json' \
    -d "$payload" >/dev/null 2>&1; then
    echo "Marked '$NAME' offline in backend."
  else
    echo "Warning: failed to mark '$NAME' offline in backend." >&2
  fi
}

if [ $# -lt 1 ]; then
  echo "Usage: agent-down <name> [--kill] [--timeout <seconds>]"
  exit 1
fi

NAME="$1"
shift || true
TMUX_TARGET="=${NAME}"
TMUX_PANE_TARGET="=${NAME}:0.0"
AGENT_PATH_ESCAPED=$(NAME="$NAME" python3 - <<'PY'
import os
import urllib.parse
print(urllib.parse.quote(os.environ["NAME"], safe=""))
PY
)

FORCE=false
TIMEOUT=""
while [ $# -gt 0 ]; do
  case "$1" in
    --kill)
      FORCE=true
      shift
      ;;
    --timeout)
      if [ $# -lt 2 ]; then
        echo "Error: --timeout requires a value" >&2
        exit 1
      fi
      TIMEOUT="$2"
      shift 2
      ;;
    *)
      echo "Error: unrecognized argument '$1'" >&2
      echo "Usage: agent-down <name> [--kill] [--timeout <seconds>]" >&2
      exit 1
      ;;
  esac
done

if ! tmux has-session -t "$TMUX_TARGET" 2>/dev/null; then
  echo "Session '$NAME' does not exist."
  mark_backend_offline "session-missing"
  exit 0
fi

AGENT_DATA="$DATA_DIR/$NAME"
mkdir -p "$AGENT_DATA"

TIMESTAMP=$(date +%Y%m%d-%H%M%S)
ARCHIVE_FILE="$AGENT_DATA/archive-$TIMESTAMP.txt"
RESUME_FILE="$AGENT_DATA/resume-id"
META_FILE="$AGENT_DATA/meta.json"

# Detect agent type from meta.json or fallback to process detection
AGENT_TYPE=""
if [ -f "$META_FILE" ]; then
  AGENT_TYPE=$(python3 -c "import json; print(json.load(open('$META_FILE')).get('type',''))" 2>/dev/null || true)
fi
if [ -z "$AGENT_TYPE" ]; then
  PANE_CMD=$(tmux list-panes -t "$TMUX_PANE_TARGET" -F "#{pane_current_command}" 2>/dev/null | head -1)
  case "$PANE_CMD" in
    *codex*|node) AGENT_TYPE="codex" ;;
    *claude*) AGENT_TYPE="claude" ;;
    *)
      if tmux capture-pane -t "$TMUX_PANE_TARGET" -p -S -120 2>/dev/null | if have_cmd rg; then rg -q 'OpenAI Codex|codex resume'; else grep -Eq 'OpenAI Codex|codex resume'; fi; then
        AGENT_TYPE="codex"
      else
        AGENT_TYPE="claude"
      fi
      ;;
  esac
fi

if [ -z "$TIMEOUT" ]; then
  if [ "$AGENT_TYPE" = "codex" ]; then
    TIMEOUT=8
  else
    TIMEOUT=30
  fi
fi

update_meta_last_down() {
  if [ -f "$META_FILE" ]; then
    NOW=$(date -Iseconds)
    META_FILE="$META_FILE" NOW="$NOW" python3 - <<'PY' 2>/dev/null || true
import json
import os

meta_file = os.environ["META_FILE"]
with open(meta_file) as f:
    data = json.load(f)
data["lastDown"] = os.environ["NOW"]
with open(meta_file, "w") as f:
    json.dump(data, f, indent=2)
PY
  fi
}

capture_archive() {
  echo "Archiving pane scrollback..."
  tmux capture-pane -t "$TMUX_PANE_TARGET" -p -S - > "$ARCHIVE_FILE" 2>/dev/null || true
  LINES=$(wc -l < "$ARCHIVE_FILE" 2>/dev/null || echo 0)
  echo "  Saved $LINES lines → $ARCHIVE_FILE"
}

extract_resume_hint() {
  if [ ! -f "$ARCHIVE_FILE" ]; then
    return 1
  fi
  if have_cmd rg; then
    rg -o 'claude --resume [0-9a-f-]{36}|codex resume [0-9a-f-]{36}' "$ARCHIVE_FILE" | tail -1 || true
  else
    grep -Eo 'claude --resume [0-9a-f-]{36}|codex resume [0-9a-f-]{36}' "$ARCHIVE_FILE" | tail -1 || true
  fi
}

show_archive_tail_and_hint() {
  echo "  Archive tail (manual check):"
  tail -n 10 "$ARCHIVE_FILE" | sed 's/^/    /'

  RESUME_HINT=$(extract_resume_hint)
  if [ -n "$RESUME_HINT" ]; then
    RESUME_ID=$(echo "$RESUME_HINT" | grep -oE '[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}' || true)
    echo "  Resume hint: $RESUME_HINT"
    if [ -n "$RESUME_ID" ]; then
      echo "$RESUME_ID" > "$RESUME_FILE"
      echo "  Updated: $RESUME_FILE"
    fi
  else
    echo "  No explicit resume command found."
  fi
}

kill_session() {
  echo "Killing tmux session '$NAME'..."
  tmux kill-session -t "$TMUX_TARGET" 2>/dev/null || true
}

send_exit() {
  if [ "$AGENT_TYPE" = "codex" ]; then
    echo "Sending Ctrl+C to codex '$NAME'..."
    tmux send-keys -t "$TMUX_PANE_TARGET" C-c
    sleep 1
    pane_cmd=$(tmux display-message -p -t "$TMUX_PANE_TARGET" "#{pane_current_command}" 2>/dev/null || true)
    case "$pane_cmd" in
      bash|zsh|sh|fish|nu) ;;
      *)
        echo "Codex still active after first Ctrl+C; sending second Ctrl+C..."
        tmux send-keys -t "$TMUX_PANE_TARGET" C-c
        ;;
    esac
  else
    echo "Sending claude exit sequence (/exit + Enter + Ctrl+C x3) to '$NAME'..."
    tmux send-keys -t "$TMUX_PANE_TARGET" "/exit"
    sleep 0.1
    tmux send-keys -t "$TMUX_PANE_TARGET" C-m
    sleep 0.1
    tmux send-keys -t "$TMUX_PANE_TARGET" C-c
    sleep 0.1
    tmux send-keys -t "$TMUX_PANE_TARGET" C-c
    sleep 0.1
    tmux send-keys -t "$TMUX_PANE_TARGET" C-c
  fi
}

wait_for_exit_to_shell() {
  local i pane_cmd
  for ((i = 0; i < TIMEOUT; i++)); do
    if ! tmux has-session -t "$TMUX_TARGET" 2>/dev/null; then
      return 0
    fi
    pane_cmd=$(tmux display-message -p -t "$TMUX_PANE_TARGET" "#{pane_current_command}" 2>/dev/null || true)
    case "$pane_cmd" in
      bash|zsh|sh|fish|nu)
        return 0
        ;;
    esac
    sleep 1
  done
  return 1
}

if [ "$FORCE" = true ]; then
  capture_archive
  show_archive_tail_and_hint
  update_meta_last_down
  post_lifecycle "Agent '$NAME' stopped (--kill) on ${SERVER_ID:-local}"
  kill_session
  mark_backend_offline "agent-down-kill"
  echo "Done (--kill)."
  exit 0
fi

send_exit
echo "Waiting for AI to exit (timeout ${TIMEOUT}s)..."
if ! wait_for_exit_to_shell; then
  capture_archive
  show_archive_tail_and_hint
  echo "Error: agent did not exit within timeout; session kept alive for manual handling." >&2
  echo "  Attach: tmux attach -t $NAME" >&2
  echo "  After seeing resume hint, run agent-down again." >&2
  exit 2
fi

capture_archive
show_archive_tail_and_hint

RESUME_HINT=$(extract_resume_hint)
if [ "$AGENT_TYPE" = "claude" ] && [ -z "$RESUME_HINT" ]; then
  echo "Error: claude resume hint missing; refusing to kill session to avoid context loss." >&2
  echo "  Attach: tmux attach -t $NAME" >&2
  echo "  Verify archive tail manually, then run: agent-down $NAME --kill (if you accept risk)." >&2
  exit 2
fi

update_meta_last_down
post_lifecycle "Agent '$NAME' stopped on ${SERVER_ID:-local}"
kill_session
mark_backend_offline "agent-down"
echo "Done."
