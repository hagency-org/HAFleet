#!/usr/bin/env node
/*
 * The entrypoint that starts HAFleet's own service supervisor.
 *
 * WHY THIS DID NOT EXIST UNTIL NOW, which is the part worth reading. `LocalServiceSupervisor` is 500
 * lines with five test files and had NO product caller: `bin/hafleet-acp-up` says the supervisor "is
 * itself started by launchd or systemd", the systemd units in this repo start individual services rather
 * than the supervisor, and on macOS there was no unit at all. So the thing that gives restart-on-crash
 * and reboot survival was started by nobody, and every service on this host was launched by hand with
 * `nohup` — including all day while this session worked on it.
 *
 * That is the same shape this codebase keeps producing: a capability built, tested, and never invoked.
 * `mintAgentIdentity` had no caller, the role matcher sat on a withdrawn route, and the bridge's own
 * room sweep had no signal. A test suite proves a thing CAN work; only a caller makes it work.
 *
 * WHAT IT DELIBERATELY DOES NOT DO: it does not daemonise, write a pidfile, or fork. launchd and systemd
 * both want a foreground process they own, and a program that backgrounds itself takes that away —
 * which is how you get a supervisor the supervisor cannot supervise.
 */

import path from 'path';
import { fileURLToPath } from 'url';
import { existsSync, readFileSync } from 'fs';
import { LocalServiceSupervisor } from '../src/local-service-supervisor.mjs';

const repoRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');

/**
 * The runtime directory, from the same variable everything else reads.
 *
 * Refused rather than defaulted. A supervisor that guessed would happily run a fleet against the repo's
 * dev `data/` while an operator believed it was serving the real one — this session did exactly that by
 * hand once, and only an agent-count mismatch caught it.
 */
const runtimeRoot = (process.env.HAFLEET_RUNTIME_DIR || '').trim();
if (!runtimeRoot) {
  console.error('hafleet-supervisor: HAFLEET_RUNTIME_DIR is required.');
  console.error('  Source the runtime .env first; there is no safe default — guessing would risk');
  console.error('  serving a different fleet than the operator believes is running.');
  process.exit(2);
}
if (!existsSync(runtimeRoot)) {
  console.error(`hafleet-supervisor: HAFLEET_RUNTIME_DIR does not exist: ${runtimeRoot}`);
  process.exit(2);
}

/**
 * The profile, chosen the same way `hafleet-acp-up` chooses it.
 *
 * Same order and same filenames on purpose: two launchers that disagree about which profile is live
 * would start two different fleets, and the operator would have no way to tell which one they were
 * looking at.
 */
const profilePath = (process.env.HAFLEET_SERVICE_PROFILE || '').trim()
  || [
    path.join(repoRoot, 'services-macos.json'),
    path.join(repoRoot, 'services', 'services-local.json'),
  ].find((candidate) => existsSync(candidate));

if (!profilePath || !existsSync(profilePath)) {
  console.error('hafleet-supervisor: no service profile found.');
  console.error('  Looked for services-macos.json and services/services-local.json.');
  console.error('  Set HAFLEET_SERVICE_PROFILE to choose one explicitly.');
  process.exit(2);
}

let profile;
try {
  profile = JSON.parse(readFileSync(profilePath, 'utf8'));
} catch (error) {
  console.error(`hafleet-supervisor: ${profilePath} is not readable JSON: ${error.message}`);
  process.exit(2);
}

/*
 * THE RUNTIME'S OWN .env, LOADED HERE. Children inherit this process's environment, and launchd gives a
 * process almost nothing — PATH and whatever the unit states. A first install started the supervisor
 * correctly and then failed with "service backend did not become healthy within 15000ms", because the
 * backend it launched had no API_TOKEN and no Matrix credentials: everything the operator keeps in the
 * runtime .env was missing.
 *
 * Loaded rather than listed in the launchd unit, for one reason that matters: the unit would then hold
 * copies of secrets, in a file that is not mode 600 and that an install script rewrites. The .env stays
 * the single place they live, and the unit names only the directory.
 *
 * EXISTING VARIABLES WIN. A value already in the environment was put there deliberately — by an operator
 * running this by hand, or by a unit override — and a file quietly replacing it would make the same
 * command behave differently depending on what was on disk.
 */
const envFile = path.join(runtimeRoot, '.env');
if (existsSync(envFile)) {
  let loaded = 0;
  for (const line of readFileSync(envFile, 'utf8').split('\n')) {
    const trimmed = line.trim();
    if (!trimmed || trimmed.startsWith('#')) continue;
    const eq = trimmed.indexOf('=');
    if (eq <= 0) continue;
    const key = trimmed.slice(0, eq).trim();
    if (!key || process.env[key] !== undefined) continue;
    let value = trimmed.slice(eq + 1).trim();
    // Strip one layer of matching quotes, which is what a shell would have done reading the same file.
    if (value.length >= 2 && ((value[0] === '"' && value.endsWith('"')) || (value[0] === "'" && value.endsWith("'")))) {
      value = value.slice(1, -1);
    }
    process.env[key] = value;
    loaded += 1;
  }
  // Count only — printing names would put the shape of an operator's secrets in a log.
  console.log(`hafleet-supervisor: loaded ${loaded} variable(s) from the runtime .env`);
} else {
  console.warn(`hafleet-supervisor: no .env at ${envFile}; services will start with this process's `
    + 'environment only, which for a launchd job is almost nothing');
}

/**
 * How long a service gets to become healthy, and why the default is not enough here.
 *
 * The supervisor's own default is 15s. This backend takes about 7s to answer `/health` on a warm host —
 * it loads agents, tokens, the queue and the ledger before it listens — and a first launchd install
 * failed with "service backend did not become healthy within 15000ms" while the same profile started
 * fine in the foreground. Half the budget spent on a cold start leaves nothing for a loaded machine,
 * and the failure mode is a supervisor that kills a service which was about to be ready.
 *
 * Sixty seconds, overridable. Generous on purpose: the cost of waiting too long is a slow start an
 * operator sees in the log, and the cost of waiting too little is a fleet that will not come up at boot
 * — exactly when nobody is watching.
 */
const dependencyTimeoutMs = Math.max(
  1000,
  Number(process.env.HAFLEET_SUPERVISOR_HEALTH_TIMEOUT_MS) || 60000,
);

const supervisor = new LocalServiceSupervisor({ profile, repoRoot, runtimeRoot, dependencyTimeoutMs });

/*
 * ONE SHUTDOWN PATH, and it runs to completion before exiting. A supervisor killed mid-stop leaves the
 * children it was managing behind, and the next start finds their ports taken — which reads as "the
 * backend is already running" when what is actually running is an orphan from the last shutdown.
 */
let stopping = false;
const shutdown = async (signal) => {
  if (stopping) return;
  stopping = true;
  console.log(`hafleet-supervisor: ${signal} — stopping services`);
  try {
    await supervisor.stop();
  } catch (error) {
    console.error(`hafleet-supervisor: stop failed: ${error?.message || error}`);
  }
  process.exit(0);
};
process.on('SIGTERM', () => { shutdown('SIGTERM'); });
process.on('SIGINT', () => { shutdown('SIGINT'); });

console.log(`hafleet-supervisor: profile=${path.relative(repoRoot, profilePath)} runtime=${runtimeRoot}`);
try {
  await supervisor.start();
  console.log(`hafleet-supervisor: started ${(profile.services || []).length} service(s); supervising`);
} catch (error) {
  /*
   * Exit non-zero so launchd/systemd records a failure rather than a clean stop. A supervisor that
   * exits 0 after failing to start looks, in every log an operator reads, exactly like one that was
   * asked to stop.
   */
  console.error(`hafleet-supervisor: failed to start: ${error?.message || error}`);
  process.exit(1);
}
