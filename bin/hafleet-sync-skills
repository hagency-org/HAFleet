#!/usr/bin/env bash
set -euo pipefail

_resolve_script_dir() {
  local src="$0"
  while [ -L "$src" ]; do
    local dir
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
  done
  cd -P "$(dirname "$src")" && pwd
}

SCRIPT_DIR="$(_resolve_script_dir)"
BASE_DIR="$(dirname "$SCRIPT_DIR")"
TEMPLATE="$BASE_DIR/skills/hafleet/SKILL.md"
CHECK_ONLY=false
QUIET=false

usage() {
  cat <<'USAGE'
Usage: hafleet-sync-skills [--check] [--quiet]

Sync ~/.codex and ~/.claude hafleet skill files to the repository template:
  skills/hafleet/SKILL.md

Options:
  --check   Verify links only; do not change files
  --quiet   Reduce output
  -h, --help
USAGE
}

log() {
  if [ "$QUIET" = false ]; then
    echo "$@"
  fi
}

ensure_link() {
  local target="$1"
  local target_dir
  target_dir="$(dirname "$target")"

  if [ "$CHECK_ONLY" = true ]; then
    if [ -L "$target" ]; then
      local current
      current="$(readlink -f "$target" 2>/dev/null || true)"
      local want
      want="$(readlink -f "$TEMPLATE" 2>/dev/null || true)"
      if [ "$current" = "$want" ]; then
        log "[OK] $target -> $current"
        return 0
      fi
      echo "[FAIL] $target points to $current (expected $want)" >&2
      return 1
    fi
    echo "[FAIL] $target is not a symlink" >&2
    return 1
  fi

  mkdir -p "$target_dir"
  if [ -e "$target" ] && [ ! -L "$target" ]; then
    local backup="${target}.bak.$(date +%Y%m%d-%H%M%S)"
    mv "$target" "$backup"
    log "[BACKUP] $target -> $backup"
  fi

  ln -sfn "$TEMPLATE" "$target"
  local resolved
  resolved="$(readlink -f "$target" 2>/dev/null || true)"
  log "[LINK] $target -> $resolved"
}

while [ $# -gt 0 ]; do
  case "$1" in
    --check)
      CHECK_ONLY=true
      ;;
    --quiet)
      QUIET=true
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Error: unknown argument '$1'" >&2
      usage >&2
      exit 1
      ;;
  esac
  shift
done

if [ ! -f "$TEMPLATE" ]; then
  echo "Error: template not found: $TEMPLATE" >&2
  exit 1
fi

TARGETS=(
  "$HOME/.codex/skills/hafleet/SKILL.md"
  "$HOME/.claude/skills/hafleet/SKILL.md"
)

failed=0
for t in "${TARGETS[@]}"; do
  if ! ensure_link "$t"; then
    failed=1
  fi
done

if [ "$failed" -ne 0 ]; then
  exit 1
fi

if [ "$CHECK_ONLY" = true ]; then
  log "Skill link check passed."
else
  log "Skill links synced."
fi
