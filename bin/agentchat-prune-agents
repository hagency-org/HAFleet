#!/usr/bin/env bash
set -euo pipefail

_resolve_script_dir() {
  local src="$0"
  while [ -L "$src" ]; do
    local dir
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
  done
  cd -P "$(dirname "$src")" && pwd
}

SCRIPT_DIR="$(_resolve_script_dir)"
BASE_DIR="$(dirname "$SCRIPT_DIR")"

BACKEND_PORT_RAW="${AGENT_CHAT_BACKEND_PORT:-8090}"
if [[ "$BACKEND_PORT_RAW" =~ ^[0-9]+$ ]] && [ "$BACKEND_PORT_RAW" -gt 0 ]; then
  BACKEND_PORT="$BACKEND_PORT_RAW"
else
  BACKEND_PORT="8090"
fi
API="${AGENT_CHAT_API:-http://127.0.0.1:$BACKEND_PORT}"
TOKEN="${API_TOKEN:-}"
APPLY=false
QUIET=false
OLDER_THAN_DAYS=7
MODE="conservative"
NAME_REGEX=""
KEEP_NAMES=""

usage() {
  cat <<'USAGE'
Usage: agentchat-prune-agents [options]

Prune stale offline agent records from backend /api/agents.

Options:
  --apply                 Execute deletions (default: dry-run)
  --older-than-days <n>   Minimum offline age in days (default: 7)
  --mode <conservative|all-offline>
                          conservative: only known stale/test patterns
                          all-offline: any offline agent older than threshold
  --name-regex <regex>    Custom name regex filter (overrides mode filter)
  --keep <a,b,c>          Never delete these exact agent names
  --quiet                 Reduce output
  -h, --help              Show this help
USAGE
}

log() {
  if [ "$QUIET" = false ]; then
    echo "$@"
  fi
}

url_encode() {
  python3 - "$1" <<'PY'
import sys
import urllib.parse
print(urllib.parse.quote(sys.argv[1], safe=""))
PY
}

if ! [[ "$OLDER_THAN_DAYS" =~ ^[0-9]+$ ]]; then
  echo "Error: invalid default older-than-days" >&2
  exit 1
fi

while [ $# -gt 0 ]; do
  case "$1" in
    --apply)
      APPLY=true
      ;;
    --older-than-days)
      [ $# -ge 2 ] || { echo "Error: --older-than-days requires value" >&2; exit 1; }
      OLDER_THAN_DAYS="$2"
      shift
      ;;
    --mode)
      [ $# -ge 2 ] || { echo "Error: --mode requires value" >&2; exit 1; }
      MODE="$2"
      shift
      ;;
    --name-regex)
      [ $# -ge 2 ] || { echo "Error: --name-regex requires value" >&2; exit 1; }
      NAME_REGEX="$2"
      shift
      ;;
    --keep)
      [ $# -ge 2 ] || { echo "Error: --keep requires value" >&2; exit 1; }
      KEEP_NAMES="$2"
      shift
      ;;
    --quiet)
      QUIET=true
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Error: unknown argument '$1'" >&2
      usage >&2
      exit 1
      ;;
  esac
  shift
done

if ! [[ "$OLDER_THAN_DAYS" =~ ^[0-9]+$ ]]; then
  echo "Error: --older-than-days must be an integer" >&2
  exit 1
fi

if [ "$MODE" != "conservative" ] && [ "$MODE" != "all-offline" ]; then
  echo "Error: --mode must be conservative or all-offline" >&2
  exit 1
fi

AUTH_ARGS=()
if [ -n "$TOKEN" ]; then
  AUTH_ARGS=(-H "Authorization: Bearer $TOKEN")
fi

agents_json="$(curl --noproxy '*' -s "${AUTH_ARGS[@]}" "$API/api/agents")"
if [ -z "$agents_json" ]; then
  echo "Error: failed to fetch agents from $API/api/agents" >&2
  exit 1
fi

candidates="$(
AGENTS_JSON="$agents_json" OLDER="$OLDER_THAN_DAYS" MODE="$MODE" NAME_REGEX="$NAME_REGEX" KEEP_NAMES="$KEEP_NAMES" \
python3 - <<'PY'
import json
import os
import re
import time

raw = os.environ.get("AGENTS_JSON", "")
older_days = int(os.environ.get("OLDER", "7"))
mode = os.environ.get("MODE", "conservative")
name_regex = os.environ.get("NAME_REGEX", "").strip()
keep_raw = os.environ.get("KEEP_NAMES", "")
keep = {x.strip() for x in keep_raw.split(",") if x.strip()}

now_ms = int(time.time() * 1000)
threshold_ms = older_days * 24 * 3600 * 1000

conservative_re = re.compile(r"^(lease-test|lease-test2|lease-test3|lease-catchup|catchup-agent|__codex_fail_guard_t|a|b)$|^prts-agent-server_in")
custom_re = re.compile(name_regex) if name_regex else None

try:
    arr = json.loads(raw)
except Exception:
    arr = []

if not isinstance(arr, list):
    arr = []

for item in arr:
    if not isinstance(item, dict):
        continue
    name = str(item.get("name") or "").strip()
    if not name or name in keep:
        continue
    if item.get("online") is True:
        continue
    last_seen = item.get("lastSeen")
    if not isinstance(last_seen, (int, float)):
        continue
    age_ms = now_ms - int(last_seen)
    if age_ms < threshold_ms:
        continue

    if custom_re is not None:
        if custom_re.search(name) is None:
            continue
    elif mode == "conservative":
        if conservative_re.search(name) is None:
            continue

    reason = str(item.get("offlineReason") or "")
    manual_down = bool(item.get("manualDown"))
    age_days = age_ms / (24 * 3600 * 1000)
    print(f"{name}\t{age_days:.2f}\t{reason}\tmanualDown={str(manual_down).lower()}")
PY
)"

if [ -z "$candidates" ]; then
  log "No stale agents matched prune criteria."
  exit 0
fi

log "Candidates:"
printf '%s\n' "$candidates" | while IFS=$'\t' read -r name age reason extra; do
  log "  - $name (age=${age}d, reason=${reason:-none}, $extra)"
done

if [ "$APPLY" = false ]; then
  log "Dry-run only. Re-run with --apply to delete these agent records."
  exit 0
fi

deleted=0
skipped=0
failed=0

while IFS=$'\t' read -r name _rest; do
  if [ -z "$name" ]; then
    continue
  fi

  # Safety: don't delete if tmux session currently exists.
  if tmux has-session -t "=$name" 2>/dev/null; then
    log "[SKIP] $name has live tmux session"
    skipped=$((skipped + 1))
    continue
  fi

  enc="$(url_encode "$name")"
  if curl --noproxy '*' -s -X DELETE "${AUTH_ARGS[@]}" "$API/api/agents/$enc?force=true" >/dev/null; then
    log "[DELETE] $name"
    deleted=$((deleted + 1))
  else
    log "[FAIL] $name"
    failed=$((failed + 1))
  fi
done <<< "$candidates"

log "Prune result: deleted=$deleted skipped=$skipped failed=$failed"
if [ "$failed" -gt 0 ]; then
  exit 1
fi
