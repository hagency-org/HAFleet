#!/usr/bin/env bash
# Check which tmux sessions have agent-chat MCP loaded (Claude Code + Codex)
# Usage: check-mcp

printf "%-30s %-10s %-10s %-10s\n" "SESSION" "MCP" "CLIENT" "KNOWN"
printf "%-30s %-10s %-10s %-10s\n" "-------" "---" "------" "----------"

# Get known agents from backend
known=$(curl -s --noproxy '*' http://127.0.0.1:8090/api/agents 2>/dev/null | python3 -c '
import json
import sys
try:
    data = json.load(sys.stdin)
except Exception:
    data = []
if isinstance(data, list):
    for item in data:
        if isinstance(item, dict) and item.get("name"):
            print(item["name"])
' 2>/dev/null)

# Temp files for portable lookups (bash 3.2 compat — no declare -A)
_TMP_FILES=""
_mktmp() { local f; f=$(mktemp 2>/dev/null || mktemp -t check_mcp); _TMP_FILES="$_TMP_FILES $f"; echo "$f"; }
trap 'rm -f $_TMP_FILES' EXIT

PTS_MAP=$(_mktmp)
MCP_MAP=$(_mktmp)

# Build tty → session map
tmux list-panes -a -F '#{pane_tty} #{session_name}' 2>/dev/null \
  | sed 's|/dev/||' > "$PTS_MAP" || true

# Detect MCP sessions and their client type
for pid in $(pgrep -f 'node.*mcp-server.js' 2>/dev/null); do
  pts=$(ps -o tty= -p "$pid" 2>/dev/null | tr -d ' ')
  sess=$(grep -m1 "^${pts} \|/${pts} " "$PTS_MAP" 2>/dev/null | awk '{print $2}')
  if [ -n "$sess" ]; then
    ppid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
    pcomm=$(ps -o comm= -p "$ppid" 2>/dev/null | tr -d ' ')
    client="claude"
    [ "$pcomm" = "codex" ] && client="codex"
    echo "$sess $client" >> "$MCP_MAP"
  fi
done

# List all sessions
for sess in $(tmux list-sessions -F '#{session_name}' 2>/dev/null | sort); do
  has_mcp="no"
  client="-"
  mcp_line=$(grep "^${sess} " "$MCP_MAP" 2>/dev/null | head -1)
  if [ -n "$mcp_line" ]; then
    has_mcp="YES"
    client=$(echo "$mcp_line" | awk '{print $2}')
  fi

  is_known="no"
  echo "$known" | grep -qx "$sess" && is_known="YES"

  printf "%-30s %-10s %-10s %-10s\n" "$sess" "$has_mcp" "$client" "$is_known"
done
