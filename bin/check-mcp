#!/usr/bin/env bash
# Check which tmux sessions have agent-chat MCP loaded (Claude Code + Codex)
# Usage: check-mcp

printf "%-30s %-10s %-10s %-10s\n" "SESSION" "MCP" "CLIENT" "REGISTERED"
printf "%-30s %-10s %-10s %-10s\n" "-------" "---" "------" "----------"

# Get registered agents
registered=$(curl -s --noproxy '*' http://127.0.0.1:8090/api/agents 2>/dev/null | grep -o '"name":"[^"]*"' | cut -d'"' -f4)

# Build map: pts → tmux session
declare -A pts_to_session
while IFS=' ' read -r tty sess; do
  pts="${tty#/dev/}"
  pts_to_session["$pts"]="$sess"
done < <(tmux list-panes -a -F '#{pane_tty} #{session_name}' 2>/dev/null)

# Build set of sessions with MCP and their client type
declare -A mcp_sessions
declare -A mcp_client

# Method 1: mcp-server.js spawned by Claude Code (node process)
for pid in $(pgrep -f 'node.*mcp-server.js' 2>/dev/null); do
  pts=$(ps -o tty= -p "$pid" 2>/dev/null | tr -d ' ')
  sess="${pts_to_session[$pts]}"
  if [ -n "$sess" ]; then
    # Check parent to determine client
    ppid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
    pcomm=$(ps -o comm= -p "$ppid" 2>/dev/null | tr -d ' ')
    if [ "$pcomm" = "codex" ]; then
      mcp_sessions["$sess"]=1
      mcp_client["$sess"]="codex"
    else
      mcp_sessions["$sess"]=1
      mcp_client["$sess"]="claude"
    fi
  fi
done

# List all sessions
for sess in $(tmux list-sessions -F '#{session_name}' 2>/dev/null | sort); do
  has_mcp="no"
  client="-"
  [ "${mcp_sessions[$sess]}" = "1" ] && has_mcp="YES" && client="${mcp_client[$sess]}"

  is_reg="no"
  echo "$registered" | grep -qx "$sess" && is_reg="YES"

  printf "%-30s %-10s %-10s %-10s\n" "$sess" "$has_mcp" "$client" "$is_reg"
done
