#!/bin/bash

# Deprecated legacy entrypoint: forward to unified 'hafleet'.
if [ "${HAFLEET_INTERNAL_DISPATCH:-0}" != "1" ]; then
  _ac_legacy_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  _ac_legacy_name="$(basename "$0")"
  echo "[DEPRECATED] ${_ac_legacy_name} is deprecated. Use: hafleet up ..." >&2
  exec "${_ac_legacy_dir}/hafleet" "up" "$@"
fi
# hafleet-up — Quick agent launcher with resume support
#
# Usage:
#   hafleet-up <name> [path] [claude|codex] [--fresh] [--attach] [--allow-shared-workspace] [--model <model>] [--extra-args "<args>"]
#
# If path is omitted, reads from saved meta.json (previous hafleet-down).
# If --fresh is not set, resume-id is required for strict resume (no silent fallback).
#
# Examples:
#   hafleet-up umiki-worker ~/laplace/umiki claude                           # first time
#   hafleet-up umiki-worker                                                   # resume from meta
#   hafleet-up umiki-worker --fresh                                           # new session, same path
#   hafleet-up ddnsserer ~/cloudflare codex                                   # codex agent
#   hafleet-up news ~/laplace/news claude --model claude-opus-4-1             # fixed model
#   hafleet-up coder ~/laplace/repo codex --model gpt-5.3-codex-spark         # codex model
#   hafleet-up ops ~/laplace/ops codex --extra-args "--search"                # custom non-policy args

set -euo pipefail

_resolve_script_dir() {
  local src="$0"
  while [ -L "$src" ]; do
    local dir
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
  done
  cd -P "$(dirname "$src")" && pwd
}
SCRIPT_DIR="$(_resolve_script_dir)"
BASE_DIR="$(dirname "$SCRIPT_DIR")"
DATA_DIR=""
LAUNCH_POLICY_CHECK="$BASE_DIR/scripts/validate-agent-launch-extra-args.js"
SANDBOX_ROOTS_RESOLVER="$BASE_DIR/scripts/resolve-agent-sandbox-roots.js"
FRAMEWORK_INFO="$BASE_DIR/scripts/framework-info.js"
# Read once: the parser consults this per argument, and node startup is not free.
KNOWN_FRAMEWORK_IDS="$(node "$FRAMEWORK_INFO" ids 2>/dev/null || printf 'claude\ncodex\n')"
is_known_framework() {
  local candidate="$1" id
  for id in $KNOWN_FRAMEWORK_IDS; do
    [ "$id" = "$candidate" ] && return 0
  done
  return 1
}
CODEX_APPROVAL_HOOK="$BASE_DIR/lib/codex-permission-hook.js"
CODEX_HOOK_TRUST_PREFLIGHT="$BASE_DIR/lib/codex-hook-trust.js"
CODEX_PROJECT_TRUST_HELPER="$BASE_DIR/lib/codex-project-trust.js"

# Load .env if present
ENV_FILE="$BASE_DIR/.env"
if [ -f "$ENV_FILE" ]; then
  set -a
  source "$ENV_FILE"
  set +a
fi
RUNTIME_DIR="${HAFLEET_RUNTIME_DIR:-$BASE_DIR}"
DATA_DIR="$RUNTIME_DIR/data/agents"

# If runtime dir differs from base dir, also load runtime's .env
# (overrides base — runtime has the correct port for its deployment).
if [ "$RUNTIME_DIR" != "$BASE_DIR" ] && [ -f "$RUNTIME_DIR/.env" ]; then
  set -a
  source "$RUNTIME_DIR/.env"
  set +a
fi

BACKEND_PORT_RAW="${HAFLEET_BACKEND_PORT:-8090}"
if [[ "$BACKEND_PORT_RAW" =~ ^[0-9]+$ ]] && [ "$BACKEND_PORT_RAW" -gt 0 ]; then
  BACKEND_PORT="$BACKEND_PORT_RAW"
else
  BACKEND_PORT="8090"
fi
BACKEND_URL="${HAFLEET_API:-http://127.0.0.1:$BACKEND_PORT}"
MCP_SERVER_NAME="${HAFLEET_MCP_SERVER_NAME:-hafleet}"
if [ -z "${MCP_SERVER_NAME// }" ]; then
  MCP_SERVER_NAME="hafleet"
fi
SERVER_ID="${HAFLEET_SERVER:-}"
API_TOKEN="${API_TOKEN:-}"
AGENT_SCOPE_ENABLE_RAW="${AGENT_SCOPE_ENABLE:-1}"
AGENT_SCOPE_MEMORY_HIGH_MB_RAW="${AGENT_SCOPE_MEMORY_HIGH_MB:-0}"
AGENT_SCOPE_MEMORY_MAX_MB_RAW="${AGENT_SCOPE_MEMORY_MAX_MB:-0}"
AGENT_SCOPE_MEMORY_SWAP_MAX_MB_RAW="${AGENT_SCOPE_MEMORY_SWAP_MAX_MB:-0}"

# Auth header for API calls
AUTH_HEADER=""
[ -n "$API_TOKEN" ] && AUTH_HEADER="Authorization: Bearer $API_TOKEN"

usage() {
  cat <<'USAGE'
Usage: hafleet-up <name> [path] [claude|codex] [--fresh] [--attach] [--allow-shared-workspace] [--model <model>] [--extra-args "<args>"]

  name         tmux session name / agent name
  path         working directory (optional if previously saved)
  type         claude (default) or codex
  --fresh      ignore saved resume ID, start a new session
  --attach     attach to the session after creating it
  --allow-shared-workspace allow launching when another agent already uses the same path
  --model      model name passed to claude/codex at startup
  --extra-args additional startup args; permission-policy overrides are rejected
USAGE
}

# The agent's state directory, where <state>/agent-token lives.
#
# Metadata only carries an explicit state dir for v1 agents (`up-v1`). For an
# agent created by plain `hafleet up` it is empty, and callers that treated
# "empty" as "omit the variable" left the MCP server unable to find the token —
# so with HAFLEET_AGENT_TOKEN_MODE=hard every call the agent made was rejected
# and its inbox never drained, with nothing said in the agent's own pane.
# Derived in one place so the MCP config, the Codex env injection and the token
# preflight cannot disagree about where the token is.
resolve_agent_state_dir() {
  printf '%s' "${SAVED_STATE_DIR:-${HAFLEET_HOMEDIR:-$HOME/.hafleet}/agents/agent_${NAME}/state}"
}

# The agent's own token, when this host has provisioned one.
#
# Needed because the agent-scoped routes are guarded by `requireAgentToken`, which demands
# X-Agent-Token as soon as a token is LOADED for that agent — the operator bearer does not
# substitute for it. Without this header `POST /api/agents` answered 403 every time for a managed
# agent, the framework in the payload ("codex") never landed, and the agent ended up registered by
# its own MCP server as the generic type "agent". That is not cosmetic: seatIdentity() reads
# agent.type as the framework, so the seat resolved to credentialHome `~/.agent` and every
# framework collapsed into one seat, defeating the over-subscription accounting seats exist for.
agent_token_header() {
  local state_dir token_file token
  # Defence in depth. resolve_agent_state_dir is now defined immediately above, because it USED to
  # live ~1300 lines below and register_backend_agent (line ~1371) ran first — so the header came
  # out empty, registration 403'd, and the framework was lost. Order matters for calls, not
  # definitions; the guard stays in case a future edit moves either one again.
  declare -F resolve_agent_state_dir >/dev/null 2>&1 || return 0
  state_dir="$(resolve_agent_state_dir)"
  token_file="$state_dir/agent-token"
  [ -s "$token_file" ] || return 0
  token="$(tr -d '\r\n' < "$token_file" 2>/dev/null || true)"
  [ -n "$token" ] || return 0
  printf 'X-Agent-Token: %s' "$token"
}

api_curl() {
  local agent_header
  agent_header="$(agent_token_header)"
  local -a extra=()
  [ -n "$AUTH_HEADER" ] && extra+=(-H "$AUTH_HEADER")
  [ -n "$agent_header" ] && extra+=(-H "$agent_header")
  curl --noproxy '*' -s "${extra[@]}" "$@"
}

url_encode() {
  python3 - "$1" <<'PY'
import sys
import urllib.parse
print(urllib.parse.quote(sys.argv[1], safe=""))
PY
}

resolve_agent_name_backend() {
  local raw="$1"
  local encoded payload
  encoded="$(url_encode "$raw")"
  payload="$(api_curl "$BACKEND_URL/api/agents/$encoded" 2>/dev/null || true)"
  [ -n "$payload" ] || return 0
  RAW_NAME="$raw" PAYLOAD="$payload" python3 - <<'PY' 2>/dev/null || true
import json
import os

raw = os.environ.get("RAW_NAME", "").strip()
payload = os.environ.get("PAYLOAD", "")
if not raw or not payload:
    raise SystemExit(0)
try:
    obj = json.loads(payload)
except Exception:
    raise SystemExit(0)
if isinstance(obj, dict) and not obj.get("error"):
    name = str(obj.get("name") or "").strip()
    if name and name.lower() == raw.lower():
        print(name)
PY
}

resolve_agent_name_tmux() {
  local raw="$1"
  local sessions
  sessions="$(tmux list-sessions -F '#{session_name}' 2>/dev/null || true)"
  [ -n "$sessions" ] || return 0
  RAW_NAME="$raw" TMUX_SESSIONS="$sessions" python3 - <<'PY' 2>/dev/null || true
import os

raw = os.environ.get("RAW_NAME", "").strip()
sessions = os.environ.get("TMUX_SESSIONS", "")
if not raw or not sessions:
    raise SystemExit(0)
matches = []
for line in sessions.splitlines():
    name = line.strip()
    if name and name.lower() == raw.lower():
        matches.append(name)
seen = []
for name in matches:
    if name not in seen:
        seen.append(name)
for name in seen:
    print(name)
PY
}

resolve_agent_name_data_dir() {
  local raw="$1"
  local dirs=""
  if [ -d "$DATA_DIR" ]; then
    local d
    for d in "$DATA_DIR"/*; do
      [ -d "$d" ] || continue
      dirs="${dirs}$(basename "$d")"$'\n'
    done
  fi
  [ -n "$dirs" ] || return 0
  RAW_NAME="$raw" AGENT_DIR_NAMES="$dirs" python3 - <<'PY' 2>/dev/null || true
import os

raw = os.environ.get("RAW_NAME", "").strip()
dirs = os.environ.get("AGENT_DIR_NAMES", "")
if not raw or not dirs:
    raise SystemExit(0)
matches = []
for line in dirs.splitlines():
    name = line.strip()
    if name and name.lower() == raw.lower():
        matches.append(name)
seen = []
for name in matches:
    if name not in seen:
        seen.append(name)
for name in seen:
    print(name)
PY
}

resolve_agent_name_casefold() {
  local raw="$1"
  local backend_name tmux_names data_names candidates resolved
  backend_name="$(resolve_agent_name_backend "$raw")"
  tmux_names="$(resolve_agent_name_tmux "$raw")"
  data_names="$(resolve_agent_name_data_dir "$raw")"

  candidates=""
  [ -n "$backend_name" ] && candidates="${candidates}${backend_name}"$'\n'
  [ -n "$tmux_names" ] && candidates="${candidates}${tmux_names}"$'\n'
  [ -n "$data_names" ] && candidates="${candidates}${data_names}"$'\n'

  resolved="$(RAW_NAME="$raw" CANDIDATES="$candidates" python3 - <<'PY'
import os
import sys

raw = os.environ.get("RAW_NAME", "").strip()
candidates = os.environ.get("CANDIDATES", "")
if not raw:
    print("")
    raise SystemExit(0)

seen = []
for line in candidates.splitlines():
    name = line.strip()
    if not name:
        continue
    if name.lower() != raw.lower():
        continue
    if name not in seen:
        seen.append(name)

if len(seen) <= 1:
    print(seen[0] if seen else raw)
    raise SystemExit(0)

print(f"conflict:{','.join(seen)}")
raise SystemExit(3)
PY
)"
  if [[ "$resolved" == conflict:* ]]; then
    echo "Error: case-conflicting agent names detected for '$raw': ${resolved#conflict:}" >&2
    echo "Refusing to continue. Keep only one canonical case variant." >&2
    exit 1
  fi
  echo "$resolved"
}

# Helper: post lifecycle event to info group
post_lifecycle() {
  local event_summary="$1"
  local event_full="${2:-$1}"
  local summary_json full_json
  summary_json=$(EVENT_SUMMARY="$event_summary" python3 - <<'PY'
import json, os
print(json.dumps(os.environ["EVENT_SUMMARY"]))
PY
)
  full_json=$(EVENT_FULL="$event_full" python3 - <<'PY'
import json, os
print(json.dumps(os.environ["EVENT_FULL"]))
PY
)
  api_curl -X POST "$BACKEND_URL/api/messages" \
    -H 'Content-Type: application/json' \
    -d "{\"from\":\"system\",\"group\":\"info\",\"type\":\"inform\",\"summary\":${summary_json},\"full\":${full_json},\"mentions\":[]}" \
    >/dev/null 2>&1 || true
}

register_backend_agent() {
  local payload
  payload=$(NAME="$NAME" TYPE="$TYPE" TMUX="${NAME}:0.0" SERVER="$SERVER_ID" \
    AGENT_MODEL_VERSION="${SAVED_AGENT_MODEL_VERSION:-}" \
    AGENT_LAYOUT_VERSION="${SAVED_LAYOUT_VERSION:-}" \
    AGENT_ID="${SAVED_AGENT_ID:-}" \
    AGENT_HOME_DIR="${SAVED_HOME_DIR:-}" \
    AGENT_WORKDIR="${SAVED_WORKDIR:-}" \
    AGENT_STATE_DIR="${SAVED_STATE_DIR:-}" \
    python3 - <<'PY'
import json
import os

server = os.environ.get("SERVER", "").strip() or None
def parse_int(text):
    try:
        n = int(str(text or "").strip())
        return n if n > 0 else None
    except Exception:
        return None

def parse_bool(text):
    t = str(text or "").strip().lower()
    if t in ("1", "true", "yes", "on"):
        return True
    if t in ("0", "false", "no", "off"):
        return False
    return None

def parse_abs(text):
    value = str(text or "").strip()
    if value and value.startswith("/"):
        return value
    return None

payload = {
    "name": os.environ["NAME"],
    "type": os.environ["TYPE"],
    "tmux": os.environ["TMUX"],
    "server": server,
    "manualDown": False,
}
agent_model_version = str(os.environ.get("AGENT_MODEL_VERSION", "")).strip()
if agent_model_version:
    payload["agentModelVersion"] = agent_model_version

layout_version = parse_int(os.environ.get("AGENT_LAYOUT_VERSION", ""))
if layout_version is not None:
    payload["layoutVersion"] = layout_version

agent_id = str(os.environ.get("AGENT_ID", "")).strip()
if agent_id:
    payload["agentId"] = agent_id

home_dir = parse_abs(os.environ.get("AGENT_HOME_DIR", ""))
workdir = parse_abs(os.environ.get("AGENT_WORKDIR", ""))
state_dir = parse_abs(os.environ.get("AGENT_STATE_DIR", ""))
if home_dir:
    payload["homeDir"] = home_dir
if workdir:
    payload["workdir"] = workdir
if state_dir:
    payload["stateDir"] = state_dir


print(json.dumps(payload))
PY
)
  # STATUS, not exit code. `curl -s` exits 0 for any HTTP response it receives, so testing
  # `if api_curl ...` reported success on 403, 404 and 500 alike — with the body sent to
  # /dev/null, so the reason was unrecoverable too. This route is agent-token guarded
  # (`requireAgentToken`), and the launcher sends only the operator bearer, so a managed agent
  # whose token is already loaded answers 403 here EVERY time and printed
  # "Registered online" anyway. The agent's own MCP server registers it a moment later, which
  # is why nobody noticed: the message was wrong and the outcome was right.
  local reg_body reg_status
  # GNU mktemp requires at least three Xs in the template; supplying the full
  # path also works on BSD/macOS without relying on their different `-t` form.
  reg_body="$(mktemp "${TMPDIR:-/tmp}/hafleet-reg.XXXXXX")"
  # No `|| echo 000` here: curl -w ALREADY prints 000 when it cannot connect, and the fallback
  # appended a second one, yielding "000000" — which matched no case and reported an unreachable
  # backend as "refused HTTP 000000". Caught by exercising the branch instead of assuming it.
  reg_status="$(api_curl -o "$reg_body" -w '%{http_code}' -X POST "$BACKEND_URL/api/agents" \
    -H 'Content-Type: application/json' \
    -d "$payload" 2>/dev/null)" || true
  [ -n "$reg_status" ] || reg_status=000
  case "$reg_status" in
    2??)
      echo "Registered '$NAME' online in backend."
      ;;
    000)
      echo "Warning: could not reach the backend at $BACKEND_URL to register '$NAME' (heartbeat may backfill)." >&2
      ;;
    *)
      # Quoted, because the reason is the actionable part — "agent token required but not
      # provided" tells an operator something entirely different from a 500.
      echo "Warning: backend refused registration of '$NAME' with HTTP $reg_status: $(head -c 200 "$reg_body" 2>/dev/null)" >&2
      echo "  The agent's own MCP heartbeat may still register it; check with: hafleet ls" >&2
      ;;
  esac
  rm -f "$reg_body" 2>/dev/null || true
}

REPO_DIR="$(dirname "$BASE_DIR")"
run_update_check() {
  if [ -d "$REPO_DIR/.git" ]; then
    echo "Checking updates before hafleet-up..."
    (
      cd "$REPO_DIR" || exit 0
      if ! git fetch origin --quiet 2>/dev/null; then
        echo "Warning: update check failed (git fetch origin). Continuing hafleet-up." >&2
        exit 0
      fi
      LOCAL=$(git rev-parse HEAD 2>/dev/null | tr -d '[:space:]' || true)
      TRACK_REF=""
      _deploy_branch="${HAFLEET_DEPLOY_BRANCH:-}"
      if [ -n "$_deploy_branch" ]; then
        REMOTE=$(git rev-parse "origin/$_deploy_branch" 2>/dev/null || true)
        [ -n "$REMOTE" ] && TRACK_REF="origin/$_deploy_branch"
      fi
      if [ -z "$TRACK_REF" ]; then
        for _b in stable main master; do
          REMOTE=$(git rev-parse "origin/$_b" 2>/dev/null || true)
          if [ -n "$REMOTE" ]; then TRACK_REF="origin/$_b"; break; fi
        done
      fi
      REMOTE=$(echo "$REMOTE" | tr -d '[:space:]')
      if [ -z "$LOCAL" ] || [ -z "$REMOTE" ] || [ -z "$TRACK_REF" ]; then
        echo "Warning: update check could not resolve repository refs. Continuing hafleet-up." >&2
        exit 0
      fi
      if [ "$LOCAL" = "$REMOTE" ]; then
        echo "Update check: up to date."
        exit 0
      fi
      BEHIND=$(git rev-list --count "HEAD..$TRACK_REF" 2>/dev/null || echo "0")
      BEHIND=$(echo "$BEHIND" | tr -d '[:space:]')
      if [ "$BEHIND" -gt 0 ] 2>/dev/null; then
        echo "Updates available ($BEHIND commits behind). Run 'hafleet-update' to install."
      else
        AHEAD=$(git rev-list --count "$TRACK_REF..HEAD" 2>/dev/null || echo "0")
        AHEAD=$(echo "$AHEAD" | tr -d '[:space:]')
        if [ "$AHEAD" -gt 0 ] 2>/dev/null; then
          echo "Update check: local branch is ahead of $TRACK_REF ($AHEAD commits)."
        else
          echo "Update check: local and $TRACK_REF diverged."
        fi
      fi
    )
  else
    echo "Update check: skipped (no git repository at $REPO_DIR)."
  fi
}

# ── Parse args ────────────────────────────────────────────────────────
for arg in "$@"; do
  if [ "$arg" = "-h" ] || [ "$arg" = "--help" ]; then
    usage
    exit 0
  fi
done

if [ $# -lt 1 ]; then
  usage >&2
  exit 1
fi

if [[ "$1" == -* ]]; then
  echo "Error: missing agent name." >&2
  usage >&2
  exit 1
fi

RAW_NAME="$1"
NAME="$(resolve_agent_name_casefold "$RAW_NAME")"
shift
if [ "$NAME" != "$RAW_NAME" ]; then
  echo "Resolved agent name '$RAW_NAME' -> '$NAME'"
fi
TMUX_TARGET="=${NAME}"
TMUX_PANE_TARGET="=${NAME}:0.0"

FRESH=false
ATTACH=false
ALLOW_SHARED_WORKSPACE=false
AGENT_PATH=""
TYPE=""
MODEL=""
EXTRA_ARGS=""

while [ $# -gt 0 ]; do
  case "$1" in
    --fresh)
      FRESH=true
      shift
      ;;
    --attach)
      ATTACH=true
      shift
      ;;
    --allow-shared-workspace)
      ALLOW_SHARED_WORKSPACE=true
      shift
      ;;
    --model)
      if [ $# -lt 2 ]; then
        echo "Error: --model requires a value" >&2
        exit 1
      fi
      MODEL="$2"
      shift 2
      ;;
    --extra-args)
      if [ $# -lt 2 ]; then
        echo "Error: --extra-args requires a value" >&2
        exit 1
      fi
      EXTRA_ARGS="$2"
      shift 2
      ;;
    *)
      # A bare token naming a declared framework is the type. The list comes from
      # lib/frameworks/, so a new adapter is recognised here without editing this
      # parser — including one that is declared but not yet launchable, which the
      # gate below then refuses by name instead of calling it unrecognized.
      if is_known_framework "$1"; then
        TYPE="$1"
        shift
      elif [ -z "$AGENT_PATH" ]; then
        AGENT_PATH="$1"
        shift
      else
        echo "Error: unrecognized argument '$1'" >&2
        exit 1
      fi
      ;;
  esac
done

# ── Load saved meta ──────────────────────────────────────────────────
AGENT_DATA="$DATA_DIR/$NAME"
META_FILE="$AGENT_DATA/meta.json"
RESUME_FILE="$AGENT_DATA/resume-id"
TMP_RUNTIME_DIR="$AGENT_DATA/tmp"
MANAGED_RUNTIME_PID_FILE="$AGENT_DATA/managed-runtime.pid"

# Auto-detect first-time agent: no meta AND no resume-id => fresh start.
# If resume-id already exists (e.g. recovered via hafleet-down), keep resume path.
if [ ! -f "$META_FILE" ] && [ "$FRESH" = false ] && [ ! -f "$RESUME_FILE" ]; then
  FRESH=true
# v1 agent: up-v1 pre-creates meta.json + dangling resume-id symlink before first launch.
# Detect this case: symlink exists but target is missing → treat as fresh.
elif [ "$FRESH" = false ] && [ ! -f "$RESUME_FILE" ] && [ -L "$RESUME_FILE" ]; then
  FRESH=true
fi

SAVED_PATH=""
SAVED_TYPE=""
SAVED_MODEL=""
SAVED_EXTRA_ARGS=""
SAVED_SESSION_ID=""
SAVED_AGENT_MODEL_VERSION=""
SAVED_LAYOUT_VERSION=""
SAVED_AGENT_ID=""
SAVED_HOME_DIR=""
SAVED_WORKDIR=""
SAVED_STATE_DIR=""
SAVED_RUNTIME_PROFILE_PRIMARY_FRAMEWORK=""
SAVED_RUNTIME_PROFILE_PRIMARY_MODEL=""
SAVED_RUNTIME_PROFILE_PRIMARY_EXTRA_ARGS=""
SAVED_RUNTIME_PROFILE_PRIMARY_JSON=""
SAVED_RUNTIME_PROFILE_SUPERVISOR_PROVIDER=""
SAVED_RUNTIME_PROFILE_SUPERVISOR_MODEL=""
SAVED_RUNTIME_PROFILE_SUPERVISOR_REASONING=""
SAVED_RUNTIME_PROFILE_SUPERVISOR_FRAMEWORK=""
SAVED_RUNTIME_PROFILE_SUPERVISOR_EXTRA_ARGS=""
SAVED_RUNTIME_PROFILE_SUPERVISOR_JSON=""
if [ -f "$META_FILE" ]; then
  SAVED_PATH=$(python3 -c "import json; d=json.load(open('$META_FILE')); print(d.get('path',''))" 2>/dev/null || true)
  SAVED_TYPE=$(python3 -c "import json; d=json.load(open('$META_FILE')); print(d.get('type',''))" 2>/dev/null || true)
  SAVED_MODEL=$(python3 -c "import json; d=json.load(open('$META_FILE')); print(d.get('model',''))" 2>/dev/null || true)
  SAVED_EXTRA_ARGS=$(python3 -c "import json; d=json.load(open('$META_FILE')); print(d.get('extraArgs',''))" 2>/dev/null || true)
  SAVED_SESSION_ID=$(python3 -c "import json; d=json.load(open('$META_FILE')); print(d.get('sessionId',''))" 2>/dev/null || true)
  SAVED_AGENT_MODEL_VERSION=$(python3 -c "import json; d=json.load(open('$META_FILE')); print(d.get('agentModelVersion',''))" 2>/dev/null || true)
  SAVED_LAYOUT_VERSION=$(python3 -c "import json; d=json.load(open('$META_FILE')); print(d.get('layoutVersion',''))" 2>/dev/null || true)
  SAVED_AGENT_ID=$(python3 -c "import json; d=json.load(open('$META_FILE')); print(d.get('agentId',''))" 2>/dev/null || true)
  SAVED_HOME_DIR=$(python3 -c "import json; d=json.load(open('$META_FILE')); print(d.get('homeDir',''))" 2>/dev/null || true)
  SAVED_WORKDIR=$(python3 -c "import json; d=json.load(open('$META_FILE')); print(d.get('workdir',''))" 2>/dev/null || true)
  SAVED_STATE_DIR=$(python3 -c "import json; d=json.load(open('$META_FILE')); print(d.get('stateDir',''))" 2>/dev/null || true)
  SAVED_RUNTIME_PROFILE_PRIMARY_FRAMEWORK=$(python3 -c "import json; d=json.load(open('$META_FILE')); print((((d.get('runtimeProfile') or {}).get('primary') or {}).get('framework')) or '')" 2>/dev/null || true)
  SAVED_RUNTIME_PROFILE_PRIMARY_MODEL=$(python3 -c "import json; d=json.load(open('$META_FILE')); print((((d.get('runtimeProfile') or {}).get('primary') or {}).get('model')) or '')" 2>/dev/null || true)
  SAVED_RUNTIME_PROFILE_PRIMARY_EXTRA_ARGS=$(python3 -c "import json; d=json.load(open('$META_FILE')); print((((d.get('runtimeProfile') or {}).get('primary') or {}).get('extraArgs')) or '')" 2>/dev/null || true)
  SAVED_RUNTIME_PROFILE_PRIMARY_API_BASE_URL=$(python3 -c "import json; d=json.load(open('$META_FILE')); print((((d.get('runtimeProfile') or {}).get('primary') or {}).get('apiBaseUrl')) or '')" 2>/dev/null || true)
  SAVED_RUNTIME_PROFILE_PRIMARY_API_KEY=$(python3 -c "import json; d=json.load(open('$META_FILE')); print((((d.get('runtimeProfile') or {}).get('primary') or {}).get('apiKey')) or '')" 2>/dev/null || true)
  SAVED_RUNTIME_PROFILE_SUPERVISOR_PROVIDER=$(python3 -c "import json; d=json.load(open('$META_FILE')); print((((d.get('runtimeProfile') or {}).get('supervisor') or {}).get('provider')) or '')" 2>/dev/null || true)
  SAVED_RUNTIME_PROFILE_SUPERVISOR_MODEL=$(python3 -c "import json; d=json.load(open('$META_FILE')); print((((d.get('runtimeProfile') or {}).get('supervisor') or {}).get('model')) or '')" 2>/dev/null || true)
  SAVED_RUNTIME_PROFILE_SUPERVISOR_REASONING=$(python3 -c "import json; d=json.load(open('$META_FILE')); print((((d.get('runtimeProfile') or {}).get('supervisor') or {}).get('reasoning')) or '')" 2>/dev/null || true)
  SAVED_RUNTIME_PROFILE_SUPERVISOR_FRAMEWORK=$(python3 -c "import json; d=json.load(open('$META_FILE')); print((((d.get('runtimeProfile') or {}).get('supervisor') or {}).get('framework')) or '')" 2>/dev/null || true)
  SAVED_RUNTIME_PROFILE_SUPERVISOR_EXTRA_ARGS=$(python3 -c "import json; d=json.load(open('$META_FILE')); print((((d.get('runtimeProfile') or {}).get('supervisor') or {}).get('extraArgs')) or '')" 2>/dev/null || true)
  SAVED_RUNTIME_PROFILE_PRIMARY_JSON=$(python3 -c "import json; d=json.load(open('$META_FILE')); v=((d.get('runtimeProfile') or {}).get('primary')); print(json.dumps(v, separators=(',',':')) if isinstance(v, dict) else '')" 2>/dev/null || true)
  SAVED_RUNTIME_PROFILE_SUPERVISOR_JSON=$(python3 -c "import json; d=json.load(open('$META_FILE')); v=((d.get('runtimeProfile') or {}).get('supervisor')); print(json.dumps(v, separators=(',',':')) if isinstance(v, dict) else '')" 2>/dev/null || true)
fi


# Apply defaults from meta
[ -z "$AGENT_PATH" ] && AGENT_PATH="$SAVED_PATH"
[ -z "$TYPE" ] && TYPE="${SAVED_TYPE:-claude}"
[ -z "$TYPE" ] && TYPE="claude"
[ -n "${SAVED_RUNTIME_PROFILE_PRIMARY_FRAMEWORK:-}" ] && [[ "$SAVED_RUNTIME_PROFILE_PRIMARY_FRAMEWORK" == "claude" || "$SAVED_RUNTIME_PROFILE_PRIMARY_FRAMEWORK" == "codex" ]] && TYPE="$SAVED_RUNTIME_PROFILE_PRIMARY_FRAMEWORK"
[ -z "$MODEL" ] && MODEL="${HAFLEET_LAUNCH_MODEL:-${SAVED_RUNTIME_PROFILE_PRIMARY_MODEL:-$SAVED_MODEL}}"
[ -z "$EXTRA_ARGS" ] && EXTRA_ARGS="${HAFLEET_LAUNCH_EXTRA_ARGS:-${SAVED_RUNTIME_PROFILE_PRIMARY_EXTRA_ARGS:-$SAVED_EXTRA_ARGS}}"
# Strip context-length suffix (e.g. [1m], [200k]) — hafleet metadata, not API model name
MODEL="${MODEL%%\[*\]}"

# ── Auto-resolve path when meta is missing ──────────────────────────
# Try additional sources: v1 agent home manifest, then backend API.
if [ -z "$AGENT_PATH" ]; then
  _v1_home="${HAFLEET_HOMEDIR:-$HOME/.hafleet}/agents/agent_${NAME}"
  if [ -f "$_v1_home/agent.json" ]; then
    AGENT_PATH=$(_V1_MANIFEST="$_v1_home/agent.json" python3 -c "
import json, os
d = json.load(open(os.environ['_V1_MANIFEST']))
print(d.get('workdir') or '')
" 2>/dev/null || true)
  fi
fi
if [ -z "$AGENT_PATH" ]; then
  _enc_name=$(url_encode "$NAME")
  _api_detail=$(api_curl "$BACKEND_URL/api/agents/$_enc_name" 2>/dev/null || true)
  if [ -n "$_api_detail" ]; then
    AGENT_PATH=$(printf '%s' "$_api_detail" | python3 -c "
import json, sys
d = json.load(sys.stdin)
print(d.get('workdir') or d.get('homeDir') or d.get('path') or '')
" 2>/dev/null || true)
  fi
fi

# Validate
if [ -z "$AGENT_PATH" ]; then
  echo "Error: no path specified and no saved meta for '$NAME'" >&2
  echo "Usage: hafleet-up <name> <path> [claude|codex]" >&2
  exit 1
fi

AGENT_PATH="$(cd "$AGENT_PATH" 2>/dev/null && pwd -P || echo "$AGENT_PATH")"

if [ ! -d "$AGENT_PATH" ]; then
  echo "Error: path '$AGENT_PATH' does not exist or is not a directory" >&2
  exit 1
fi

if [ ! -f "$FRAMEWORK_INFO" ]; then
  echo "Error: missing framework registry helper: $FRAMEWORK_INFO" >&2
  exit 1
fi

# Which frameworks can be launched is the registry's call, not a list kept here.
# lib/frameworks/<id>.json declares launchable:false with a reason for adapters
# that are described but have no launch branch below — an ACP framework has no
# tmux pane at all — so those fail here with that reason rather than falling
# through into a launch path that does not fit them.
if ! FRAMEWORK_REFUSAL=$(node "$FRAMEWORK_INFO" check "$TYPE" 2>&1); then
  echo "Error: cannot launch type '$TYPE': ${FRAMEWORK_REFUSAL:-refused by the framework registry}" >&2
  echo "Launchable types: $(node "$FRAMEWORK_INFO" launchable 2>/dev/null | tr '\n' ' ')" >&2
  exit 1
fi

if [ ! -f "$LAUNCH_POLICY_CHECK" ]; then
  echo "Error: missing launch policy validator: $LAUNCH_POLICY_CHECK" >&2
  exit 1
fi
if [ ! -f "$SANDBOX_ROOTS_RESOLVER" ]; then
  echo "Error: missing sandbox roots resolver: $SANDBOX_ROOTS_RESOLVER" >&2
  exit 1
fi
if ! SAFE_EXTRA_ARGS=$(node "$LAUNCH_POLICY_CHECK" "$TYPE" "$EXTRA_ARGS" 2>&1); then
  echo "Error: unsafe --extra-args for $TYPE: ${SAFE_EXTRA_ARGS:-rejected by launch policy}" >&2
  exit 1
fi

resolve_managed_project_paths() {
  local resolver_args=(--agent-path "$AGENT_PATH" --home-dir "$HOME")
  local fallback_manifest="${HAFLEET_HOMEDIR:-$HOME/.hafleet}/agents/agent_${NAME}/agent.json"
  if [ -n "${SAVED_HOME_DIR:-}" ]; then
    resolver_args+=(--manifest "$SAVED_HOME_DIR/agent.json")
  fi
  resolver_args+=(--manifest "$fallback_manifest")
  node "$SANDBOX_ROOTS_RESOLVER" "${resolver_args[@]}"
}

MANAGED_PROJECT_PATHS="$(resolve_managed_project_paths)"

run_update_check

normalize_real_path() {
  local p="$1"
  python3 - "$p" <<'PY'
import os
import sys

raw = (sys.argv[1] if len(sys.argv) > 1 else "").strip()
if not raw:
    print("")
    raise SystemExit(0)
print(os.path.realpath(raw))
PY
}

find_workspace_conflicts() {
  local expected="$1"
  local sessions s pane_path pane_real conflicts
  conflicts=""
  sessions="$(tmux list-sessions -F '#{session_name}' 2>/dev/null || true)"
  [ -n "$sessions" ] || return 0
  while IFS= read -r s; do
    [ -n "$s" ] || continue
    [ "$s" = "$NAME" ] && continue
    pane_path="$(tmux display-message -p -t "=${s}:0.0" "#{pane_current_path}" 2>/dev/null || true)"
    [ -n "$pane_path" ] || continue
    pane_real="$(normalize_real_path "$pane_path")"
    if [ "$pane_real" = "$expected" ]; then
      conflicts="${conflicts}${s}"$'\n'
    fi
  done <<< "$sessions"
  printf '%s' "$conflicts"
}

enforce_workspace_uniqueness() {
  local expected="$1"
  local strict="${2:-true}"
  local conflicts
  conflicts="$(find_workspace_conflicts "$expected")"
  [ -n "$conflicts" ] || return 0
  if [ "$ALLOW_SHARED_WORKSPACE" = true ]; then
    echo "Warning: shared workspace allowed for '$NAME' at '$expected'." >&2
    echo "  Existing sessions:" >&2
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      echo "    - $line" >&2
    done <<< "$conflicts"
    return 0
  fi
  if [ "$strict" != true ]; then
    echo "Warning: workspace path '$expected' is already used by other tmux agent session(s) (resume; continuing)." >&2
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      echo "    - $line" >&2
    done <<< "$conflicts"
    return 0
  fi
  echo "Error: workspace path '$expected' is already used by other tmux agent session(s)." >&2
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    echo "  - $line" >&2
  done <<< "$conflicts"
  echo "Refusing launch to prevent cross-agent context bleed." >&2
  echo "Fix options:" >&2
  echo "  1) Launch with a different path." >&2
  echo "  2) Pass --allow-shared-workspace if sharing is intentional." >&2
  exit 1
}

claude_project_dir_for_path() {
  local p="$1"
  [ -n "$p" ] || return 1
  echo "$HOME/.claude/projects/${p//\//-}"
}

is_valid_claude_session_id() {
  local p="$1" sid="$2"
  local d
  [ -n "$sid" ] || return 1
  d=$(claude_project_dir_for_path "$p") || return 1
  [ -f "$d/$sid.jsonl" ]
}

is_valid_uuid() {
  local sid="$1"
  echo "$sid" | grep -qE '^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$'
}

codex_session_file_for_id() {
  local sid="$1"
  local sessions_dir="$HOME/.codex/sessions"
  [ -n "$sid" ] || return 1
  [ -d "$sessions_dir" ] || return 1
  find "$sessions_dir" -type f -name "*${sid}*.jsonl" 2>/dev/null | sort -r | head -1
}

is_valid_codex_session_id_for_path() {
  local expected_path="$1"
  local sid="$2"
  local expected_name="${3:-}"
  local session_file
  [ -n "$expected_path" ] || return 1
  [ -n "$sid" ] || return 1
  session_file="$(codex_session_file_for_id "$sid")"
  [ -n "$session_file" ] || return 1
  EXPECTED_PATH="$expected_path" SESSION_FILE="$session_file" EXPECTED_AGENT_NAME="$expected_name" python3 - <<'PY' >/dev/null 2>&1
import json
import os
import re

expected = os.path.realpath(os.environ.get("EXPECTED_PATH", ""))
session_file = os.environ.get("SESSION_FILE", "")
expected_agent_name = os.environ.get("EXPECTED_AGENT_NAME", "").strip()
if not expected or not session_file:
    raise SystemExit(1)
try:
    with open(session_file, "r", encoding="utf-8") as f:
        first = f.readline().strip()
        prefix = "".join([first] + [f.readline() for _ in range(4000)])
    obj = json.loads(first) if first else {}
except Exception:
    raise SystemExit(1)
payload = obj.get("payload") if isinstance(obj, dict) else None
cwd = str(payload.get("cwd") or "").strip() if isinstance(payload, dict) else ""
if not cwd:
    raise SystemExit(1)
if os.path.realpath(cwd) != expected:
    raise SystemExit(1)
if expected_agent_name:
    # Keep strictness only when a name marker is present in session content.
    # Some manually started codex sessions don't contain this marker at all.
    marker_names = {
        m.group(1).strip()
        for m in re.finditer(r"Your name is ([^.\n]+)\.", prefix)
        if m.group(1).strip()
    }
    if marker_names and expected_agent_name not in marker_names:
        raise SystemExit(1)
raise SystemExit(0)
PY
}

generate_uuid() {
  python3 - <<'PY'
import uuid
print(uuid.uuid4())
PY
}

have_cmd() {
  command -v "$1" >/dev/null 2>&1
}

normalize_mb_value() {
  local raw="$1"
  if [[ "$raw" =~ ^[0-9]+$ ]] && [ "$raw" -gt 0 ]; then
    echo "$raw"
  else
    echo "0"
  fi
}

scope_unit_for_agent() {
  local name="$1"
  local clean
  clean="$(printf '%s' "$name" | sed -E 's/[^A-Za-z0-9_-]+/-/g; s/^-+//; s/-+$//')"
  [ -n "$clean" ] || clean="agent"
  echo "agent-${clean}.scope"
}

AGENT_SCOPE_ENABLE_LC="$(printf '%s' "$AGENT_SCOPE_ENABLE_RAW" | tr '[:upper:]' '[:lower:]')"
AGENT_SCOPE_ENABLE="0"
if [ "$AGENT_SCOPE_ENABLE_RAW" != "0" ] && [ "$AGENT_SCOPE_ENABLE_LC" != "false" ]; then
  AGENT_SCOPE_ENABLE="1"
fi
AGENT_SCOPE_MEMORY_HIGH_MB="$(normalize_mb_value "$AGENT_SCOPE_MEMORY_HIGH_MB_RAW")"
AGENT_SCOPE_MEMORY_MAX_MB="$(normalize_mb_value "$AGENT_SCOPE_MEMORY_MAX_MB_RAW")"
AGENT_SCOPE_MEMORY_SWAP_MAX_MB="$(normalize_mb_value "$AGENT_SCOPE_MEMORY_SWAP_MAX_MB_RAW")"
SCOPE_UNIT=""
declare -a AGENT_SCOPE_LIMIT_PROPERTIES=()
if [ "$AGENT_SCOPE_MEMORY_HIGH_MB" -gt 0 ]; then
  AGENT_SCOPE_LIMIT_PROPERTIES+=("MemoryHigh=${AGENT_SCOPE_MEMORY_HIGH_MB}M")
fi
if [ "$AGENT_SCOPE_MEMORY_MAX_MB" -gt 0 ]; then
  AGENT_SCOPE_LIMIT_PROPERTIES+=("MemoryMax=${AGENT_SCOPE_MEMORY_MAX_MB}M")
fi
if [ "$AGENT_SCOPE_MEMORY_SWAP_MAX_MB" -gt 0 ]; then
  AGENT_SCOPE_LIMIT_PROPERTIES+=("MemorySwapMax=${AGENT_SCOPE_MEMORY_SWAP_MAX_MB}M")
fi

extract_resume_hint_from_stream() {
  if have_cmd rg; then
    rg -o 'claude --resume [0-9a-f-]{36}|codex resume [0-9a-f-]{36}'
  else
    grep -Eo 'claude --resume [0-9a-f-]{36}|codex resume [0-9a-f-]{36}'
  fi | tail -1 || true
}

extract_resume_id_from_hint() {
  local hint="$1"
  echo "$hint" | grep -Eo '[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}' | tail -1 || true
}

capture_resume_id_from_pane() {
  local timeout="${1:-120}"
  local i pane_text hint rid
  for ((i = 0; i < timeout; i++)); do
    pane_text=$(tmux capture-pane -t "$TMUX_PANE_TARGET" -p -S -200 2>/dev/null || true)
    hint=$(printf '%s\n' "$pane_text" | extract_resume_hint_from_stream)
    rid=$(extract_resume_id_from_hint "$hint")
    if [ -n "$rid" ]; then
      if ! capture_guard_matches; then
        return 1
      fi
      echo "$rid" > "$RESUME_FILE"
      echo "Captured resume-id from pane output: $rid"
      return 0
    fi
    sleep 1
  done
  return 1
}

capture_resume_id_from_claude_files() {
  local proj_dir newest sid
  proj_dir=$(claude_project_dir_for_path "$AGENT_PATH") || return 1
  [ -d "$proj_dir" ] || return 1
  newest=$(find "$proj_dir" -maxdepth 1 -name "*.jsonl" -type f -mmin -10 2>/dev/null | sort -r | head -1)
  [ -n "$newest" ] || return 1
  sid=$(basename "$newest" .jsonl)
  if echo "$sid" | grep -qE '^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$'; then
    if ! capture_guard_matches; then
      return 1
    fi
    echo "$sid" > "$RESUME_FILE"
    echo "Captured resume-id from Claude session files: $sid"
    return 0
  fi
  return 1
}

capture_resume_id_from_codex_files() {
  local baseline_file="${1:-}"
  local sessions_dir sid
  sessions_dir="$HOME/.codex/sessions"
  [ -d "$sessions_dir" ] || return 1
  sid=$(SESSIONS_DIR="$sessions_dir" BASELINE_FILE="$baseline_file" AGENT_PATH_EXPECTED="$AGENT_PATH" AGENT_NAME_EXPECTED="$NAME" python3 - <<'PY' 2>/dev/null || true
import os
import re
import json

sessions_dir = os.environ["SESSIONS_DIR"]
baseline_file = os.environ.get("BASELINE_FILE", "")
expected_cwd = os.environ.get("AGENT_PATH_EXPECTED", "")
expected_agent_name = os.environ.get("AGENT_NAME_EXPECTED", "").strip()
uuid_re = re.compile(r"[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}")

baseline = set()
if baseline_file and os.path.exists(baseline_file):
    with open(baseline_file) as f:
        baseline = {line.strip() for line in f if line.strip()}

def real(path: str) -> str:
    try:
        return os.path.realpath(path)
    except Exception:
        return path

expected_real = real(expected_cwd) if expected_cwd else ""

def session_matches_expected(path: str) -> bool:
    if not expected_real:
        return True
    try:
        with open(path, "r", encoding="utf-8") as f:
            first = f.readline().strip()
            prefix = "".join([first] + [f.readline() for _ in range(400)])
    except Exception:
        return False
    if not first:
        return False
    try:
        obj = json.loads(first)
    except Exception:
        return False
    payload = obj.get("payload") if isinstance(obj, dict) else None
    cwd = ""
    if isinstance(payload, dict):
        cwd = str(payload.get("cwd") or "").strip()
    if not cwd:
        return False
    if real(cwd) != expected_real:
        return False
    if expected_agent_name:
        marker = f"Your name is {expected_agent_name}."
        if marker not in prefix:
            return False
    return True

candidates = []
for root, _, files in os.walk(sessions_dir):
    for fn in files:
        if not fn.endswith(".jsonl"):
            continue
        path = os.path.join(root, fn)
        m = uuid_re.search(fn) or uuid_re.search(path)
        if not m:
            continue
        sid = m.group(0)
        if sid in baseline:
            continue
        if not session_matches_expected(path):
            continue
        try:
            mtime = os.path.getmtime(path)
        except OSError:
            continue
        candidates.append((mtime, sid))

if candidates:
    candidates.sort(reverse=True)
    print(candidates[0][1])
PY
)
  [ -n "$sid" ] || return 1
  if ! capture_guard_matches; then
    return 1
  fi
  echo "$sid" > "$RESUME_FILE"
  echo "Captured resume-id from Codex session files: $sid"
  return 0
}

snapshot_codex_session_ids() {
  local out_file="$1"
  local sessions_dir
  sessions_dir="$HOME/.codex/sessions"
  if [ ! -d "$sessions_dir" ]; then
    : > "$out_file"
    return 0
  fi
  SESSIONS_DIR="$sessions_dir" python3 - <<'PY' > "$out_file" 2>/dev/null || true
import os
import re

sessions_dir = os.environ["SESSIONS_DIR"]
uuid_re = re.compile(r"[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}")
seen = set()
for root, _, files in os.walk(sessions_dir):
    for fn in files:
        if not fn.endswith(".jsonl"):
            continue
        path = os.path.join(root, fn)
        m = uuid_re.search(fn) or uuid_re.search(path)
        if m:
            seen.add(m.group(0))
for sid in sorted(seen):
    print(sid)
PY
}

capture_resume_id_background() {
  local kind="$1"
  local baseline_file="${2:-}"
  (
    local skip_pane_capture="0"
    # If launcher command is still at shell prompt, skip pane-text capture to avoid stealing
    # unrelated resume hints. Fall back to strict codex session-file matching instead.
    if [ "$kind" = "codex" ]; then
      sleep 2
      local pane_cmd
      pane_cmd=$(tmux display-message -p -t "$TMUX_PANE_TARGET" "#{pane_current_command}" 2>/dev/null || true)
      case "$pane_cmd" in
        codex|node) ;;
        bash|zsh|sh|fish|nu|'')
          skip_pane_capture="1"
          ;;
      esac
    fi
    if [ "$skip_pane_capture" = "0" ] && capture_resume_id_from_pane 150; then
      [ -n "$baseline_file" ] && rm -f "$baseline_file" || true
      exit 0
    fi
    if [ "$kind" = "claude" ]; then
      capture_resume_id_from_claude_files || true
    else
      local i
      for ((i = 0; i < 180; i++)); do
        if capture_resume_id_from_codex_files "$baseline_file"; then
          [ -n "$baseline_file" ] && rm -f "$baseline_file" || true
          exit 0
        fi
        capture_guard_matches || break
        sleep 1
      done
    fi
    [ -n "$baseline_file" ] && rm -f "$baseline_file" || true
  ) &
  disown
}

create_tmux_session() {
  local scope_unit=""
  if [ "$AGENT_SCOPE_ENABLE" = "1" ] && have_cmd systemd-run; then
    scope_unit="$(scope_unit_for_agent "$NAME")"
    local run_args=(--user --scope --unit "$scope_unit")
    local prop
    for prop in "${AGENT_SCOPE_LIMIT_PROPERTIES[@]}"; do
      run_args+=(--property "$prop")
    done
    if systemd-run "${run_args[@]}" tmux new-session -d -s "$NAME" -c "$AGENT_PATH" >/dev/null 2>&1; then
      SCOPE_UNIT="$scope_unit"
      return 0
    fi
    echo "Warning: failed to launch tmux in systemd scope $scope_unit, falling back to plain tmux." >&2
  fi

  tmux new-session -d -s "$NAME" -c "$AGENT_PATH"
  SCOPE_UNIT=""
}

runtime_scope_unit_for_target() {
  local target="$1"
  local pane_pid cgroup unit
  pane_pid="$(tmux display-message -p -t "$target" "#{pane_pid}" 2>/dev/null || true)"
  if ! [[ "$pane_pid" =~ ^[0-9]+$ ]] || [ "$pane_pid" -le 1 ]; then
    return 1
  fi
  cgroup="$(awk -F: 'NR==1{print $3}' "/proc/$pane_pid/cgroup" 2>/dev/null || true)"
  [ -n "$cgroup" ] || return 1
  unit="${cgroup##*/}"
  case "$unit" in
    *.scope) printf '%s\n' "$unit" ;;
    *) return 1 ;;
  esac
}

apply_scope_limits_to_runtime_scope() {
  [ "$AGENT_SCOPE_ENABLE" = "1" ] || return 0
  [ "${#AGENT_SCOPE_LIMIT_PROPERTIES[@]}" -gt 0 ] || return 0
  have_cmd systemctl || return 0

  local attempt runtime_unit
  for attempt in 1 2 3 4 5; do
    runtime_unit="$(runtime_scope_unit_for_target "$TMUX_PANE_TARGET" || true)"
    if [ -n "$runtime_unit" ]; then
      if systemctl --user set-property --runtime "$runtime_unit" "${AGENT_SCOPE_LIMIT_PROPERTIES[@]}" >/dev/null 2>&1; then
        if [ "$runtime_unit" != "$SCOPE_UNIT" ]; then
          echo "  Scope(runtime): $runtime_unit"
        fi
        return 0
      fi
    fi
    sleep 1
  done
  return 1
}

ensure_claude_project_trust() {
  [ "$TYPE" = "claude" ] || return 0
  [ -n "${AGENT_PATH:-}" ] || return 0

  local status
  status="$(
    CLAUDE_JSON_PATH="$HOME/.claude.json" AGENT_PATH="$AGENT_PATH" \
      MCP_SERVER_NAME_VALUE="$MCP_SERVER_NAME" python3 - <<'PY'
import json
import os
import pathlib
import shutil
import tempfile
import time

claude_json_path = pathlib.Path(os.environ["CLAUDE_JSON_PATH"]).expanduser()
agent_path = pathlib.Path(os.environ["AGENT_PATH"]).resolve()
mcp_server_name = os.environ["MCP_SERVER_NAME_VALUE"].strip()
claude_json_path.parent.mkdir(parents=True, exist_ok=True)

if claude_json_path.exists():
    try:
        raw = claude_json_path.read_text(encoding="utf-8")
        data = json.loads(raw) if raw.strip() else {}
    except Exception as exc:
        print(f"error:failed to parse {claude_json_path}: {exc}")
        raise SystemExit(0)
else:
    data = {}

if not isinstance(data, dict):
    print(f"error:{claude_json_path} root must be a JSON object")
    raise SystemExit(0)

projects = data.get("projects")
if not isinstance(projects, dict):
    projects = {}
    data["projects"] = projects

entry = projects.get(str(agent_path))
if not isinstance(entry, dict):
    entry = {}
    projects[str(agent_path)] = entry

changed = False
defaults = {
    "allowedTools": [],
    "mcpContextUris": [],
    "mcpServers": {},
    "enabledMcpjsonServers": [],
    "disabledMcpjsonServers": [],
    "projectOnboardingSeenCount": 0,
    "hasClaudeMdExternalIncludesApproved": False,
    "hasClaudeMdExternalIncludesWarningShown": False,
}
for key, value in defaults.items():
    if key not in entry:
        entry[key] = value
        changed = True

enabled_mcp_servers = entry.get("enabledMcpjsonServers")
if not isinstance(enabled_mcp_servers, list):
    enabled_mcp_servers = []
    entry["enabledMcpjsonServers"] = enabled_mcp_servers
    changed = True
if mcp_server_name and mcp_server_name not in enabled_mcp_servers:
    enabled_mcp_servers.append(mcp_server_name)
    changed = True

disabled_mcp_servers = entry.get("disabledMcpjsonServers")
if not isinstance(disabled_mcp_servers, list):
    disabled_mcp_servers = []
    entry["disabledMcpjsonServers"] = disabled_mcp_servers
    changed = True
if mcp_server_name in disabled_mcp_servers:
    entry["disabledMcpjsonServers"] = [
        name for name in disabled_mcp_servers if name != mcp_server_name
    ]
    changed = True

if entry.get("hasTrustDialogAccepted") is not True:
    entry["hasTrustDialogAccepted"] = True
    changed = True

if entry.get("hasCompletedProjectOnboarding") is not True:
    entry["hasCompletedProjectOnboarding"] = True
    changed = True

if not changed:
    print("already")
    raise SystemExit(0)

backup_dir = claude_json_path.parent / "backups"
backup_dir.mkdir(parents=True, exist_ok=True)
if claude_json_path.exists():
    backup_path = backup_dir / f".claude.json.backup.{int(time.time() * 1000)}"
    shutil.copy2(claude_json_path, backup_path)

with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=str(claude_json_path.parent), delete=False) as handle:
    json.dump(data, handle, indent=2)
    handle.write("\n")
    temp_name = handle.name

os.replace(temp_name, claude_json_path)
print("updated")
PY
  )"
  case "$status" in
    updated)
      echo "Pre-accepted Claude trust for '$AGENT_PATH'."
      ;;
    already)
      ;;
    error:*)
      echo "Warning: failed to pre-accept Claude trust for '$AGENT_PATH': ${status#error:}" >&2
      ;;
    *)
      echo "Warning: unexpected Claude trust status for '$AGENT_PATH': ${status:-empty}" >&2
      ;;
  esac
}

ensure_codex_project_trust() {
  [ "$TYPE" = "codex" ] || return 0
  [ -n "${AGENT_PATH:-}" ] || return 0

  local status
  if ! status="$(node "$CODEX_PROJECT_TRUST_HELPER" \
    --config "$HOME/.codex/config.toml" \
    --cwd "$AGENT_PATH")"; then
    echo "Error: failed to prepare Codex project trust for '$AGENT_PATH'." >&2
    return 1
  fi
  case "$status" in
    updated)
      echo "Pre-accepted Codex trust for '$AGENT_PATH'."
      ;;
    deduplicated)
      echo "Repaired duplicate Codex project trust for '$AGENT_PATH'."
      ;;
    already)
      ;;
    *)
      echo "Error: unexpected Codex trust status for '$AGENT_PATH': ${status:-empty}" >&2
      return 1
      ;;
  esac
}

capture_guard_matches() {
  [ -n "${CAPTURE_GUARD_FILE:-}" ] || return 0
  [ -n "${CAPTURE_GUARD_TOKEN:-}" ] || return 0
  [ -f "$CAPTURE_GUARD_FILE" ] || return 1
  local token_now
  token_now="$(cat "$CAPTURE_GUARD_FILE" 2>/dev/null || true)"
  [ "$token_now" = "$CAPTURE_GUARD_TOKEN" ]
}

SESSION_ID="$SAVED_SESSION_ID"
if [ "$TYPE" = "claude" ]; then
  if [ "$FRESH" = true ]; then
    SESSION_ID=$(generate_uuid)
    mkdir -p "$AGENT_DATA"
    echo "$SESSION_ID" > "$RESUME_FILE"
  elif [ -f "$RESUME_FILE" ]; then
    SESSION_ID=$(cat "$RESUME_FILE" 2>/dev/null || echo "$SESSION_ID")
  elif is_valid_uuid "$SESSION_ID"; then
    echo "$SESSION_ID" > "$RESUME_FILE"
  fi
fi

if [ "$TYPE" = "claude" ] && [ "$FRESH" = false ]; then
  if [ ! -f "$RESUME_FILE" ]; then
    echo "Error: missing resume-id for claude agent '$NAME'." >&2
    echo "Manual check required: inspect archive tail and set resume-id explicitly." >&2
    echo "  tail -n 10 $AGENT_DATA/archive-*.txt" >&2
    echo "  echo '<session-id>' > $RESUME_FILE" >&2
    exit 1
  fi
  RID_CHECK=$(cat "$RESUME_FILE" 2>/dev/null || true)
  if ! is_valid_claude_session_id "$AGENT_PATH" "$RID_CHECK"; then
    if is_valid_uuid "$RID_CHECK" && [ "$RID_CHECK" = "$SESSION_ID" ]; then
      echo "Warning: local Claude session file not found yet; attempting resume with explicit session-id $RID_CHECK."
    else
      echo "Error: resume-id '$RID_CHECK' is not a valid local Claude session file." >&2
      echo "Manual check required: inspect archive tail and fix $RESUME_FILE." >&2
      exit 1
    fi
  fi
fi

# A missing resume-id means one of two very different things, and conflating them made the
# FIRST launch of every codex agent fail with advice that cannot be followed: "inspect archive
# tail" names a history that does not exist yet.
#
#   NEVER RUN — no archive, no resume-id. There is no session to lose, so starting fresh is the
#   only thing it could mean. Proceed, and say so.
#
#   RAN BEFORE — an archive exists but the resume-id is gone. THIS is what the guard is for:
#   starting fresh here silently abandons real history, which is why it stays a hard error
#   rather than a fallback.
if [ "$TYPE" = "codex" ] && [ "$FRESH" = false ] && [ ! -f "$RESUME_FILE" ]; then
  if compgen -G "$AGENT_DATA/archive-*.txt" > /dev/null 2>&1; then
    echo "Error: missing resume-id for codex agent '$NAME', but it has prior sessions." >&2
    echo "Refusing to start fresh: that would abandon the existing history." >&2
    echo "Manual check required: inspect the archive tail and set the resume-id explicitly." >&2
    echo "  tail -n 10 $AGENT_DATA/archive-*.txt" >&2
    echo "  echo '<session-id>' > $RESUME_FILE" >&2
    echo "Or pass --fresh if abandoning that history is what you intend." >&2
    exit 1
  fi
  echo "No prior session for codex agent '$NAME' — starting a fresh one."
  FRESH=true
fi
if [ "$TYPE" = "codex" ] && [ "$FRESH" = false ]; then
  RID_CHECK=$(cat "$RESUME_FILE" 2>/dev/null || true)
  if ! is_valid_uuid "$RID_CHECK"; then
    echo "Error: resume-id '$RID_CHECK' is not a valid UUID for codex agent '$NAME'." >&2
    echo "Manual check required: inspect archive tail and fix $RESUME_FILE." >&2
    exit 1
  fi
  if ! is_valid_codex_session_id_for_path "$AGENT_PATH" "$RID_CHECK" "$NAME"; then
    echo "Error: codex resume-id '$RID_CHECK' does not match path '$AGENT_PATH'." >&2
    echo "Refusing resume to avoid cross-agent context bleed." >&2
    echo "Fix: update $RESUME_FILE with the correct session id for this path." >&2
    exit 1
  fi
fi

# ── Check existing session ───────────────────────────────────────────
managed_runtime_marker_is_live() {
  [ -f "$MANAGED_RUNTIME_PID_FILE" ] || return 1
  local runtime_pid pane_pid cursor_pid
  runtime_pid="$(tr -d '[:space:]' < "$MANAGED_RUNTIME_PID_FILE" 2>/dev/null || true)"
  [[ "$runtime_pid" =~ ^[0-9]+$ ]] || return 1
  kill -0 "$runtime_pid" 2>/dev/null || return 1
  pane_pid="$(tmux display-message -p -t "$TMUX_PANE_TARGET" '#{pane_pid}' 2>/dev/null || true)"
  [[ "$pane_pid" =~ ^[0-9]+$ ]] || return 1
  cursor_pid="$runtime_pid"
  while [[ "$cursor_pid" =~ ^[0-9]+$ ]] && [ "$cursor_pid" -gt 1 ]; do
    [ "$cursor_pid" = "$pane_pid" ] && return 0
    cursor_pid="$(ps -o ppid= -p "$cursor_pid" 2>/dev/null | tr -d ' ' || true)"
  done
  return 1
}

if tmux has-session -t "$TMUX_TARGET" 2>/dev/null; then
  if ! managed_runtime_marker_is_live; then
    echo "Error: tmux session '$NAME' is not running through the managed Agent Chat launcher." >&2
    echo "A manually reopened runtime can lose auto mode or the owner approval adapter." >&2
    echo "Restart it with: bin/hafleet down $(printf '%q' "$NAME") && bin/hafleet up $(printf '%q' "$NAME")" >&2
    exit 1
  fi
  # Keep the backend mapping fresh for a verified managed runtime.
  register_backend_agent
  if [ "$ATTACH" = true ]; then
    exec tmux attach -t "$TMUX_TARGET"
  else
    echo "Session '$NAME' already exists. Refreshed backend mapping."
    echo "Attach with: tmux attach -t $NAME"
    exit 0
  fi
fi

enforce_workspace_uniqueness "$AGENT_PATH" "$FRESH"
ensure_claude_project_trust
ensure_codex_project_trust

# ── Generate per-agent .mcp.json ──────────────────────────────────────
# Bake all required env vars into .mcp.json for Claude Code agents.
# (Codex agents use -c flags instead — see Codex launch section below.)

ensure_agent_mcp_config() {
  local mcp_json="$AGENT_PATH/.mcp.json"
  local mcp_server_js="$BASE_DIR/mcp-server.js"
  if [ ! -f "$mcp_server_js" ]; then
    echo "Warning: mcp-server.js not found at $mcp_server_js, skipping .mcp.json generation" >&2
    return
  fi
  local state_dir
  state_dir="$(resolve_agent_state_dir)"
  MCP_JSON="$mcp_json" MCP_SERVER_JS="$mcp_server_js" MCP_SERVER_NAME="$MCP_SERVER_NAME" \
    AGENT_NAME_VAL="$NAME" BACKEND_URL="$BACKEND_URL" BACKEND_PORT="$BACKEND_PORT" \
    SERVER_ID="$SERVER_ID" STATE_DIR="$state_dir" \
    RUNTIME_DIR_VAL="$RUNTIME_DIR" \
    python3 - <<'PY'
import json
import os

mcp_json = os.environ["MCP_JSON"]
mcp_server_js = os.environ["MCP_SERVER_JS"]
server_name = os.environ.get("MCP_SERVER_NAME", "") or "hafleet"

env = {}
env["AGENT_NAME"] = os.environ.get("AGENT_NAME_VAL", "")
env["HAFLEET_API"] = os.environ.get("BACKEND_URL", "")
env["HAFLEET_BACKEND_PORT"] = os.environ.get("BACKEND_PORT", "")
env["HAFLEET_MCP_SERVER_NAME"] = server_name
server_id = os.environ.get("SERVER_ID", "")
if server_id:
    env["HAFLEET_SERVER"] = server_id
state_dir = os.environ.get("STATE_DIR", "")
if state_dir:
    env["HAFLEET_AGENT_STATE_DIR"] = state_dir
runtime_dir = os.environ.get("RUNTIME_DIR_VAL", "")
if runtime_dir:
    env["HAFLEET_RUNTIME_DIR"] = runtime_dir

# Remove empty values
env = {k: v for k, v in env.items() if v}

config = {
    "mcpServers": {
        server_name: {
            "command": "node",
            "args": [mcp_server_js],
            "env": env,
        }
    }
}

# Merge with existing .mcp.json if present (preserve other servers)
if os.path.exists(mcp_json):
    try:
        with open(mcp_json) as f:
            existing = json.load(f)
        if isinstance(existing.get("mcpServers"), dict):
            existing["mcpServers"][server_name] = config["mcpServers"][server_name]
            config = existing
    except (json.JSONDecodeError, OSError):
        pass

with open(mcp_json, "w") as f:
    json.dump(config, f, indent=2)
    f.write("\n")
PY
  echo "  MCP config: $mcp_json"
}
ensure_agent_mcp_config

