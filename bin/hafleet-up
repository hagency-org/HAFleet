fi
if [ -n "${SAVED_RUNTIME_PROFILE_PRIMARY_API_KEY:-}" ]; then
  write_launch_env "ANTHROPIC_API_KEY" "$SAVED_RUNTIME_PROFILE_PRIMARY_API_KEY"
fi
if [ -n "${SAVED_RUNTIME_PROFILE_SUPERVISOR_JSON:-}" ]; then
  write_launch_env "HAFLEET_RUNTIME_PROFILE_SUPERVISOR_JSON" "$SAVED_RUNTIME_PROFILE_SUPERVISOR_JSON"
fi
if [ -n "${SAVED_RUNTIME_PROFILE_SUPERVISOR_PROVIDER:-}" ]; then
  write_launch_env "SUPERVISOR_LLM_PROVIDER" "$SAVED_RUNTIME_PROFILE_SUPERVISOR_PROVIDER"
fi
if [ -n "${SAVED_RUNTIME_PROFILE_SUPERVISOR_MODEL:-}" ]; then
  write_launch_env "SUPERVISOR_LLM_MODEL" "$SAVED_RUNTIME_PROFILE_SUPERVISOR_MODEL"
fi
if [ -n "${SAVED_RUNTIME_PROFILE_SUPERVISOR_REASONING:-}" ]; then
  write_launch_env "HAFLEET_SUPERVISOR_REASONING_PROFILE" "$SAVED_RUNTIME_PROFILE_SUPERVISOR_REASONING"
fi
if [ -n "${SAVED_RUNTIME_PROFILE_SUPERVISOR_FRAMEWORK:-}" ]; then
  write_launch_env "HAFLEET_SUPERVISOR_FRAMEWORK" "$SAVED_RUNTIME_PROFILE_SUPERVISOR_FRAMEWORK"
fi
if [ -n "${SAVED_RUNTIME_PROFILE_SUPERVISOR_EXTRA_ARGS:-}" ]; then
  write_launch_env "HAFLEET_SUPERVISOR_EXTRA_ARGS" "$SAVED_RUNTIME_PROFILE_SUPERVISOR_EXTRA_ARGS"
fi
if [ "$IS_V1_AGENT" = "1" ]; then
  write_launch_env "HAFLEET_AGENT_MODEL_VERSION" "${SAVED_AGENT_MODEL_VERSION:-1.0}"
  write_launch_env "HAFLEET_AGENT_ID" "${SAVED_AGENT_ID:-}"
  write_launch_env "HAFLEET_AGENT_HOME" "$SAVED_HOME_DIR"
  write_launch_env "HAFLEET_AGENT_WORKDIR" "$SAVED_WORKDIR"
  write_launch_env "HAFLEET_AGENT_STATE_DIR" "$SAVED_STATE_DIR"
fi

ensure_claude_owner_approval_ask_rules() {
  local settings_dir="$AGENT_PATH/.claude"
  local settings_file="$settings_dir/settings.json"
  mkdir -p "$settings_dir"
  HAFLEET_CLAUDE_SETTINGS_FILE="$settings_file" python3 - <<'PY'
import json
import os
import pathlib
import tempfile

settings_file = pathlib.Path(os.environ["HAFLEET_CLAUDE_SETTINGS_FILE"])
required_rules = [
    "Bash(gh *)",
    "Bash(git push *)",
]

if settings_file.exists():
    try:
        settings = json.loads(settings_file.read_text(encoding="utf-8"))
    except Exception as error:
        raise SystemExit(f"Refusing to overwrite invalid Claude settings {settings_file}: {error}")
else:
    settings = {}

if not isinstance(settings, dict):
    raise SystemExit(f"Refusing to overwrite non-object Claude settings {settings_file}")
permissions = settings.setdefault("permissions", {})
if not isinstance(permissions, dict):
    raise SystemExit(f"Refusing to overwrite non-object permissions in {settings_file}")
ask = permissions.setdefault("ask", [])
if not isinstance(ask, list) or any(not isinstance(rule, str) for rule in ask):
    raise SystemExit(f"Refusing to overwrite invalid permissions.ask in {settings_file}")

changed = False
for rule in required_rules:
    if rule not in ask:
        ask.append(rule)
        changed = True
if not changed:
    raise SystemExit(0)

settings_dir = settings_file.parent
with tempfile.NamedTemporaryFile(
    mode="w",
    encoding="utf-8",
    dir=settings_dir,
    prefix=f".{settings_file.name}.",
    suffix=".tmp",
    delete=False,
) as temporary:
    json.dump(settings, temporary, indent=2)
    temporary.write("\n")
    temporary.flush()
    os.fsync(temporary.fileno())
    temporary_path = pathlib.Path(temporary.name)
os.chmod(temporary_path, 0o600)
os.replace(temporary_path, settings_file)
print(f"Installed Claude owner-approval ask rules in {settings_file}")
PY
}

preflight_runtime_approval_adapter() {
  local approval_state_dir approval_token_file
  approval_state_dir="$(resolve_agent_state_dir)"
  approval_token_file="$approval_state_dir/agent-token"
  if [ ! -s "$approval_token_file" ]; then
    # Mint it rather than refusing. This used to fail with "provision the managed
    # agent identity", an instruction that appears nowhere in the docs and names
    # no command — while the failing run created the agent home as a side effect,
    # so running the identical command a second time succeeded. Worse, that first
    # failure left behind legacy 0.x metadata which then made `up-v1` refuse the
    # name outright. The token is 32 random bytes at mode 0600, the same thing
    # lib/supervisor-provisioning.js writes.
    if ! mkdir -p "$approval_state_dir" 2>/dev/null; then
      echo "Error: cannot create agent state directory $approval_state_dir" >&2
      return 1
    fi
    chmod 700 "$approval_state_dir" 2>/dev/null || true
    if ! node -e '
      const { randomBytes } = require("node:crypto");
      const { writeFileSync } = require("node:fs");
      writeFileSync(process.argv[1], randomBytes(32).toString("hex") + "\n", { mode: 0o600 });
    ' "$approval_token_file" 2>/dev/null; then
      echo "Error: failed to create the owner-approval agent token at $approval_token_file" >&2
      return 1
    fi
    chmod 600 "$approval_token_file" 2>/dev/null || true
    echo "  Provisioned agent token: $approval_token_file"
  fi

  if [ "$TYPE" = "claude" ]; then
    if [ "${HAFLEET_CLAUDE_PERMISSION_CHANNEL:-true}" = "false" ]; then
      echo "Error: managed Claude background agents require the owner approval channel." >&2
      echo "Unset HAFLEET_CLAUDE_PERMISSION_CHANNEL=false and start again." >&2
      return 1
    fi
    if ! command -v claude >/dev/null 2>&1; then
      echo "Error: Claude Code is not installed or not available on PATH." >&2
      return 1
    fi
    if ! claude --help 2>&1 | grep -F -- '--permission-mode' >/dev/null; then
      echo "Error: this Claude Code version does not support managed auto-mode approval." >&2
      return 1
    fi
    if [ ! -f "$AGENT_PATH/.mcp.json" ] && [ ! -f /etc/claude-code/managed-mcp.json ]; then
      echo "Error: Claude owner-approval MCP configuration is unavailable." >&2
      return 1
    fi
    ensure_claude_owner_approval_ask_rules
    echo "Claude owner-approval channel preflight passed."
    return 0
  fi

  # Everything below is Codex-specific. It used to be reached by falling through
  # the claude branch, which was safe only while claude and codex were the sole
  # options — hermes and octos both hit the Codex hook-trust check instead of
  # their own path.
  if [ "$TYPE" != "codex" ]; then
    return 0
  fi

  if [ "${HAFLEET_CODEX_PERMISSION_HOOK:-true}" = "false" ]; then
    echo "Error: managed Codex background agents require the owner approval hook." >&2
    echo "Unset HAFLEET_CODEX_PERMISSION_HOOK=false and start again." >&2
    return 1
  fi
  if [ ! -f "$CODEX_APPROVAL_HOOK" ] || [ ! -f "$CODEX_HOOK_TRUST_PREFLIGHT" ]; then
    echo "Error: Codex owner-approval hook or trust preflight helper is unavailable." >&2
    return 1
  fi
  CODEX_APPROVAL_HOOK_CONFIG_FILE="$AGENT_DATA/codex-approval-hook.json"
  node "$CODEX_HOOK_TRUST_PREFLIGHT" \
    --cwd "$AGENT_PATH" \
    --hook "$CODEX_APPROVAL_HOOK" \
    --output "$CODEX_APPROVAL_HOOK_CONFIG_FILE"
}

# Approval adapters must be usable before a detached terminal exists. A
# preflight failure here leaves no hidden runtime prompt behind in tmux.
preflight_runtime_approval_adapter

# ── Create tmux session ──────────────────────────────────────────────
echo "Creating tmux session '$NAME' in $AGENT_PATH..."
create_tmux_session
if [ -n "$SCOPE_UNIT" ]; then
  echo "  Scope:  $SCOPE_UNIT"
fi
register_backend_agent

# ── Build init prompt for fresh starts ────────────────────────────────
INIT_PROMPT="Your name is ${NAME}. You have an MCP tool server called '${MCP_SERVER_NAME}' for communicating with other agents and humans. Key tools: check_inbox() to read messages, send_message(to, summary, full) to DM, post(group, summary, full, mentions) for group messages, whoami() to see your identity and available agents/groups. Check your inbox now to see if there are any messages for you."
CLAUDE_MODE_GUARD="Critical runtime rule: do not enter Plan mode or Select mode in this multi-agent tmux environment, because interactive mode switching cannot be completed. Stay in default mode and continue execution directly. Save this rule in memory and follow it for the whole session."

# ── Pre-approve custom API key in Claude Code settings ───────────────
if [ -n "${SAVED_RUNTIME_PROFILE_PRIMARY_API_KEY:-}" ]; then
  _key_fingerprint="${SAVED_RUNTIME_PROFILE_PRIMARY_API_KEY: -20}"
  HAFLEET_KEY_FP="$_key_fingerprint" python3 -c "
import json, os
p = os.path.expanduser('~/.claude.json')
try:
    d = json.load(open(p))
except:
    d = {}
r = d.setdefault('customApiKeyResponses', {'approved': [], 'rejected': []})
if not isinstance(r.get('approved'), list):
    r['approved'] = []
fp = os.environ['HAFLEET_KEY_FP']
if fp not in r['approved']:
    r['approved'].append(fp)
    json.dump(d, open(p, 'w'), indent=2)
    print(f'Pre-approved API key fingerprint: ...{fp[-8:]}')
else:
    print(f'API key fingerprint already approved: ...{fp[-8:]}')
" 2>/dev/null || true
fi

# ── Wait for shell ready in tmux pane ─────────────────────────────────
# On macOS, zsh startup can be slow (plugins, etc.).  If we send keys
# before the shell is ready, they can get lost.  Wait until a prompt
# character is visible in the pane (up to 10 seconds).
_pane_ready=false
for _i in $(seq 1 20); do
  _pane_out=$(tmux capture-pane -t "$TMUX_PANE_TARGET" -p 2>/dev/null || true)
  if printf '%s' "$_pane_out" | grep -qE '[\$#%>] *$'; then
    _pane_ready=true
    break
  fi
  sleep 0.5
done
if [ "$_pane_ready" != true ]; then
  echo "Warning: shell prompt not detected in pane after 10s; sending launch command anyway." >&2
fi

# Claude asks for confirmation when --dangerously-load-development-channels is
# passed, and HAFleet passes it deliberately (see the comment where CLAUDE_FLAGS is
# built: it opts in only the exact local Agent Chat server, and
# preflight_runtime_approval_adapter refuses to run a managed agent without that
# channel). Nothing answered the prompt, so every freshly launched Claude agent
# stalled on it indefinitely while reporting "launched" and "Registered online".
#
# The confirmation is not persisted anywhere reachable — ~/.claude.json records
# hasTrustDialogAccepted but has no equivalent key for this — so it recurs on every
# launch and pre-seeding is not an option.
#
# This waits for the prompt's own text before sending anything. If it never
# appears, nothing is typed: no keystroke is ever sent speculatively.
confirm_claude_development_channel() {
  local marker='I am using this for local development'
  local waited=0
  while [ "$waited" -lt 60 ]; do
    if tmux capture-pane -t "$TMUX_PANE_TARGET" -p 2>/dev/null | grep -qF "$marker"; then
      echo "  Confirming Claude development-channel prompt (HAFleet passes --dangerously-load-development-channels by design)."
      tmux send-keys -t "$TMUX_PANE_TARGET" Enter
      return 0
    fi
    # Already past it, or it was never shown: the REPL is up.
    if tmux capture-pane -t "$TMUX_PANE_TARGET" -p 2>/dev/null | grep -qF 'auto mode on'; then
      return 0
    fi
    sleep 1
    waited=$((waited + 1))
  done
  echo "Warning: neither the development-channel prompt nor a ready Claude prompt appeared within 60s." >&2
  echo "  Attach to check: tmux attach -t $(shell_quote "$NAME")" >&2
  return 0
}

# ── Launch AI ─────────────────────────────────────────────────────────
if [ "$TYPE" = "claude" ]; then
  INIT_PROMPT="$INIT_PROMPT $CLAUDE_MODE_GUARD"
  CLAUDE_FLAGS="--permission-mode auto"
  if [ "${HAFLEET_CLAUDE_PERMISSION_CHANNEL:-true}" != "false" ]; then
    # Custom bare-server channels remain outside Anthropic's research-preview
    # allowlist. This opts in only the exact local Agent Chat server.
    CLAUDE_FLAGS="$CLAUDE_FLAGS --dangerously-load-development-channels $(shell_quote "server:$MCP_SERVER_NAME")"
  fi
  while IFS= read -r _managed_project_path; do
    [ -n "$_managed_project_path" ] || continue
    CLAUDE_FLAGS="$CLAUDE_FLAGS --add-dir=$(shell_quote "$_managed_project_path")"
  done <<< "$MANAGED_PROJECT_PATHS"
  # Attach the per-agent MCP config so Claude discovers the hafleet MCP server.
  # Skip when an enterprise managed MCP config is present — recent Claude CLI
  # refuses dynamic --mcp-config in that case. The managed config provides the
  # hafleet MCP server globally, and env vars from launch-env.sh are
  # inherited by the MCP subprocess.
  # Use --mcp-config=<path> (equals form) so commander's variadic parser does
  # NOT absorb the trailing positional prompt as an additional config path.
  if [ ! -f /etc/claude-code/managed-mcp.json ]; then
    CLAUDE_FLAGS="$CLAUDE_FLAGS --mcp-config=$(shell_quote "$AGENT_PATH/.mcp.json")"
  fi
  if [ -n "$MODEL" ]; then
    CLAUDE_FLAGS="$CLAUDE_FLAGS --model $(shell_quote "$MODEL")"
  fi
  if [ -n "$SAFE_EXTRA_ARGS" ]; then
    CLAUDE_FLAGS="$CLAUDE_FLAGS $SAFE_EXTRA_ARGS"
  fi
  if [ "$FRESH" = false ] && RID=$(cat "$RESUME_FILE"); then
    echo "Resuming claude session: $RID"
    CLAUDE_LAUNCH_SCRIPT="$TMP_RUNTIME_DIR/launch-claude.sh"
    write_launch_script "$CLAUDE_LAUNCH_SCRIPT" "exec claude --resume $(shell_quote "$RID") $CLAUDE_FLAGS"
    tmux send-keys -t "$TMUX_PANE_TARGET" "exec $(shell_quote "$CLAUDE_LAUNCH_SCRIPT")" Enter
    confirm_claude_development_channel
  else
    echo "Starting new claude session..."
    # Write init prompt to temp file to avoid shell escaping issues.
    # Pass prompt after '--' so variadic flags (--mcp-config) don't absorb it.
    INIT_FILE=$(mktemp "$TMP_RUNTIME_DIR/init.XXXXXX")
    echo "$INIT_PROMPT" > "$INIT_FILE"
    CLAUDE_LAUNCH_SCRIPT="$TMP_RUNTIME_DIR/launch-claude.sh"
    write_launch_script "$CLAUDE_LAUNCH_SCRIPT" "claude --session-id $(shell_quote "$SESSION_ID") $CLAUDE_FLAGS -- \"\$(cat $(shell_quote "$INIT_FILE"))\"; status=\$?; rm -f $(shell_quote "$INIT_FILE"); exit \$status"
    tmux send-keys -t "$TMUX_PANE_TARGET" "exec $(shell_quote "$CLAUDE_LAUNCH_SCRIPT")" Enter
    confirm_claude_development_channel
    ( sleep 300; rm -f "$INIT_FILE" >/dev/null 2>&1 || true ) &
    capture_resume_id_background "claude"
  fi

elif [ "$TYPE" = "codex" ]; then
  # Agent Chat permission Level 2: project workspace is writable, while
  # operations outside the sandbox require an explicit approval request.
  CODEX_FLAGS="--sandbox workspace-write --ask-for-approval on-request -C $(shell_quote "$AGENT_PATH")"
  while IFS= read -r _managed_project_path; do
    [ -n "$_managed_project_path" ] || continue
    CODEX_FLAGS="$CODEX_FLAGS --add-dir $(shell_quote "$_managed_project_path")"
  done <<< "$MANAGED_PROJECT_PATHS"
  if [ -n "$MODEL" ]; then
    CODEX_FLAGS="$CODEX_FLAGS --model $(shell_quote "$MODEL")"
  fi
  if [ -n "$SAFE_EXTRA_ARGS" ]; then
    CODEX_FLAGS="$CODEX_FLAGS $SAFE_EXTRA_ARGS"
  fi
  # Inject MCP env vars via -c flags so Codex passes them to the MCP subprocess.
  # Codex strips env vars but honors -c config overrides parsed as TOML.
  # Must target the managed-mcp.json server name (hafleet), not $MCP_SERVER_NAME
  # which may differ (e.g. hafleet-dev in dev .env).
  CODEX_MCP_NAME="hafleet"
  CODEX_MCP_SERVER_JS="$BASE_DIR/mcp-server.js"
  codex_toml_string() {
    local val="$1"
    val="${val//\\/\\\\}"
    val="${val//\"/\\\"}"
    printf '"%s"' "$val"
  }
  codex_mcp_config() {
    local key="$1" raw_value="$2"
    local arg="${key}=${raw_value}"
    # Shell-escape the entire argument so it survives tmux/pane execution
    CODEX_FLAGS="$CODEX_FLAGS -c $(printf '%q' "$arg")"
  }
  codex_mcp_env() {
    local key="$1" val="$2"
    if [ -z "$val" ]; then return 0; fi
    codex_mcp_config "mcp_servers.${CODEX_MCP_NAME}.env.${key}" "$(codex_toml_string "$val")"
  }
  codex_mcp_config "mcp_servers.${CODEX_MCP_NAME}.command" "$(codex_toml_string "node")"
  codex_mcp_config "mcp_servers.${CODEX_MCP_NAME}.args" "[$(codex_toml_string "$CODEX_MCP_SERVER_JS")]"
  CODEX_APPROVAL_HOOK_TOML="$(node -e '
const fs = require("fs");
const prepared = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
if (prepared.version !== 1 || typeof prepared.hookToml !== "string" || !prepared.hookToml) process.exit(1);
process.stdout.write(prepared.hookToml);
' "$CODEX_APPROVAL_HOOK_CONFIG_FILE")"
  codex_mcp_config "hooks.PermissionRequest" "$CODEX_APPROVAL_HOOK_TOML"
  codex_mcp_env AGENT_NAME "$NAME"
  codex_mcp_env HAFLEET_API "$BACKEND_URL"
  codex_mcp_env HAFLEET_BACKEND_PORT "$BACKEND_PORT"
  codex_mcp_env HAFLEET_MCP_SERVER_NAME "$MCP_SERVER_NAME"
  codex_mcp_env API_TOKEN "${API_TOKEN:-}"
  codex_mcp_env HAFLEET_HOMEDIR "${HAFLEET_HOMEDIR:-}"
  if [ -n "$SERVER_ID" ]; then
    codex_mcp_env HAFLEET_SERVER "$SERVER_ID"
  fi
  codex_mcp_env HAFLEET_AGENT_STATE_DIR "$(resolve_agent_state_dir)"
  if [ -n "$RUNTIME_DIR" ]; then
    codex_mcp_env HAFLEET_RUNTIME_DIR "$RUNTIME_DIR"
  fi
  if [ "$FRESH" = false ] && [ -f "$RESUME_FILE" ]; then
    RID=$(cat "$RESUME_FILE")
    echo "Resuming codex session: $RID"
    CODEX_LAUNCH_SCRIPT="$TMP_RUNTIME_DIR/launch-codex.sh"
    write_launch_script "$CODEX_LAUNCH_SCRIPT" "exec codex resume $(shell_quote "$RID") $CODEX_FLAGS"
    tmux send-keys -t "$TMUX_PANE_TARGET" "exec $(shell_quote "$CODEX_LAUNCH_SCRIPT")" Enter
  else
    CODEX_BASELINE_FILE=$(mktemp "$TMP_RUNTIME_DIR/codex-baseline.XXXXXX")
    snapshot_codex_session_ids "$CODEX_BASELINE_FILE"
    echo "Starting new codex session..."
    # Pass the bootstrap prompt as Codex's initial prompt instead of
    # typing into the TUI after launch. Tmux key timing is unreliable
    # while Codex is still drawing its first prompt.
    CODEX_INIT_FILE=$(mktemp "$TMP_RUNTIME_DIR/init-codex.XXXXXX")
    echo "$INIT_PROMPT" > "$CODEX_INIT_FILE"
    CODEX_LAUNCH_SCRIPT="$TMP_RUNTIME_DIR/launch-codex.sh"
    write_launch_script "$CODEX_LAUNCH_SCRIPT" "codex $CODEX_FLAGS -- \"\$(cat $(shell_quote "$CODEX_INIT_FILE"))\"; status=\$?; rm -f $(shell_quote "$CODEX_INIT_FILE"); exit \$status"
    tmux send-keys -t "$TMUX_PANE_TARGET" "exec $(shell_quote "$CODEX_LAUNCH_SCRIPT")" Enter
    ( sleep 300; rm -f "$CODEX_INIT_FILE" >/dev/null 2>&1 || true ) &
    # Keep this in foreground for codex to avoid losing resume capture on shell exit/reboot.
    if ! capture_resume_id_from_pane 12; then
      i=0
      for ((i = 0; i < 24; i++)); do
        if capture_resume_id_from_codex_files "$CODEX_BASELINE_FILE"; then
          break
        fi
        sleep 1
      done
    fi
    rm -f "$CODEX_BASELINE_FILE" >/dev/null 2>&1 || true
  fi

elif [ "$TYPE" = "hermes" ]; then
  # --cli forces the classic prompt_toolkit REPL rather than the full-screen TUI.
  # A blocked agent is detected by regex-scraping capture-pane output, and a TUI
  # that repaints whole frames makes that unreliable. The approval prompt this
  # depends on lives in the CLI path upstream (cli.py, covered by
  # tests/cli/test_cli_approval_ui.py).
  HERMES_FLAGS="--cli"
  if [ -n "$MODEL" ]; then
    HERMES_FLAGS="$HERMES_FLAGS --model $(shell_quote "$MODEL")"
  fi
  if [ -n "$SAFE_EXTRA_ARGS" ]; then
    HERMES_FLAGS="$HERMES_FLAGS $SAFE_EXTRA_ARGS"
  fi
  HERMES_LAUNCH_SCRIPT="$TMP_RUNTIME_DIR/launch-hermes.sh"
  if [ "$FRESH" = false ] && RID=$(cat "$RESUME_FILE" 2>/dev/null) && [ -n "$RID" ]; then
    echo "Resuming hermes session: $RID"
    write_launch_script "$HERMES_LAUNCH_SCRIPT" "exec hermes --resume $(shell_quote "$RID") $HERMES_FLAGS"
    tmux send-keys -t "$TMUX_PANE_TARGET" "exec $(shell_quote "$HERMES_LAUNCH_SCRIPT")" Enter
  else
    echo "Starting new hermes session..."
    # Hermes cannot take an init prompt while staying interactive: both
    # -z/--oneshot and `chat -q` print one response and exit. So the REPL is
    # started and the prompt is typed in — the same mechanism the relay uses for
    # every message after this one.
    write_launch_script "$HERMES_LAUNCH_SCRIPT" "exec hermes $HERMES_FLAGS"
    tmux send-keys -t "$TMUX_PANE_TARGET" "exec $(shell_quote "$HERMES_LAUNCH_SCRIPT")" Enter

    # Wait for the REPL prompt itself. Waiting for the pane to hold still does
    # NOT work and was measured doing the wrong thing: the pane sits unchanged
    # for about a second after the launch line is echoed and before Hermes emits
    # anything, so a stability check reports ready while there is no REPL yet and
    # the typed prompt goes nowhere. This is why bin/agent-up gave up on
    # post-launch typing for Codex.
    # Match a literal, from the manifest, so no regex dialect is assumed here.
    #
    # The marker is Hermes's input prompt, which is a SKIN SETTING
    # (hermes_cli/skin_engine.py: branding.prompt_symbol), not a constant. A
    # custom skin changes it and this wait would never succeed, so it is
    # overridable without a code change.
    #
    # Timeout is generous because startup time was measured varying from ~3s to
    # ~20s on an unloaded machine, and the pane goes briefly BLANK part way
    # through — which is the other reason waiting for the pane to hold still
    # cannot work here.
    HERMES_READY="${HAFLEET_HERMES_READY_MARKER:-$(node "$FRAMEWORK_INFO" ready-fixed hermes 2>/dev/null || printf '\xe2\x9d\xaf')}"
    # Validate before any arithmetic: under `set -u` a non-numeric value makes
    # $(( )) treat it as an unbound variable name and aborts the whole script.
    HERMES_READY_TIMEOUT="${HAFLEET_HERMES_READY_TIMEOUT_SEC:-60}"
    case "$HERMES_READY_TIMEOUT" in
      ''|*[!0-9]*)
        echo "Warning: HAFLEET_HERMES_READY_TIMEOUT_SEC is not a positive integer; using 60." >&2
        HERMES_READY_TIMEOUT=60
        ;;
    esac
    [ "$HERMES_READY_TIMEOUT" -ge 1 ] || HERMES_READY_TIMEOUT=60
    _hermes_polls=$(( HERMES_READY_TIMEOUT * 2 ))
    _hermes_ready=false
    for _i in $(seq 1 "$_hermes_polls"); do
      if tmux capture-pane -t "$TMUX_PANE_TARGET" -p 2>/dev/null | grep -qF "$HERMES_READY"; then
        _hermes_ready=true
        break
      fi
      sleep 0.5
    done
    if [ "$_hermes_ready" != true ]; then
      echo "Error: hermes input prompt ($HERMES_READY) did not appear within ${HERMES_READY_TIMEOUT}s." >&2
      echo "  Not sending the init prompt: it would be typed into an unknown state." >&2
      echo "  The session is running; attach with: tmux attach -t $(shell_quote "$NAME")" >&2
      echo "  If you use a custom Hermes skin, its prompt symbol differs — set" >&2
      echo "  HAFLEET_HERMES_READY_MARKER to it, or raise HAFLEET_HERMES_READY_TIMEOUT_SEC." >&2
      exit 1
    fi

    # -l sends the text literally, so a prompt containing ; or - is not parsed as
    # tmux syntax. Enter is a separate call to submit it.
    tmux send-keys -t "$TMUX_PANE_TARGET" -l "$INIT_PROMPT"
    tmux send-keys -t "$TMUX_PANE_TARGET" Enter
  fi
  capture_resume_id_background "hermes"
fi

# Post-launch health check for custom API provider agents
if [ -n "${SAVED_RUNTIME_PROFILE_PRIMARY_API_KEY:-}" ]; then
  sleep 8
  _pane_content=$(tmux capture-pane -t "$TMUX_PANE_TARGET" -p -S -20 2>/dev/null || true)
  if echo "$_pane_content" | grep -q "Do you want to use this API key"; then
    echo "WARNING: Stuck at API key prompt — sending auto-accept..."
    tmux send-keys -t "$TMUX_PANE_TARGET" Up Enter
    sleep 3
    _pane_content=$(tmux capture-pane -t "$TMUX_PANE_TARGET" -p -S -10 2>/dev/null || true)
  fi
  if echo "$_pane_content" | grep -q "issue with the selected model"; then
    echo "ERROR: Model validation failed — check model name and API provider compatibility"
  fi
  if echo "$_pane_content" | grep -qP "^❯ $"; then
    echo "Agent started successfully (idle prompt visible)"
  fi
fi

if [ "$AGENT_SCOPE_ENABLE" = "1" ] && [ "${#AGENT_SCOPE_LIMIT_PROPERTIES[@]}" -gt 0 ]; then
  if ! apply_scope_limits_to_runtime_scope; then
    echo "Warning: failed to apply runtime scope memory limits for '$NAME'." >&2
  fi
fi

# Post hafleet-up lifecycle event
post_lifecycle "Agent '$NAME' started ($TYPE) on ${SERVER_ID:-local}" "Agent '$NAME' ($TYPE) started in $AGENT_PATH on ${SERVER_ID:-local}"

# ── Done ──────────────────────────────────────────────────────────────
echo ""
echo "Agent '$NAME' ($TYPE) launched in $AGENT_PATH"

if [ "$ATTACH" = true ]; then
  exec tmux attach -t "$TMUX_TARGET"
else
  echo "  Attach: tmux attach -t $NAME"
  echo "  Meta:   $META_FILE"
fi
