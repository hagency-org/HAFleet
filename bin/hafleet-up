fi

shell_quote() {
  printf "%q" "$1"
}

write_launch_script() {
  local target="$1"
  local command="$2"
  local launch_env_quoted runtime_pid_file_quoted
  launch_env_quoted="$(shell_quote "$LAUNCH_ENV_FILE")"
  runtime_pid_file_quoted="$(shell_quote "$MANAGED_RUNTIME_PID_FILE")"
  {
    printf '#!/usr/bin/env bash\n'
    printf 'set -euo pipefail\n'
    printf 'source %s\n' "$launch_env_quoted"
    printf 'printf "%%s\\n" "$$" > %s\n' "$runtime_pid_file_quoted"
    printf 'chmod 600 %s\n' "$runtime_pid_file_quoted"
    printf '%s\n' "$command"
  } > "$target"
  chmod 700 "$target"
}

# ── Launch env file helpers ──────────────────────────────────────────
# Write launch env vars to a sourced file instead of an inline command
# prefix.  Keeps the tmux launch command short and debuggable.
write_launch_env() {
  printf 'export %s=%q\n' "$1" "$2" >> "$LAUNCH_ENV_FILE"
}

write_launch_env_from_env() {
  local var_name="$1"
  local var_value="${!var_name-}"
  # Use if/then (not [ ] && cmd) to avoid set -e false-positive on bash 3.2 (macOS)
  if [ -n "${var_value:-}" ]; then
    write_launch_env "$var_name" "$var_value"
  fi
}

IS_V1_AGENT=0
if [[ "${SAVED_AGENT_MODEL_VERSION:-}" == 1* ]] && [ -n "${SAVED_HOME_DIR:-}" ] && [ -n "${SAVED_WORKDIR:-}" ] && [ -n "${SAVED_STATE_DIR:-}" ]; then
  IS_V1_AGENT=1
fi

LAUNCH_ENV_FILE="$AGENT_DATA/launch-env.sh"
: > "$LAUNCH_ENV_FILE"
chmod 600 "$LAUNCH_ENV_FILE"
# A caller's shell may contain a stale Anthropic key that overrides Claude's
# authenticated subscription. Only an explicit per-agent runtime profile may
# select API-key authentication; otherwise make the managed launch deterministic.
if [ "$TYPE" = "claude" ] && [ -z "${SAVED_RUNTIME_PROFILE_PRIMARY_API_KEY:-}" ]; then
  printf 'unset ANTHROPIC_API_KEY\n' >> "$LAUNCH_ENV_FILE"
fi
write_launch_env "HAFLEET_AGENT_SANDBOX" "1"
if [ "$TYPE" = "claude" ]; then
  write_launch_env "HAFLEET_AGENT_PERMISSION_MODE" "auto"
else
  write_launch_env "HAFLEET_AGENT_PERMISSION_LEVEL" "2"
  write_launch_env "HAFLEET_AGENT_SANDBOX_MODE" "workspace-write"
  write_launch_env "HAFLEET_AGENT_APPROVAL_POLICY" "on-request"
fi

write_launch_env "AGENT_NAME" "$NAME"
# Bulk-export all HAFLEET_* vars from current environment
while IFS= read -r _var_name; do
  [ -n "$_var_name" ] || continue
  write_launch_env_from_env "$_var_name"
done < <(env | cut -d= -f1 | LC_ALL=C sort | awk 'index($0, "HAFLEET_") == 1')
write_launch_env_from_env "API_TOKEN"
write_launch_env_from_env "HAFLEET_HOMEDIR"
# Use if/then (not [ ] && cmd) to avoid set -e false-positive on bash 3.2 (macOS)
if [ -n "${SAVED_RUNTIME_PROFILE_PRIMARY_JSON:-}" ]; then
  write_launch_env "HAFLEET_RUNTIME_PROFILE_PRIMARY_JSON" "$SAVED_RUNTIME_PROFILE_PRIMARY_JSON"
