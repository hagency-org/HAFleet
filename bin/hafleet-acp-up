#!/usr/bin/env bash
# Start a paneless ACP agent and register it with the backend.
#
# hafleet-up creates a tmux session and drives the agent by typing into it. An
# ACP framework has no pane at all, so it needs a different launch path rather
# than a branch inside that one: the agent is a subprocess speaking JSON-RPC, its
# liveness is whether that process exists, and nothing may ever send-keys to it.
#
# Usage: hafleet-acp-up <name> <workspace> <framework> [--model <m>]
set -euo pipefail

BASE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
  cat <<'USAGE'
Usage: hafleet acp-up <name> <workspace> <framework> [--model <m>]

Starts a paneless agent over the Agent Client Protocol and registers it with the
backend. Use this for frameworks whose adapter declares transport "acp" (octos);
tmux frameworks use 'hafleet up' instead and are refused here.

An ACP agent has no tmux pane, so it cannot be captured or sent keys. Its
liveness is whether the subprocess exists, and progress arrives as session/update
notifications rather than screen output.

Arguments:
  name         Agent name to register
  workspace    Existing directory the agent runs in
  framework    Framework id with an ACP adapter (e.g. octos)

Options:
  --model <m>    Model to request from the framework
  --supervised   Register with the local supervisor instead of running detached,
                 so the agent is restarted if it dies and comes back after a
                 reboot. A tmux agent survives its launcher because tmux owns the
                 pane; an ACP agent dies with this process and cannot be resumed.
  --profile <f>  Service profile to register into (default: the installed one)
  -h, --help     Show this help
USAGE
}

# Before positional parsing: `${1:?...}` would otherwise report "workspace
# required" for `--help`, which is what the CLI contract gate caught.
for arg in "$@"; do
  if [ "$arg" = "-h" ] || [ "$arg" = "--help" ]; then
    usage
    exit 0
  fi
done

NAME="${1:?Usage: hafleet-acp-up <name> <workspace> <framework> [--model <m>]}"
WORKSPACE="${2:?workspace required}"
FRAMEWORK="${3:?framework required}"
shift 3
MODEL=""
SUPERVISED=false
PROFILE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --model) MODEL="${2:?--model requires a value}"; shift 2 ;;
    --supervised) SUPERVISED=true; shift ;;
    --profile) PROFILE="${2:?--profile requires a value}"; shift 2 ;;
    *) echo "unknown argument: $1" >&2; exit 1 ;;
  esac
done

[ -d "$WORKSPACE" ] || { echo "Error: workspace '$WORKSPACE' does not exist" >&2; exit 1; }
if [ -f "$BASE_DIR/.env" ]; then set -a; . "$BASE_DIR/.env"; set +a; fi
PORT="${HAFLEET_BACKEND_PORT:-8090}"
API="${HAFLEET_API:-http://127.0.0.1:$PORT}"

# The registry decides whether this framework is ACP at all, so a tmux framework
# cannot be started down this path by mistake.
TRANSPORT="$(node -e "
  const { getFramework } = await import('$BASE_DIR/lib/frameworks/index.js');
  const f = getFramework(process.argv[1]);
  process.stdout.write(f ? f.transport : 'unknown');
" "$FRAMEWORK")"
if [ "$TRANSPORT" != "acp" ]; then
  echo "Error: '$FRAMEWORK' is not an ACP framework (transport=$TRANSPORT); use 'hafleet up' instead" >&2
  exit 1
fi

STATE_DIR="${HAFLEET_HOMEDIR:-$HOME/.hafleet}/agents/agent_${NAME}/state"
mkdir -p "$STATE_DIR"; chmod 700 "$STATE_DIR"
if [ ! -s "$STATE_DIR/agent-token" ]; then
  node -e '
    const { randomBytes } = require("node:crypto");
    require("node:fs").writeFileSync(process.argv[1], randomBytes(32).toString("hex") + "\n", { mode: 0o600 });
  ' "$STATE_DIR/agent-token"
  echo "  Provisioned agent token: $STATE_DIR/agent-token"
fi

PID_FILE="$STATE_DIR/acp.pid"
if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE" 2>/dev/null)" 2>/dev/null; then
  echo "Agent '$NAME' is already running (pid $(cat "$PID_FILE"))."
  exit 0
fi

# ── Supervised path ───────────────────────────────────────────────────────────
# Registers the agent in the service profile and lets HAFleet's own supervisor
# own the process, which gives restart-on-crash and reboot survival together
# (the supervisor is itself started by launchd or systemd). Returns here; the
# detached path below is the unsupervised alternative, and running both would
# leave two hosts fighting over one ACP session.
if [ "$SUPERVISED" = true ]; then
  if [ -z "$PROFILE" ]; then
    for candidate in "$BASE_DIR/services-macos.json" "$BASE_DIR/services/services-local.json"; do
      [ -f "$candidate" ] && PROFILE="$candidate" && break
    done
  fi
  [ -n "$PROFILE" ] && [ -f "$PROFILE" ] || {
    echo "Error: no service profile found; pass --profile <file>" >&2
    echo "       (looked for services-macos.json and services/services-local.json)" >&2
    exit 1
  }

  # The supervisor runs with whatever PATH its launchd/systemd unit exports, which
  # on mini5 omits ~/.local/bin where octos lives. Without the framework binary's
  # directory the host exits at once and the entry restarts forever. Resolve it
  # from the PATH in effect here, where the operator can see it working.
  FRAMEWORK_CMD="$(node -e "
    const { getFramework } = await import('$BASE_DIR/lib/frameworks/index.js');
    process.stdout.write(getFramework(process.argv[1])?.launch?.command ?? '');
  " "$FRAMEWORK")"
  BIN_PATH=""
  if [ -n "$FRAMEWORK_CMD" ] && command -v "$FRAMEWORK_CMD" >/dev/null 2>&1; then
    BIN_PATH="$(dirname "$(command -v "$FRAMEWORK_CMD")")"
  else
    echo "Warning: '$FRAMEWORK_CMD' is not on PATH here; the supervised agent may not find it." >&2
  fi
  SUPERVISED_PATH="${BIN_PATH:+$BIN_PATH:}/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"

  node "$BASE_DIR/scripts/hafleet-supervise-agent.mjs" add \
    --name "$NAME" --profile "$PROFILE" \
    --workspace "$WORKSPACE" --framework "$FRAMEWORK" \
    ${MODEL:+--model "$MODEL"} --path "$SUPERVISED_PATH"

  # Stop any unsupervised host first: two processes holding sessions for one agent
  # would both poll the inbox and both answer.
  if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE" 2>/dev/null)" 2>/dev/null; then
    kill "$(cat "$PID_FILE")" 2>/dev/null || true
    rm -f "$PID_FILE"
    echo "  Stopped the unsupervised host; the supervisor owns this agent now."
  fi

  case "$(uname -s)" in
    Darwin)
      if launchctl kickstart -k "gui/$(id -u)/io.hafleet.services" >/dev/null 2>&1; then
        echo "  Reloaded the supervisor (launchd)."
      else
        echo "  Registered. Reload the supervisor to start it:" >&2
        echo "    launchctl kickstart -k gui/\$(id -u)/io.hafleet.services" >&2
      fi
      ;;
    Linux)
      if systemctl --user restart hafleet-services >/dev/null 2>&1 \
        || sudo -n systemctl restart hafleet-services >/dev/null 2>&1; then
        echo "  Reloaded the supervisor (systemd)."
      else
        echo "  Registered. Reload the supervisor to start it:" >&2
        echo "    systemctl --user restart hafleet-services" >&2
      fi
      ;;
    *)
      echo "  Registered. Reload your supervisor to start it." >&2
      ;;
  esac

  echo "Agent '$NAME' ($FRAMEWORK over ACP) is supervised as 'agent:$NAME'."
  echo "  profile: $PROFILE"
  echo "  status:  hafleet service status"
  exit 0
fi

LOG_DIR="$BASE_DIR/data/acp-agents"; mkdir -p "$LOG_DIR"
nohup node "$BASE_DIR/scripts/hafleet-acp-agent.mjs" \
  --name "$NAME" --workspace "$WORKSPACE" --framework "$FRAMEWORK" \
  ${MODEL:+--model "$MODEL"} >>"$LOG_DIR/$NAME.log" 2>&1 &
AGENT_PID=$!
echo "$AGENT_PID" > "$PID_FILE"; chmod 600 "$PID_FILE"

sleep 6
if ! kill -0 "$AGENT_PID" 2>/dev/null; then
  echo "Error: the ACP agent exited immediately. Last lines:" >&2
  tail -8 "$LOG_DIR/$NAME.log" >&2 || true
  rm -f "$PID_FILE"
  exit 1
fi

AUTH=()
[ -n "${API_TOKEN:-}" ] && AUTH=(-H "Authorization: Bearer $API_TOKEN")
curl -sf -X POST "${AUTH[@]}" -H 'Content-Type: application/json' \
  -d "{\"name\":\"$NAME\",\"type\":\"$FRAMEWORK\",\"transport\":\"acp\",\"acpPid\":$AGENT_PID,\"server\":\"${HAFLEET_SERVER:-$(hostname)}\"}" \
  "$API/api/agents" >/dev/null && echo "Registered '$NAME' (acp, pid $AGENT_PID) in backend."

echo "Agent '$NAME' ($FRAMEWORK over ACP) running in $WORKSPACE"
echo "  logs: $LOG_DIR/$NAME.log"
echo "  stop: kill \$(cat $PID_FILE)"
