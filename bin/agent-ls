#!/bin/bash

# Deprecated legacy entrypoint: forward to unified 'agentchat'.
if [ "${AGENTCHAT_INTERNAL_DISPATCH:-0}" != "1" ]; then
  _ac_legacy_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  _ac_legacy_name="$(basename "$0")"
  echo "[DEPRECATED] ${_ac_legacy_name} is deprecated. Use: agentchat ls ..." >&2
  exec "${_ac_legacy_dir}/agentchat" "ls" "$@"
fi
# agent-ls — List agent sessions with status
#
# Usage:
#   agent-ls        List running agents (active tmux sessions)
#   agent-ls -a     List all agents including down (have data but not running)
#   agent-ls --all  Same as -a

# Portable script dir resolution (works on macOS bash 3.2 + Linux)
_resolve_script_dir() {
  local src="$0"
  while [ -L "$src" ]; do
    local dir
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
  done
  cd -P "$(dirname "$src")" && pwd
}
SCRIPT_DIR="$(_resolve_script_dir)"
BASE_DIR="$(dirname "$SCRIPT_DIR")"
ENV_FILE="$BASE_DIR/.env"
if [ -f "$ENV_FILE" ]; then
  set -a
  source "$ENV_FILE"
  set +a
fi
RUNTIME_DIR="${AGENT_CHAT_RUNTIME_DIR:-$BASE_DIR}"
DATA_DIR="$RUNTIME_DIR/data/agents"
BACKEND_PORT_RAW="${AGENT_CHAT_BACKEND_PORT:-8090}"
if [[ "$BACKEND_PORT_RAW" =~ ^[0-9]+$ ]] && [ "$BACKEND_PORT_RAW" -gt 0 ]; then
  BACKEND_PORT="$BACKEND_PORT_RAW"
else
  BACKEND_PORT="8090"
fi
BACKEND_URL="${AGENT_CHAT_API:-http://127.0.0.1:$BACKEND_PORT}"

_is_abs_path() {
  case "${1:-}" in
    /*) return 0 ;;
    *) return 1 ;;
  esac
}

_resolve_v1_home_roots() {
  local legacy primary
  legacy="$HOME/.agentchat"
  primary="$legacy"
  if [ -n "${AGENTCHAT_HOMEDIR:-}" ] && _is_abs_path "$AGENTCHAT_HOMEDIR"; then
    primary="$AGENTCHAT_HOMEDIR"
  elif [ -n "${AGENT_CHAT_RUNTIME_DIR:-}" ] && _is_abs_path "$AGENT_CHAT_RUNTIME_DIR"; then
    primary="$AGENT_CHAT_RUNTIME_DIR/homes"
  fi
  printf '%s\n' "$primary"
  [ "$legacy" != "$primary" ] && printf '%s\n' "$legacy"
}
V1_HOME_ROOTS="$(_resolve_v1_home_roots)"

usage() {
  cat <<'EOF'
Usage: agent-ls [--all|-a]

Scope:
  Lists tmux sessions on the current runtime host.
  --all also includes backend-registered agents and v1 manifests visible to this host.

Options:
  -a, --all   Include down/standby agents known from local data, v1 homes, or backend registry.
  -h, --help  Show this help.
EOF
}

SHOW_ALL=false
case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
  -a|--all)
    SHOW_ALL=true
    ;;
  *)
    ;;
esac

# Temp files for portable key-value lookups (no associative arrays — bash 3.2 compat)
_TMP_FILES=""
_mktmp() {
  local f
  f=$(mktemp 2>/dev/null || mktemp -t agent_ls) || { echo "Error: mktemp failed" >&2; exit 1; }
  _TMP_FILES="$_TMP_FILES $f"
  echo "$f"
}
trap 'rm -f $_TMP_FILES' EXIT

PTS_MAP_FILE=$(_mktmp)
MCP_SESSIONS_FILE=$(_mktmp)
AGENTS_FILE=$(_mktmp)
ACTIVE_MAP_FILE=$(_mktmp)
V1_INFO_FILE=$(_mktmp)

V1_HOME_ROOTS="$V1_HOME_ROOTS" python3 - <<'PY' > "$V1_INFO_FILE" 2>/dev/null || true
import json
import os
from pathlib import Path

roots = [Path(p) for p in os.environ.get("V1_HOME_ROOTS", "").splitlines() if p.strip()]
seen = set()

for root in roots:
    agents_dir = root / "agents"
    if not agents_dir.exists():
        continue
    for entry in sorted(agents_dir.iterdir()):
        if not entry.is_dir():
            continue
        manifest = entry / "agent.json"
        if not manifest.exists():
            continue
        try:
            data = json.loads(manifest.read_text(encoding="utf-8"))
        except Exception:
            continue
        name = str(data.get("name") or "").strip()
        if not name:
            continue
        key = name.lower()
        if key in seen:
            continue
        seen.add(key)
        a_type = str(data.get("type") or "-").strip() or "-"
        workdir = str(data.get("workdir") or "-").strip() or "-"
        state_dir = str(data.get("stateDir") or "-").strip() or "-"
        model_ver = str(data.get("agentModelVersion") or "-").strip() or "-"
        sup_for = str(data.get("supervisorFor") or "-").strip() or "-"
        print("|".join([name, a_type, workdir, state_dir, model_ver, sup_for]))
PY

# Get tmux sessions
SESSIONS=$(tmux list-sessions -F "#{session_name}" 2>/dev/null || true)

# Get known agents from backend
_LS_AUTH_HEADER=""
[ -n "${API_TOKEN:-}" ] && _LS_AUTH_HEADER="Authorization: Bearer $API_TOKEN"
REG_NAMES=$(ACTIVE_MAP_FILE="$ACTIVE_MAP_FILE" curl --noproxy '*' -s ${_LS_AUTH_HEADER:+-H "$_LS_AUTH_HEADER"} "$BACKEND_URL/api/agents" 2>/dev/null \
  | ACTIVE_MAP_FILE="$ACTIVE_MAP_FILE" python3 -c '
import json
import sys
import os
try:
    data = json.load(sys.stdin)
except Exception:
    data = []
active_map = os.environ.get("ACTIVE_MAP_FILE", "")
lines = []
if isinstance(data, list):
    for item in data:
        if isinstance(item, dict) and item.get("name"):
            print(item["name"])
            if item.get("activeNow") is True:
                active = "1"
            elif item.get("activeNow") is False:
                active = "0"
            else:
                active = "unknown"
            lines.append(item["name"] + "|" + active)
if active_map and lines:
    with open(active_map, "w") as f:
        f.write("\n".join(lines) + "\n")
' 2>/dev/null || true)

# Build tty → session map for MCP detection
tmux list-panes -a -F "#{pane_tty} #{session_name}" 2>/dev/null \
  | sed 's|/dev/||' > "$PTS_MAP_FILE" || true

# Detect MCP sessions
MCP_PIDS=$(pgrep -f "node.*mcp-server.js" 2>/dev/null || true)
for pid in $MCP_PIDS; do
  pts=$(ps -o tty= -p "$pid" 2>/dev/null | tr -d ' ')
  if [ -n "$pts" ]; then
    # Try exact match first, then prefix match (macOS tty format differs)
    sess=$(grep -m1 "^${pts} \|/${pts} " "$PTS_MAP_FILE" 2>/dev/null | awk '{print $2}')
    [ -n "$sess" ] && echo "$sess" >> "$MCP_SESSIONS_FILE"
  fi
done

# Collect all agent names: "name status" per line
# Use activeNow from backend to distinguish active vs idle tmux sessions
for sess in $SESSIONS; do
  active_now=$(awk -F'|' -v n="$sess" '$1==n {print $2; exit}' "$ACTIVE_MAP_FILE" 2>/dev/null)
  if [ "$active_now" = "1" ]; then
    echo "$sess active" >> "$AGENTS_FILE"
  elif [ "$active_now" = "0" ]; then
    echo "$sess idle" >> "$AGENTS_FILE"
  else
    echo "$sess unknown" >> "$AGENTS_FILE"
  fi
done

if [ "$SHOW_ALL" = true ]; then
  if [ -d "$DATA_DIR" ]; then
    for agent_dir in "$DATA_DIR"/*/; do
      [ -d "$agent_dir" ] || continue
      name=$(basename "$agent_dir")
      [ -f "$agent_dir/meta.json" ] || continue
      if ! grep -q "^${name} " "$AGENTS_FILE" 2>/dev/null; then
        sup=$(python3 -c "import json; print(json.load(open('${agent_dir}meta.json')).get('supervisorFor','') or '')" 2>/dev/null || true)
        if [ -n "$sup" ]; then
          echo "$name standby" >> "$AGENTS_FILE"
        else
          echo "$name down" >> "$AGENTS_FILE"
        fi
      fi
    done
  fi
  if [ -s "$V1_INFO_FILE" ]; then
    while IFS='|' read -r v1_name _ _ _ _ v1_sup; do
      [ -n "$v1_name" ] || continue
      if ! grep -q "^${v1_name} " "$AGENTS_FILE" 2>/dev/null; then
        if [ -n "$v1_sup" ] && [ "$v1_sup" != "-" ]; then
          echo "$v1_name standby" >> "$AGENTS_FILE"
        else
          echo "$v1_name down" >> "$AGENTS_FILE"
        fi
      fi
    done < "$V1_INFO_FILE"
  fi
  # Include backend-registered agents with no tmux session
  for reg_name in $REG_NAMES; do
    [ -n "$reg_name" ] || continue
    if ! grep -q "^${reg_name} " "$AGENTS_FILE" 2>/dev/null; then
      _reg_sup=""
      if [ -f "$DATA_DIR/$reg_name/meta.json" ]; then
        _reg_sup=$(python3 -c "import json; print(json.load(open('$DATA_DIR/$reg_name/meta.json')).get('supervisorFor','') or '')" 2>/dev/null || true)
      elif [ -s "$V1_INFO_FILE" ]; then
        _reg_sup=$(awk -F'|' -v n="$reg_name" '$1==n && $6!="-" {print $6; exit}' "$V1_INFO_FILE" 2>/dev/null || true)
      fi
      if [ -n "$_reg_sup" ]; then
        echo "$reg_name standby" >> "$AGENTS_FILE"
      else
        echo "$reg_name down" >> "$AGENTS_FILE"
      fi
    fi
  done
fi

if [ ! -s "$AGENTS_FILE" ]; then
  echo "No agents found."
  exit 0
fi

# Print header
printf "%-20s %-8s %-8s %-6s %-20s %-10s %-5s %-10s %s\n" "NAME" "STATUS" "TYPE" "VER" "MODEL" "KNOWN" "MCP" "RESUME" "PATH"
printf "%-20s %-8s %-8s %-6s %-20s %-10s %-5s %-10s %s\n" "----" "------" "----" "---" "-----" "----------" "---" "------" "----"

# Sort and print
sort "$AGENTS_FILE" | while IFS=' ' read -r name status; do
  [ -z "$name" ] && continue

  v1_type="-"
  v1_workdir="-"
  v1_state="-"
  v1_ver="-"
  if [ -s "$V1_INFO_FILE" ]; then
    IFS='|' read -r v1_type v1_workdir v1_state v1_ver v1_sup <<EOFV1
$(awk -F'|' -v n="$name" '$1==n {print $2 "|" $3 "|" $4 "|" $5 "|" $6; exit}' "$V1_INFO_FILE" 2>/dev/null || true)
EOFV1
    [ -n "$v1_type" ] || v1_type="-"
    [ -n "$v1_workdir" ] || v1_workdir="-"
    [ -n "$v1_state" ] || v1_state="-"
    [ -n "$v1_ver" ] || v1_ver="-"
  fi

  # Type from meta.json
  type="-"
  if [ -f "$DATA_DIR/$name/meta.json" ]; then
    type=$(python3 -c "import json; print(json.load(open('$DATA_DIR/$name/meta.json')).get('type','-'))" 2>/dev/null || echo "-")
  elif [ "$v1_type" != "-" ]; then
    type="$v1_type"
  fi

  # Model from meta.json
  model="-"
  if [ -f "$DATA_DIR/$name/meta.json" ]; then
    model=$(python3 -c "import json; print(json.load(open('$DATA_DIR/$name/meta.json')).get('model','-') or '-')" 2>/dev/null || echo "-")
  fi
  model_ver="-"
  if [ -f "$DATA_DIR/$name/meta.json" ]; then
    model_ver=$(python3 -c "import json; d=json.load(open('$DATA_DIR/$name/meta.json')); print(d.get('agentModelVersion','-') or '-')" 2>/dev/null || echo "-")
  elif [ "$v1_ver" != "-" ]; then
    model_ver="$v1_ver"
  fi

  # Known in backend?
  reg="no"
  echo "$REG_NAMES" | grep -qx "$name" && reg="yes"

  # MCP? (for active and idle — both have tmux sessions)
  mcp="-"
  [ "$status" != "down" ] && [ "$status" != "standby" ] && mcp="no"
  grep -qx "$name" "$MCP_SESSIONS_FILE" 2>/dev/null && mcp="yes"

  # Resume ID
  resume="-"
  if [ -f "$DATA_DIR/$name/resume-id" ]; then
    resume=$(cut -c1-8 < "$DATA_DIR/$name/resume-id" 2>/dev/null || echo "-")
  elif [ "$v1_state" != "-" ] && [ -f "$v1_state/resume-id" ]; then
    resume=$(cut -c1-8 < "$v1_state/resume-id" 2>/dev/null || echo "-")
  fi

  # Path from meta.json
  path_val="-"
  if [ -f "$DATA_DIR/$name/meta.json" ]; then
    path_val=$(python3 -c "import json; print(json.load(open('$DATA_DIR/$name/meta.json')).get('path','-'))" 2>/dev/null || echo "-")
  elif [ "$v1_workdir" != "-" ]; then
    path_val="$v1_workdir"
  fi

  # Color: active=default, idle=yellow, standby=cyan, down=dimmed
  if [ "$status" = "down" ]; then
    printf "\033[2m%-20s %-8s %-8s %-6s %-20s %-10s %-5s %-10s %s\033[0m\n" "$name" "$status" "$type" "$model_ver" "$model" "$reg" "$mcp" "$resume" "$path_val"
  elif [ "$status" = "standby" ]; then
    printf "\033[36m%-20s %-8s %-8s %-6s %-20s %-10s %-5s %-10s %s\033[0m\n" "$name" "$status" "$type" "$model_ver" "$model" "$reg" "$mcp" "$resume" "$path_val"
  elif [ "$status" = "idle" ]; then
    printf "\033[33m%-20s %-8s %-8s %-6s %-20s %-10s %-5s %-10s %s\033[0m\n" "$name" "$status" "$type" "$model_ver" "$model" "$reg" "$mcp" "$resume" "$path_val"
  else
    printf "%-20s %-8s %-8s %-6s %-20s %-10s %-5s %-10s %s\n" "$name" "$status" "$type" "$model_ver" "$model" "$reg" "$mcp" "$resume" "$path_val"
  fi
done
