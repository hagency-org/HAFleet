#!/bin/bash
# agent-ls — List agent sessions with status
#
# Usage:
#   agent-ls        List running agents (active tmux sessions)
#   agent-ls -a     List all agents including inactive (have data but not running)

# Portable script dir resolution (works on macOS bash 3.2 + Linux)
_resolve_script_dir() {
  local src="$0"
  while [ -L "$src" ]; do
    local dir
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
  done
  cd -P "$(dirname "$src")" && pwd
}
SCRIPT_DIR="$(_resolve_script_dir)"
DATA_DIR="$(dirname "$SCRIPT_DIR")/data/agents"
BACKEND_URL="${AGENT_CHAT_API:-http://127.0.0.1:8090}"

SHOW_ALL=false
[ "${1:-}" = "-a" ] && SHOW_ALL=true

# Temp files for portable key-value lookups (no associative arrays — bash 3.2 compat)
_TMP_FILES=""
_mktmp() {
  local f
  f=$(mktemp 2>/dev/null || mktemp -t agent_ls) || { echo "Error: mktemp failed" >&2; exit 1; }
  _TMP_FILES="$_TMP_FILES $f"
  echo "$f"
}
trap 'rm -f $_TMP_FILES' EXIT

PTS_MAP_FILE=$(_mktmp)
MCP_SESSIONS_FILE=$(_mktmp)
AGENTS_FILE=$(_mktmp)

# Get tmux sessions
SESSIONS=$(tmux list-sessions -F "#{session_name}" 2>/dev/null || true)

# Get known agents from backend
REG_NAMES=$(curl --noproxy '*' -s "$BACKEND_URL/api/agents" 2>/dev/null \
  | python3 -c '
import json
import sys
try:
    data = json.load(sys.stdin)
except Exception:
    data = []
if isinstance(data, list):
    for item in data:
        if isinstance(item, dict) and item.get("name"):
            print(item["name"])
' 2>/dev/null || true)

# Build tty → session map for MCP detection
tmux list-panes -a -F "#{pane_tty} #{session_name}" 2>/dev/null \
  | sed 's|/dev/||' > "$PTS_MAP_FILE" || true

# Detect MCP sessions
MCP_PIDS=$(pgrep -f "node.*mcp-server.js" 2>/dev/null || true)
for pid in $MCP_PIDS; do
  pts=$(ps -o tty= -p "$pid" 2>/dev/null | tr -d ' ')
  if [ -n "$pts" ]; then
    # Try exact match first, then prefix match (macOS tty format differs)
    sess=$(grep -m1 "^${pts} \|/${pts} " "$PTS_MAP_FILE" 2>/dev/null | awk '{print $2}')
    [ -n "$sess" ] && echo "$sess" >> "$MCP_SESSIONS_FILE"
  fi
done

# Collect all agent names: "name status" per line
for sess in $SESSIONS; do
  echo "$sess active" >> "$AGENTS_FILE"
done

if [ "$SHOW_ALL" = true ] && [ -d "$DATA_DIR" ]; then
  for agent_dir in "$DATA_DIR"/*/; do
    [ -d "$agent_dir" ] || continue
    name=$(basename "$agent_dir")
    [ -f "$agent_dir/meta.json" ] || continue
    if ! grep -q "^${name} " "$AGENTS_FILE" 2>/dev/null; then
      echo "$name inactive" >> "$AGENTS_FILE"
    fi
  done
fi

if [ ! -s "$AGENTS_FILE" ]; then
  echo "No agents found."
  exit 0
fi

# Print header
printf "%-20s %-8s %-8s %-20s %-10s %-5s %-10s %s\n" "NAME" "STATUS" "TYPE" "MODEL" "KNOWN" "MCP" "RESUME" "PATH"
printf "%-20s %-8s %-8s %-20s %-10s %-5s %-10s %s\n" "----" "------" "----" "-----" "----------" "---" "------" "----"

# Sort and print
sort "$AGENTS_FILE" | while IFS=' ' read -r name status; do
  [ -z "$name" ] && continue

  # Type from meta.json
  type="-"
  if [ -f "$DATA_DIR/$name/meta.json" ]; then
    type=$(python3 -c "import json; print(json.load(open('$DATA_DIR/$name/meta.json')).get('type','-'))" 2>/dev/null || echo "-")
  fi

  # Model from meta.json
  model="-"
  if [ -f "$DATA_DIR/$name/meta.json" ]; then
    model=$(python3 -c "import json; print(json.load(open('$DATA_DIR/$name/meta.json')).get('model','-') or '-')" 2>/dev/null || echo "-")
  fi

  # Known in backend?
  reg="no"
  echo "$REG_NAMES" | grep -qx "$name" && reg="yes"

  # MCP? (only for active)
  mcp="-"
  [ "$status" = "active" ] && mcp="no"
  grep -qx "$name" "$MCP_SESSIONS_FILE" 2>/dev/null && mcp="yes"

  # Resume ID
  resume="-"
  if [ -f "$DATA_DIR/$name/resume-id" ]; then
    resume=$(cut -c1-8 < "$DATA_DIR/$name/resume-id" 2>/dev/null || echo "-")
  fi

  # Path from meta.json
  path_val="-"
  if [ -f "$DATA_DIR/$name/meta.json" ]; then
    path_val=$(python3 -c "import json; print(json.load(open('$DATA_DIR/$name/meta.json')).get('path','-'))" 2>/dev/null || echo "-")
  fi

  # Color: active=default, inactive=dimmed
  if [ "$status" = "inactive" ]; then
    printf "\033[2m%-20s %-8s %-8s %-20s %-10s %-5s %-10s %s\033[0m\n" "$name" "$status" "$type" "$model" "$reg" "$mcp" "$resume" "$path_val"
  else
    printf "%-20s %-8s %-8s %-20s %-10s %-5s %-10s %s\n" "$name" "$status" "$type" "$model" "$reg" "$mcp" "$resume" "$path_val"
  fi
done
