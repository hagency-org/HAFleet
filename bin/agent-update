#!/bin/bash

# Deprecated legacy entrypoint: forward to unified 'agentchat'.
if [ "${AGENTCHAT_INTERNAL_DISPATCH:-0}" != "1" ]; then
  _ac_legacy_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  _ac_legacy_name="$(basename "$0")"
  echo "[DEPRECATED] ${_ac_legacy_name} is deprecated. Use: agentchat update ..." >&2
  exec "${_ac_legacy_dir}/agentchat" "update" "$@"
fi
# agent-update — Pull latest code and reinstall
#
# Usage:
#   agent-update [--check|--pause-services|--resume-services|--restart-services|--service-status]
#
# --check: only check if updates are available, don't install

set -euo pipefail

_resolve_script_dir() {
  local src="$0"
  while [ -L "$src" ]; do
    local dir
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
  done
  cd -P "$(dirname "$src")" && pwd
}
SCRIPT_DIR="$(_resolve_script_dir)"
BASE_DIR="$(dirname "$SCRIPT_DIR")"
REPO_DIR="$(dirname "$BASE_DIR")"

# If we're inside remote/, go up to repo root
if [ "$(basename "$BASE_DIR")" = "remote" ]; then
  REPO_DIR="$BASE_DIR/.."
fi
REPO_DIR="$(cd "$REPO_DIR" && pwd)"

resolve_repo_dir() {
  local c
  for c in \
    "${AGENT_CHAT_HOME:-}" \
    "$REPO_DIR" \
    "$HOME/laplace/agent-chat" \
    "$HOME/agent-chat"; do
    [ -n "${c:-}" ] || continue
    [ -d "$c/.git" ] || continue
    [ -f "$c/remote/install-remote.sh" ] || continue
    cd "$c" && pwd
    return 0
  done
  return 1
}

if RESOLVED_REPO="$(resolve_repo_dir)"; then
  REPO_DIR="$RESOLVED_REPO"
fi

CHECK_ONLY=false
SERVICE_ACTION=""
UPDATE_AND_PAUSE=false
while [ $# -gt 0 ]; do
  case "$1" in
    --check)
      CHECK_ONLY=true
      ;;
    --pause-services)
      SERVICE_ACTION="pause"
      ;;
    --resume-services)
      SERVICE_ACTION="resume"
      ;;
    --restart-services)
      SERVICE_ACTION="restart"
      ;;
    --service-status)
      SERVICE_ACTION="status"
      ;;
    -h|--help)
      echo "Usage: agent-update [--check|--pause-services|--resume-services|--restart-services|--service-status]"
      echo "Scope:"
      echo "  Updates the current checkout or remote package on this host."
      echo "  Service flags only control the remote relay service: agent-chat-push-relay."
      echo "Options:"
      echo "  --check: check whether updates are available; do not install"
      echo "  --pause-services: pull/reinstall, then keep remote relay paused"
      echo "  --resume-services|--restart-services|--service-status: relay service actions only"
      exit 0
      ;;
    *)
      echo "Error: unknown argument: $1" >&2
      echo "Usage: agent-update [--check|--pause-services|--resume-services|--restart-services|--service-status]" >&2
      exit 1
      ;;
  esac
  shift
done

cd "$REPO_DIR"

find_service_cli() {
  local c
  for c in "$REPO_DIR/bin/agent-service" "$BASE_DIR/bin/agent-service" "$SCRIPT_DIR/agent-service"; do
    if [ -x "$c" ]; then
      echo "$c"
      return 0
    fi
  done
  return 1
}

find_maintain_cli() {
  local c
  for c in "$REPO_DIR/bin/agent-maintain" "$BASE_DIR/bin/agent-maintain" "$SCRIPT_DIR/agent-maintain"; do
    if [ -x "$c" ]; then
      echo "$c"
      return 0
    fi
  done
  return 1
}

find_skill_sync_cli() {
  local c
  for c in "$REPO_DIR/bin/agentchat-sync-skills" "$BASE_DIR/bin/agentchat-sync-skills" "$SCRIPT_DIR/agentchat-sync-skills"; do
    if [ -x "$c" ]; then
      echo "$c"
      return 0
    fi
  done
  return 1
}

pause_remote_relay_now() {
  local service_cli="$1"
  echo "Pausing remote relay before update (reduce heartbeat noise)..."
  "$service_cli" pause --profile remote
}

run_post_update_maintenance() {
  local maintain_cli
  maintain_cli="$(find_maintain_cli || true)"
  if [ -z "$maintain_cli" ]; then
    echo "Maintenance command not found; skipping log/tmp cleanup."
    return 0
  fi
  echo "Running post-update maintenance (log rotation + tmp cleanup)..."
  if ! "$maintain_cli"; then
    echo "Warning: post-update maintenance failed; continuing update flow." >&2
  fi
}

run_post_update_skill_sync() {
  local sync_cli
  sync_cli="$(find_skill_sync_cli || true)"
  if [ -z "$sync_cli" ]; then
    echo "Skill sync command not found; skipping ~/.codex and ~/.claude link sync."
    return 0
  fi
  echo "Syncing skill links (~/.codex + ~/.claude)..."
  if ! "$sync_cli"; then
    echo "Warning: skill link sync failed; continuing update flow." >&2
  fi
}

if [ -n "$SERVICE_ACTION" ]; then
  if [ "$SERVICE_ACTION" = "pause" ]; then
    UPDATE_AND_PAUSE=true
  fi
fi

if [ "$CHECK_ONLY" = true ] && [ -n "$SERVICE_ACTION" ]; then
  echo "Error: --check cannot be combined with service flags" >&2
  exit 1
fi

if [ -n "$SERVICE_ACTION" ] && [ "$UPDATE_AND_PAUSE" = false ]; then
  SERVICE_CLI="$(find_service_cli || true)"
  if [ -z "$SERVICE_CLI" ]; then
    echo "Error: agent-service CLI not found. Expected in $REPO_DIR/bin/agent-service" >&2
    exit 1
  fi
  echo "Service action target: remote relay (agent-chat-push-relay)"
  "$SERVICE_CLI" "$SERVICE_ACTION" --profile remote
  exit 0
fi

# Ensure we're in a git repo
if [ ! -d ".git" ]; then
  if [ "$UPDATE_AND_PAUSE" = true ]; then
    echo "Warning: $REPO_DIR is not a git repository; falling back to pause-only." >&2
    SERVICE_CLI="$(find_service_cli || true)"
    if [ -z "$SERVICE_CLI" ]; then
      echo "Error: agent-service CLI not found. Expected in $REPO_DIR/bin/agent-service" >&2
      exit 1
    fi
    "$SERVICE_CLI" pause --profile remote
    exit 0
  fi
  echo "Error: $REPO_DIR is not a git repository" >&2
  exit 1
fi

# For pause-maintenance mode, stop relay first to avoid noisy heartbeat flips during update.
if [ "$UPDATE_AND_PAUSE" = true ]; then
  SERVICE_CLI="$(find_service_cli || true)"
  if [ -z "$SERVICE_CLI" ]; then
    echo "Error: agent-service CLI not found. Expected in $REPO_DIR/bin/agent-service" >&2
    exit 1
  fi
  pause_remote_relay_now "$SERVICE_CLI"
fi

# Fetch latest
git fetch origin --quiet 2>/dev/null || {
  echo "Error: failed to fetch from origin" >&2
  exit 1
}

resolve_deploy_branch() {
  local branch="${AGENTCHAT_DEPLOY_BRANCH:-}"
  if [ -n "$branch" ]; then echo "origin/$branch"; return 0; fi
  for b in stable main master; do
    if git rev-parse --verify "origin/$b" >/dev/null 2>&1; then echo "origin/$b"; return 0; fi
  done
  return 1
}

LOCAL=$(git rev-parse HEAD)
REMOTE_REF=$(resolve_deploy_branch) || {
  echo "Error: no deploy branch found (set AGENTCHAT_DEPLOY_BRANCH or ensure origin/stable, origin/main, or origin/master exists)" >&2
  exit 1
}
REMOTE=$(git rev-parse "$REMOTE_REF")
BEHIND=$(git rev-list --count "HEAD..$REMOTE_REF" 2>/dev/null || echo "0")
AHEAD=$(git rev-list --count "$REMOTE_REF..HEAD" 2>/dev/null || echo "0")

echo "Updates available: $BEHIND commit(s) behind."
if [ "$AHEAD" -gt 0 ] 2>/dev/null; then
  echo "Note: local branch is also ahead by $AHEAD commit(s)."
fi

if [ "$BEHIND" -eq 0 ] 2>/dev/null; then
  echo "Already up to date."
fi

if [ "$CHECK_ONLY" = true ]; then
  echo "Run 'agent-update' to install updates."
  exit 0
fi

# Pull only when behind.
if [ "$BEHIND" -gt 0 ] 2>/dev/null; then
  echo "Pulling latest..."
  BRANCH="${REMOTE_REF#origin/}"
  git pull --ff-only origin "$BRANCH" 2>/dev/null || {
    echo "Error: git pull failed (local changes?). Try: cd $REPO_DIR && git stash && agent-update" >&2
    exit 1
  }
fi

# Reinstall
if [ "$UPDATE_AND_PAUSE" = true ]; then
  echo "Reinstalling (maintenance mode: keep remote relay paused)..."
else
  echo "Reinstalling..."
fi
if [ ! -f "$REPO_DIR/remote/install-remote.sh" ]; then
  echo "Error: missing install script: $REPO_DIR/remote/install-remote.sh" >&2
  exit 1
fi
cd "$REPO_DIR/remote"
if [ "$UPDATE_AND_PAUSE" = true ]; then
  AGENT_INSTALL_AUTOSTART=0 AGENT_INSTALL_SKIP_VERIFY=1 bash install-remote.sh
else
  bash install-remote.sh
fi
cd "$REPO_DIR"
run_post_update_maintenance
run_post_update_skill_sync

echo ""
if [ "$UPDATE_AND_PAUSE" = true ]; then
  SERVICE_CLI="$(find_service_cli || true)"
  if [ -z "$SERVICE_CLI" ]; then
    echo "Error: agent-service CLI not found after reinstall." >&2
    exit 1
  fi
  "$SERVICE_CLI" pause --profile remote
  echo "Update complete. Remote relay is paused."
  echo "Resume with: agent-update --resume-services"
else
  echo "Update complete. Push relay restarted."
  echo "Note: running agents keep old code until restarted."
fi
