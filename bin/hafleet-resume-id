#!/bin/bash

# Deprecated legacy entrypoint: forward to unified 'hafleet'.
if [ "${HAFLEET_INTERNAL_DISPATCH:-0}" != "1" ]; then
  _ac_legacy_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  _ac_legacy_name="$(basename "$0")"
  echo "[DEPRECATED] ${_ac_legacy_name} is deprecated. Use: hafleet resume-id ..." >&2
  exec "${_ac_legacy_dir}/hafleet" "resume-id" "$@"
fi

# hafleet-resume-id — View, set, or clear an agent's resume-id.
#
# Usage:
#   hafleet resume-id <name>              View current resume-id
#   hafleet resume-id <name> <uuid>       Set resume-id to <uuid>
#   hafleet resume-id <name> --clear      Clear resume-id (next up = fresh)
#
# Handles both layouts:
#   - Legacy agents: plain file at $DATA_DIR/agents/<name>/resume-id
#   - V1 agents:     $DATA_DIR/agents/<name>/resume-id may be a symlink
#                    pointing to ~/.hafleet/agents/agent_<name>/state/resume-id
#                    Some v1 agents also have a duplicate plain file at both
#                    paths — the tool writes to both when both exist.

set -euo pipefail

_resolve_script_dir() {
  local src="$0"
  while [ -L "$src" ]; do
    local dir
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
  done
  cd -P "$(dirname "$src")" && pwd
}
SCRIPT_DIR="$(_resolve_script_dir)"
BASE_DIR="$(dirname "$SCRIPT_DIR")"

# Load .env if present
ENV_FILE="$BASE_DIR/.env"
if [ -f "$ENV_FILE" ]; then
  set -a
  source "$ENV_FILE"
  set +a
fi
RUNTIME_DIR="${HAFLEET_RUNTIME_DIR:-$BASE_DIR}"
if [ "$RUNTIME_DIR" != "$BASE_DIR" ] && [ -f "$RUNTIME_DIR/.env" ]; then
  set -a
  source "$RUNTIME_DIR/.env"
  set +a
fi
DATA_DIR="$RUNTIME_DIR/data/agents"
HAFLEET_HOMEDIR="${HAFLEET_HOMEDIR:-$HOME/.hafleet}"

UUID_RE='^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'

usage() {
  cat <<'USAGE'
Usage: hafleet resume-id <name>              View current resume-id
       hafleet resume-id <name> <uuid>       Set resume-id to <uuid>
       hafleet resume-id <name> --clear      Clear resume-id (next up = fresh)

Notes:
  - UUID must match RFC 4122 canonical form: 8-4-4-4-12 lowercase hex.
  - Handles legacy agents (plain file) and v1 agents (symlink to state dir).
  - Changes take effect on the next "hafleet up" — if the agent has a
    running tmux session, restart it with "hafleet down && hafleet up".
USAGE
}

if [ $# -lt 1 ]; then
  usage >&2
  exit 1
fi

case "${1:-}" in
  -h|--help|help) usage; exit 0 ;;
esac

NAME="$1"
shift || true

if [ -z "$NAME" ]; then
  echo "Error: agent name required" >&2
  usage >&2
  exit 1
fi

# Candidate paths (some agents have both; some only one)
DATA_PATH="$DATA_DIR/$NAME/resume-id"
V1_PATH="$HAFLEET_HOMEDIR/agents/agent_$NAME/state/resume-id"

# Determine what exists
DATA_EXISTS=false
V1_EXISTS=false
[ -e "$DATA_PATH" ] || [ -L "$DATA_PATH" ] && DATA_EXISTS=true
[ -e "$V1_PATH" ] || [ -L "$V1_PATH" ] && V1_EXISTS=true

# Check agent exists at all (has any data directory or v1 home)
AGENT_DATA_DIR="$DATA_DIR/$NAME"
V1_HOME="$HAFLEET_HOMEDIR/agents/agent_$NAME"
if [ ! -d "$AGENT_DATA_DIR" ] && [ ! -d "$V1_HOME" ]; then
  echo "Error: agent '$NAME' not found (no data dir at $AGENT_DATA_DIR, no v1 home at $V1_HOME)" >&2
  exit 1
fi

# ── VIEW mode (no second arg) ────────────────────────────────────────
if [ $# -eq 0 ]; then
  data_val=""
  v1_val=""
  [ -f "$DATA_PATH" ] && data_val=$(cat "$DATA_PATH" 2>/dev/null | tr -d '\n' || true)
  [ -f "$V1_PATH" ] && v1_val=$(cat "$V1_PATH" 2>/dev/null | tr -d '\n' || true)

  if [ -z "$data_val" ] && [ -z "$v1_val" ]; then
    echo "(no resume-id set for '$NAME')"
    exit 0
  fi

  if [ -L "$DATA_PATH" ]; then
    echo "$NAME: $data_val  (v1 symlink → $(readlink "$DATA_PATH"))"
  elif [ -n "$data_val" ] && [ -n "$v1_val" ] && [ "$data_val" = "$v1_val" ]; then
    echo "$NAME: $data_val  (duplicated at data dir + v1 home)"
  elif [ -n "$data_val" ] && [ -n "$v1_val" ]; then
    echo "Warning: data dir and v1 home disagree:" >&2
    echo "  data dir: $data_val ($DATA_PATH)"
    echo "  v1 home:  $v1_val ($V1_PATH)"
    exit 2
  elif [ -n "$data_val" ]; then
    echo "$NAME: $data_val  (data dir only)"
  else
    echo "$NAME: $v1_val  (v1 home only)"
  fi
  exit 0
fi

ACTION="$1"
shift || true

# ── Active-session warning (shared by set/clear) ─────────────────────
check_active_session() {
  if command -v tmux >/dev/null 2>&1 && tmux has-session -t "$NAME" 2>/dev/null; then
    echo "Warning: tmux session '$NAME' is currently active." >&2
    echo "  Changes take effect on the next launch — run:" >&2
    echo "    hafleet down $NAME && hafleet up $NAME" >&2
  fi
}

# ── CLEAR mode ───────────────────────────────────────────────────────
if [ "$ACTION" = "--clear" ]; then
  cleared_any=false
  if [ -f "$DATA_PATH" ] || [ -L "$DATA_PATH" ]; then
    # If it's a symlink, clear the target too; then remove the link.
    if [ -L "$DATA_PATH" ]; then
      link_target=$(readlink -f "$DATA_PATH" 2>/dev/null || true)
      if [ -n "$link_target" ] && [ -f "$link_target" ]; then
        rm -f "$link_target"
        echo "Cleared symlink target: $link_target"
        cleared_any=true
      fi
      # Leave the dangling symlink in place — v1 hafleet-up treats
      # dangling symlink as FRESH (see bin/hafleet-up line ~493).
      echo "Kept dangling symlink: $DATA_PATH (signals fresh start)"
    else
      rm -f "$DATA_PATH"
      echo "Cleared: $DATA_PATH"
      cleared_any=true
    fi
  fi
  if [ -f "$V1_PATH" ] && [ "$(readlink -f "$DATA_PATH" 2>/dev/null || true)" != "$V1_PATH" ]; then
    # Only remove if we haven't already cleared it via the symlink
    rm -f "$V1_PATH"
    echo "Cleared: $V1_PATH"
    cleared_any=true
  fi
  if [ "$cleared_any" = false ]; then
    echo "(no resume-id to clear for '$NAME')"
    exit 0
  fi
  check_active_session
  exit 0
fi

# ── SET mode ─────────────────────────────────────────────────────────
NEW_ID="$ACTION"
if ! [[ "$NEW_ID" =~ $UUID_RE ]]; then
  echo "Error: invalid UUID format '$NEW_ID'" >&2
  echo "  Expected RFC 4122 canonical form: 8-4-4-4-12 lowercase hex" >&2
  echo "  Example: 3a62dfe2-2f0b-6ef9-1720-0f153a64cc57" >&2
  exit 1
fi

wrote_any=false
# Write to data path (follows symlink if present)
if [ -f "$DATA_PATH" ] || [ -L "$DATA_PATH" ] || [ -d "$AGENT_DATA_DIR" ]; then
  mkdir -p "$(dirname "$DATA_PATH")"
  echo "$NEW_ID" > "$DATA_PATH"
  if [ -L "$DATA_PATH" ]; then
    echo "Wrote: $DATA_PATH (via symlink → $(readlink "$DATA_PATH"))"
  else
    echo "Wrote: $DATA_PATH"
  fi
  wrote_any=true
fi
# Write to v1 path too if it exists as a separate file (not reachable via symlink)
if [ -f "$V1_PATH" ] && [ "$(readlink -f "$DATA_PATH" 2>/dev/null || true)" != "$(readlink -f "$V1_PATH" 2>/dev/null || true)" ]; then
  echo "$NEW_ID" > "$V1_PATH"
  echo "Wrote: $V1_PATH"
  wrote_any=true
elif [ -d "$V1_HOME/state" ] && [ ! -f "$V1_PATH" ] && [ ! -L "$V1_PATH" ] && [ ! -d "$AGENT_DATA_DIR" ]; then
  # v1 agent with only v1 home, no data dir entry — write v1 path
  echo "$NEW_ID" > "$V1_PATH"
  echo "Wrote: $V1_PATH"
  wrote_any=true
fi

if [ "$wrote_any" = false ]; then
  echo "Error: could not write resume-id for '$NAME' — no writable location found" >&2
  exit 1
fi

check_active_session
