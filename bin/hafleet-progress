#!/usr/bin/env node
/*
 * Tell the room what an agent is DOING, without becoming the room.
 *
 * Asking an agent something in Matrix currently shows a read receipt and a typing indicator, and then
 * nothing until the answer lands. For a ten-minute task that leaves a borrower unable to tell working
 * from stuck — the silent half-done state this codebase keeps finding, wearing a different hat.
 *
 * THE FIRST DESIGN WAS WRONG AND THE OPERATOR SAID SO: posting each step into a shared room is
 * harassment. 「agent 老说话，把其他人的对话都冲了」. A progress feed that scrolls a project room is worse
 * than silence, because silence at least does not cost anyone else their conversation. So:
 *
 *   - IT GOES IN A THREAD, on the message that asked. The main timeline keeps exactly two events — the
 *     question and the answer — and anyone who wants detail opens the thread. Nobody else pays.
 *   - IT COALESCES. Steps accumulate in a small file and are emitted at most once per window, as one
 *     line ("read 12 files, ran 3 commands"), not one line per step.
 *   - IT REPORTS TRANSITIONS, not activity. Start, a stall, completion. A room does not need to know
 *     about an `ls`.
 *   - IT SUMMARISES, NEVER QUOTES. Tool inputs carry paths, tokens and customer data; what leaves here
 *     is a verb and a count.
 *
 * AND IT NEVER FAILS THE AGENT. Every path exits 0. A progress reporter that breaks the work it is
 * reporting on has made things worse than not existing, so a missing backend, an unreadable state file
 * or a malformed hook payload all end the same way: quietly.
 */

import { readFileSync, writeFileSync, mkdirSync } from 'fs';
import path from 'path';
import os from 'os';
import { buildProgressSummary, decideProgressEvent, parseProgressFilter } from '../lib/progress-filter.js';

const QUIET_EXIT = 0;

/** Everything below is best-effort. This is the only exit. */
function done(note) {
  if (note && process.env.HAFLEET_PROGRESS_DEBUG) console.error(`[progress] ${note}`);
  process.exit(QUIET_EXIT);
}

const agent = (process.env.HAFLEET_AGENT || process.env.AGENT_NAME || '').trim();
if (!agent) done('no agent name in the environment');

/*
 * WHERE THE POLICY LIVES, and why it is `$HOME` rather than the runtime directory.
 *
 * The router's `INHERITED_RUNNER_ENV_KEYS` does not pass `HAFLEET_RUNTIME_DIR` to a dispatched agent —
 * deliberately, since a runtime path is the operator's layout — so a filter kept there would be
 * unreadable in exactly the environment this runs in. `HOME` IS on that list, as are `TMPDIR`,
 * `CODEX_HOME` and `CLAUDE_CONFIG_DIR`. So the filter goes in `$HOME/.hafleet/`, which the agent can
 * reach, and per-customer differences are expressed by `perGroup` INSIDE that one file rather than by
 * scattering files an operator would have to find.
 */
const filterPath = (process.env.HAFLEET_PROGRESS_FILTER || '').trim()
  || path.join(os.homedir(), '.hafleet', 'progress-filter.json');

/*
 * TWO PIECES OF STATE WITH DIFFERENT LIFETIMES, which a first version kept in one place under
 * `os.tmpdir()` and thereby got wrong.
 *
 * The ANCHOR — which question is being worked on — must survive as long as the work. `TMPDIR` is
 * cleaned by the system, so the "a later read does not erase the anchor" guard was protecting state
 * that could disappear for an unrelated reason. It lives in `$HOME/.hafleet/progress-anchor/`, durable
 * and on the router's inherited-env allowlist.
 *
 * The COUNTS and the throttle window are genuinely ephemeral and stay in `TMPDIR`, where losing them
 * costs one slightly-thinner progress line.
 */
const safeName = `${agent.replace(/[^\w.-]/g, '_')}.json`;
const anchorPath = path.join(os.homedir(), '.hafleet', 'progress-anchor', safeName);
const stateDir = path.join(os.tmpdir(), 'hafleet-progress');
const statePath = path.join(stateDir, safeName);

function readState() {
  const anchor = (() => {
    try {
      return JSON.parse(readFileSync(anchorPath, 'utf8'));
    } catch {
      return {};
    }
  })();
  let ephemeral = {};
  try {
    ephemeral = JSON.parse(readFileSync(statePath, 'utf8'));
  } catch { /* first call, or a cleaned TMPDIR */ }
  /*
   * The ANCHOR WINS on the fields it owns. A stale copy in the ephemeral file — written by an older
   * version of this script, or left over from a previous question — must not shadow the durable record
   * of what is being worked on now.
   */
  return {
    lastSentAt: 0,
    counts: {},
    ...ephemeral,
    ...(anchor.replyTo ? { replyTo: anchor.replyTo, group: anchor.group ?? null, to: anchor.to ?? null } : {}),
  };
}
/**
 * Only the ephemeral half is written. Copying the anchor back into `TMPDIR` would recreate the stale
 * shadow the read path above has to defend against, and the MCP server is the only thing that should
 * ever decide which question is current.
 */
function writeState(next) {
  try {
    mkdirSync(stateDir, { recursive: true });
    writeFileSync(statePath, JSON.stringify({
      lastSentAt: next.lastSentAt || 0,
      counts: next.counts || {},
    }), { mode: 0o600 });
  } catch { /* a reporter that cannot remember still must not interrupt */ }
}

let payload = {};
try {
  const raw = readFileSync(0, 'utf8');
  if (raw.trim()) payload = JSON.parse(raw);
} catch { /* argv-only callers are fine */ }

const state = readState();
const now = Date.now();

/*
 * THE FILTER IS RESOLVED BEFORE ANYTHING IS DECIDED, and it is scoped to the group this report would go
 * to. The group comes from the anchor, so per-customer rules apply without the hook knowing what a
 * customer is.
 */
const group = (process.env.HAFLEET_PROGRESS_GROUP || '').trim() || state.group || null;
let filterDoc = null;
try {
  filterDoc = JSON.parse(readFileSync(filterPath, 'utf8'));
} catch (error) {
  /*
   * A MISSING FILE IS NOT A MALFORMED ONE. Absent means "nobody configured this", which must give the
   * built-in default — a feature that goes silent because it was not configured is a feature that looks
   * broken. Present-but-unreadable is a different thing and is reported below.
   */
  if (error?.code !== 'ENOENT') done(`filter at ${filterPath} is unreadable: ${error?.message || error}`);
}
const parsed = parseProgressFilter(filterDoc, { group });
/*
 * FAIL CLOSED ON A BAD RULE. An operator writing a filter is almost always narrowing what leaves the
 * machine; honouring a typo by falling back to the permissive default would give them MORE than they
 * had, in a room they cannot see. So a broken filter reports nothing and says why.
 */
if (!parsed.ok) done(`filter at ${filterPath} is invalid (${parsed.reason}); reporting nothing`);
const filter = parsed.filter;

const event = String(payload?.hook_event_name || process.argv[2] || '').trim();
const decision = decideProgressEvent({ event, tool: payload?.tool_name || null, filter });
const { kind, verb } = decision;

if (!decision.report) done(`filtered: ${decision.reason} [${filter.source}]`);

if (kind === 'step') {
  state.counts[verb] = (state.counts[verb] || 0) + 1;
  if (now - (state.lastSentAt || 0) < filter.minIntervalMs) {
    writeState(state);
    done(`coalesced (${verb})`);
  }
}

/*
 * Nothing worth saying. A window that expires with no steps in it means the agent is thinking, and
 * "still thinking" every minute is the noise this exists to avoid — the typing indicator already says
 * that, and it says it without an event.
 */
/*
 * ONE WORDING FOR BOTH TRANSPORTS. The hook path and the ACP host both built this line and the two copies
 * had already drifted; more importantly the "nothing succeeded" rule has to hold in both, and a rule stated
 * twice is a rule enforced once.
 *
 * `failures: 0` HERE, ALWAYS, and that is a limit rather than an omission: `PostToolUse` fires whether the
 * tool succeeded or failed and carries no status, so a hook simply cannot know. The ACP transport can, and
 * does. Saying so beats inventing a signal this side does not have.
 */
const summary = buildProgressSummary({ kind, counts: state.counts, failures: 0 });
if (!summary) done('nothing accumulated');

const backend = (process.env.HAFLEET_BACKEND_URL || `http://127.0.0.1:${process.env.HAFLEET_BACKEND_PORT || 8090}`).replace(/\/+$/, '');

/*
 * WHICH CREDENTIAL, and the first version had it wrong in a way that could not work.
 *
 * It sent `Authorization: Bearer $API_TOKEN` — the fleet's operator token. `API_TOKEN` is in the
 * router's `FORBIDDEN_RUNNER_ENV_KEYS`, so a dispatched agent's environment does not contain it and
 * never should: an agent runtime holding the operator token could delete other agents, read every
 * side's credentials and rewrite budgets. Progress reporting is the least privileged thing in this
 * system and it was reaching for the most privileged key in it.
 *
 * `AGENT_TOKEN` is the right one. It is the per-agent token the MCP server already sends as
 * `X-Agent-Token` for this agent's own messages, and the backend checks it in `checkAgentToken`. Same
 * road as a reply, which is the whole design: progress gains no privilege a reply does not have.
 *
 * The operator token is still accepted when it IS present, because an operator running this by hand
 * outside a dispatch has no agent token to offer, and refusing them would make the tool untestable.
 */
const agentToken = (process.env.AGENT_TOKEN || '').trim();
const token = (process.env.API_TOKEN || '').trim();

/*
 * WHAT THE AGENT IS ALLOWED TO SAY is `reply_to` — the id of the message it is answering, which it knows
 * because it received it. The BRIDGE turns that into a thread relation, exactly as it already does for
 * a real reply (`resolveOutboundGroupRelation`).
 *
 * A first version sent `thread_root_event_id` directly and the backend refused it: that field is
 * reserved for authenticated Matrix ingestion. The refusal is right and worth keeping in mind — an agent
 * that could name any thread root could drop its output into any conversation in the room. So progress
 * gains no privilege over a reply; it travels the same road.
 *
 * ITS ABSENCE IS A REFUSAL, not a fallback to the main timeline. Posting to the room when the thread
 * cannot be resolved is precisely the behaviour the operator rejected — and it would be invisible to the
 * person running the agent while being obvious to everyone else in the room.
 */
const replyTo = (process.env.HAFLEET_PROGRESS_REPLY_TO || state.replyTo || '').trim();
if (!replyTo) done('no message to thread under: refusing to post progress to the main timeline');

/*
 * THE DESTINATION COMES FROM THE ANCHOR unless the operator overrides it. `check_inbox` records the
 * group (or the DM sender) alongside the message id, because a hook knows nothing about rooms and the
 * message knows everything. The env vars stay first so a human debugging this can aim it by hand.
 */
const body = {
  from: agent,
  group: group || undefined,
  to: (process.env.HAFLEET_PROGRESS_TO || '').trim() || state.to || undefined,
  type: 'info',
  summary: `⏳ ${summary}`,
  full: `⏳ ${summary}`,
  reply_to: replyTo,
  /*
   * The half of the contract this file cannot keep by itself. Refusing to post without an anchor
   * (above) keeps progress off the timeline when there is NO thread; this asks the bridge to open one
   * on the anchor when there is no thread YET — which is the common case, since a question is usually
   * asked at the room's top level. Without it the bridge sends a correct, top-level reply, and the
   * result is the flooding the operator objected to, arriving through the polite path.
   */
  incidental: true,
};
if (!body.group && !body.to) done('no group or DM target configured');

/*
 * THE WINDOW OPENS AT THE ATTEMPT, not at the success. A first version recorded `lastSentAt` only after
 * a 2xx, so while the backend refused — which it did, on every call, for a reason that was not going to
 * change — the throttle never engaged and every single hook hit the network. A reporter that retries
 * hardest exactly when it is broken is a reporter that amplifies its own failure.
 *
 * Counts are only cleared when the send SUCCEEDED, so a failed window's work is still described in the
 * next line rather than lost.
 */
let sent = false;
try {
  const res = await fetch(`${backend}/api/messages`, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      ...(agentToken ? { 'X-Agent-Token': agentToken } : {}),
      ...(token ? { Authorization: `Bearer ${token}` } : {}),
    },
    body: JSON.stringify(body),
    signal: AbortSignal.timeout(3000),
  });
  sent = res.ok;
  if (!res.ok) writeState({ ...state, lastSentAt: now, replyTo });
  if (!res.ok) done(`backend refused: HTTP ${res.status}`);
} catch (error) {
  writeState({ ...state, lastSentAt: now, replyTo });
  done(`backend unreachable: ${error?.message || error}`);
}

writeState({ ...state, lastSentAt: now, counts: sent ? {} : state.counts, replyTo });
done(`sent: ${summary}`);
