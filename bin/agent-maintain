#!/usr/bin/env bash
set -euo pipefail

_resolve_script_dir() {
  local src="$0"
  while [ -L "$src" ]; do
    local dir
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
  done
  cd -P "$(dirname "$src")" && pwd
}

SCRIPT_DIR="$(_resolve_script_dir)"
BASE_DIR="$(dirname "$SCRIPT_DIR")"
LOG_DIR="$BASE_DIR/logs"
AGENT_DATA_DIR="$BASE_DIR/data/agents"

DRY_RUN=false
QUIET=false
MESSAGES_MAX_MB="128"
QUEUE_DROPPED_MAX_MB="32"
RETAIN_ARCHIVES="7"
TMP_MAX_AGE_DAYS="7"
EXIT_LOG_MAX_AGE_DAYS="14"

usage() {
  cat <<'USAGE'
Usage: agent-maintain [options]

Options:
  --dry-run                    Preview actions without deleting/moving files
  --quiet                      Reduce output
  --messages-max-mb <n>        Rotate logs/messages.jsonl when size > n MB (default: 128)
  --queue-max-mb <n>           Rotate logs/queue-dropped.jsonl when size > n MB (default: 32)
  --retain-archives <n>        Keep latest n rotated archives per log file (default: 7)
  --tmp-max-age-days <n>       Remove data/agents/*/tmp files older than n days (default: 7)
  --exit-log-max-age-days <n>  Remove logs/exit-* dirs older than n days (default: 14)
  -h, --help                   Show help
USAGE
}

log() {
  if [ "$QUIET" = false ]; then
    echo "$@"
  fi
}

is_pos_int() {
  [[ "$1" =~ ^[0-9]+$ ]]
}

run_action() {
  if [ "$DRY_RUN" = true ]; then
    log "[DRY-RUN] $*"
  else
    "$@"
  fi
}

rotate_file_if_needed() {
  local file="$1"
  local max_mb="$2"
  local threshold size ts rotated

  if [ ! -f "$file" ]; then
    log "[SKIP] missing: $file"
    return
  fi

  threshold=$((max_mb * 1024 * 1024))
  size=$(wc -c < "$file" 2>/dev/null || echo 0)
  if [ "$size" -le "$threshold" ]; then
    log "[OK] $file size=$size bytes (threshold=$threshold)"
    return
  fi

  ts="$(date +%Y%m%d-%H%M%S)"
  rotated="${file}.${ts}"
  log "[ROTATE] $file size=$size bytes -> $rotated"

  if [ "$DRY_RUN" = false ]; then
    mv "$file" "$rotated"
    if command -v truncate >/dev/null 2>&1; then
      truncate -s 0 "$file"
    else
      : > "$file"
    fi
    if command -v gzip >/dev/null 2>&1; then
      gzip -f "$rotated"
      rotated="${rotated}.gz"
    fi
  fi

  prune_rotated_archives "$file"
}

prune_rotated_archives() {
  local file="$1"
  local count=0
  local archive

  shopt -s nullglob
  # shellcheck disable=SC2206
  local archives=("${file}."*)
  shopt -u nullglob

  if [ "${#archives[@]}" -eq 0 ]; then
    return
  fi

  while IFS= read -r archive; do
    count=$((count + 1))
    if [ "$count" -le "$RETAIN_ARCHIVES" ]; then
      continue
    fi
    if [ "$DRY_RUN" = true ]; then
      log "[DRY-RUN] rm -f $archive"
    else
      rm -f "$archive"
      log "[PRUNE] removed old archive: $archive"
    fi
  done < <(ls -1t "${archives[@]}" 2>/dev/null || true)
}

prune_agent_tmp_files() {
  local removed=0
  local path
  if [ ! -d "$AGENT_DATA_DIR" ]; then
    log "[SKIP] missing agent data dir: $AGENT_DATA_DIR"
    return
  fi

  while IFS= read -r -d '' path; do
    if [ "$DRY_RUN" = true ]; then
      log "[DRY-RUN] rm -f $path"
    else
      rm -f "$path"
    fi
    removed=$((removed + 1))
  done < <(find "$AGENT_DATA_DIR" -type f -path '*/tmp/*' -mtime +"$TMP_MAX_AGE_DAYS" -print0 2>/dev/null)

  if [ "$DRY_RUN" = false ]; then
    find "$AGENT_DATA_DIR" -type d -path '*/tmp' -empty -delete 2>/dev/null || true
  fi
  log "[TMP] pruned $removed file(s) older than $TMP_MAX_AGE_DAYS day(s)"
}

prune_exit_logs() {
  local removed=0
  local path
  if [ ! -d "$LOG_DIR" ]; then
    log "[SKIP] missing log dir: $LOG_DIR"
    return
  fi

  while IFS= read -r -d '' path; do
    if [ "$DRY_RUN" = true ]; then
      log "[DRY-RUN] rm -rf $path"
    else
      rm -rf "$path"
    fi
    removed=$((removed + 1))
  done < <(find "$LOG_DIR" -mindepth 1 -maxdepth 1 -type d -name 'exit-*' -mtime +"$EXIT_LOG_MAX_AGE_DAYS" -print0 2>/dev/null)

  log "[EXIT-LOG] pruned $removed dir(s) older than $EXIT_LOG_MAX_AGE_DAYS day(s)"
}

while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run)
      DRY_RUN=true
      ;;
    --quiet)
      QUIET=true
      ;;
    --messages-max-mb)
      [ $# -ge 2 ] || { echo "Error: --messages-max-mb requires a value" >&2; exit 1; }
      MESSAGES_MAX_MB="$2"
      shift
      ;;
    --queue-max-mb)
      [ $# -ge 2 ] || { echo "Error: --queue-max-mb requires a value" >&2; exit 1; }
      QUEUE_DROPPED_MAX_MB="$2"
      shift
      ;;
    --retain-archives)
      [ $# -ge 2 ] || { echo "Error: --retain-archives requires a value" >&2; exit 1; }
      RETAIN_ARCHIVES="$2"
      shift
      ;;
    --tmp-max-age-days)
      [ $# -ge 2 ] || { echo "Error: --tmp-max-age-days requires a value" >&2; exit 1; }
      TMP_MAX_AGE_DAYS="$2"
      shift
      ;;
    --exit-log-max-age-days)
      [ $# -ge 2 ] || { echo "Error: --exit-log-max-age-days requires a value" >&2; exit 1; }
      EXIT_LOG_MAX_AGE_DAYS="$2"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Error: unknown argument '$1'" >&2
      usage >&2
      exit 1
      ;;
  esac
  shift
done

for n in "$MESSAGES_MAX_MB" "$QUEUE_DROPPED_MAX_MB" "$RETAIN_ARCHIVES" "$TMP_MAX_AGE_DAYS" "$EXIT_LOG_MAX_AGE_DAYS"; do
  if ! is_pos_int "$n"; then
    echo "Error: numeric options must be non-negative integers" >&2
    exit 1
  fi
done

log "Running agent-maintain (dry-run=$DRY_RUN)"
rotate_file_if_needed "$LOG_DIR/messages.jsonl" "$MESSAGES_MAX_MB"
rotate_file_if_needed "$LOG_DIR/queue-dropped.jsonl" "$QUEUE_DROPPED_MAX_MB"
prune_exit_logs
prune_agent_tmp_files
log "Maintenance complete."
