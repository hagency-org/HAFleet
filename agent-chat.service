[Unit]
Description=Agent Chat - tmux agent message queue and visualization
After=network.target agent-chat-v2.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__INSTALL_DIR__
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
EnvironmentFile=-__INSTALL_DIR__/.env

[Install]
WantedBy=multi-user.target
