{
  "name": "services-local",
  "services": [
    {
      "name": "backend",
      "command": [
        "node",
        "backend-v2.js"
      ],
      "dependsOn": [],
      "health": {
        "type": "http",
        "host": "127.0.0.1",
        "portEnv": "AGENT_CHAT_BACKEND_PORT",
        "defaultPort": 8090,
        "path": "/health",
        "timeoutMs": 1000
      }
    },
    {
      "name": "dashboard",
      "command": [
        "node",
        "server.js"
      ],
      "dependsOn": [
        "backend"
      ],
      "health": {
        "type": "tcp",
        "host": "127.0.0.1",
        "portEnv": "AGENT_CHAT_WEB_PORT",
        "defaultPort": 8084,
        "timeoutMs": 1000
      }
    },
    {
      "name": "bridge",
      "command": [
        "node",
        "bridge-matrix.js"
      ],
      "dependsOn": [
        "backend"
      ],
      "health": {
        "type": "process",
        "timeoutMs": 1000
      }
    },
    {
      "name": "relay",
      "command": [
        "node",
        "push-relay.js"
      ],
      "dependsOn": [
        "backend"
      ],
      "env": {
        "PUSH_RELAY_MODE": "local"
      },
      "health": {
        "type": "process",
        "timeoutMs": 1000
      }
    }
  ]
}
